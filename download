/*
 * config.js -- configuration du site public.
 *
 * FIREBASE EST FACULTATIF.
 *
 * Laisse tel quel, le site fonctionne : il lit `data.json`, publie par
 * l'action GitHub apres chaque collecte. C'est le mode par defaut, et il ne
 * depend d'aucun service tiers.
 *
 * Renseignez `firebase` ci-dessous pour ajouter la mise a jour EN DIRECT :
 * la page se met alors a jour d'elle-meme des qu'une collecte se termine,
 * sans rechargement (Firestore `onSnapshot`).
 *
 *   1. https://console.firebase.google.com -> creer un projet
 *   2. Firestore Database -> creer une base (mode production)
 *   3. Parametres du projet -> Vos applications -> Web -> copier la config
 *   4. Coller les valeurs ci-dessous
 *   5. Deployer les regles de securite : voir firestore.rules
 *
 * Ces valeurs sont PUBLIQUES par conception -- ce ne sont pas des secrets.
 * Ce qui protege la base, ce sont les REGLES (firestore.rules) : lecture
 * autorisee, ecriture interdite depuis le navigateur. Seule l'action
 * GitHub ecrit, avec un compte de service garde en secret de depot.
 *
 * ATTENTION : avec la lecture publique, l'historique de vos prix devient
 * consultable par qui connait l'URL. Lisez PUBLICATION.md avant d'activer.
 */
window.CONFIG = {

  // null = mode fichier (data.json). Objet = mise a jour en direct.
  firebase: null,

  // Exemple une fois renseigne :
  //
  // firebase: {
  //   apiKey: "AIza...",
  //   authDomain: "mon-projet.firebaseapp.com",
  //   projectId: "mon-projet",
  //   appId: "1:123456789:web:abcdef"
  // },

  // Document Firestore ou l'action ecrit la photographie.
  cheminFirestore: "suivi/etat",

  // Rechargement de data.json en mode fichier (ms). La collecte etant
  // quotidienne, inutile d'insister : ce n'est pas la page qui fera
  // apparaitre un prix plus tot.
  intervalleRelecture: 300000
};
