#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
firebase_sync.py -- pousse la photographie du suivi vers Firestore.

FACULTATIF. Sans Firebase, le site lit `data.json` et fonctionne
parfaitement. Firebase ajoute une seule chose, mais elle compte : la mise a
jour EN DIRECT de la page ouverte, sans rechargement (`onSnapshot`).

CE QUI EST ECRIT, ET COMMENT
----------------------------
Un seul document, `suivi/etat`, avec deux champs :

    { "json": "<toute la photographie, serialisee>", "maj": "<horodatage>" }

Stocker la charge en UNE chaine plutot qu'en arborescence Firestore n'est
pas de la paresse : cela evite la conversion en valeurs typees, la limite de
20 niveaux d'imbrication, et surtout garantit que le site recoit exactement
le meme objet qu'en mode fichier. Une seule forme de donnees, donc un seul
chemin de rendu a tester. La charge fait quelques dizaines de Ko, tres loin
du plafond d'un document (1 Mio).

QUI A LE DROIT D'ECRIRE
-----------------------
Ce script uniquement, via un COMPTE DE SERVICE garde en secret de depot
(`FIREBASE_SERVICE_ACCOUNT`). Le navigateur, lui, ne peut que lire : c'est
le role de `firestore.rules`, a deployer avant toute mise en service.

Usage :
    python firebase_sync.py                       # depuis web/data.json
    python firebase_sync.py --verifier            # controle sans ecrire
"""
import argparse
import json
import os
import sys
from datetime import datetime
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
DONNEES = BASE_DIR / "web" / "data.json"

VAR_COMPTE = "FIREBASE_SERVICE_ACCOUNT"
VAR_PROJET = "FIREBASE_PROJECT_ID"
CHEMIN_DOC = "suivi/etat"
PORTEE = "https://www.googleapis.com/auth/datastore"


def _compte_de_service():
    """
    Charge le compte de service depuis l'environnement.

    Le contenu est le JSON complet fourni par la console Firebase. Il n'est
    jamais ecrit sur disque ici, et ne doit jamais entrer dans le depot.
    """
    brut = os.environ.get(VAR_COMPTE, "").strip()
    if not brut:
        return None, f"{VAR_COMPTE} absent : rien a synchroniser."
    try:
        infos = json.loads(brut)
    except json.JSONDecodeError as e:
        return None, f"{VAR_COMPTE} n'est pas un JSON valide ({e})."
    manquant = [c for c in ("client_email", "private_key", "project_id")
                if not infos.get(c)]
    if manquant:
        return None, f"compte de service incomplet : {', '.join(manquant)}."
    return infos, ""


def _jeton(infos):
    """Jeton d'acces OAuth2, obtenu par assertion signee du compte de service."""
    try:
        from google.oauth2 import service_account
        import google.auth.transport.requests as transport
    except ImportError:
        return None, ("google-auth absent : pip install -r requirements-firebase.txt")
    creds = service_account.Credentials.from_service_account_info(
        infos, scopes=[PORTEE])
    creds.refresh(transport.Request())
    return creds.token, ""


def charger_donnees(chemin=DONNEES):
    chemin = Path(chemin)
    if not chemin.exists():
        raise SystemExit(f"{chemin} absent. Lancez d'abord : python exporter_web.py")
    return json.loads(chemin.read_text(encoding="utf-8"))


def pousser(donnees, infos, jeton):
    """Ecrit le document unique. Retourne (ok, message)."""
    import requests
    projet = os.environ.get(VAR_PROJET) or infos["project_id"]
    collection, doc = CHEMIN_DOC.split("/")
    url = (f"https://firestore.googleapis.com/v1/projects/{projet}"
           f"/databases/(default)/documents/{collection}/{doc}")
    corps = {"fields": {
        "json": {"stringValue": json.dumps(donnees, ensure_ascii=False,
                                           separators=(",", ":"), default=str)},
        "maj": {"stringValue": datetime.now().isoformat(timespec="seconds")},
    }}
    r = requests.patch(url, json=corps, timeout=30,
                       headers={"Authorization": f"Bearer {jeton}"})
    if r.status_code >= 400:
        return False, f"Firestore a refuse ({r.status_code}) : {r.text[:200]}"
    return True, f"Document {CHEMIN_DOC} mis a jour sur le projet {projet}."


def main(argv=None):
    ap = argparse.ArgumentParser(description="Synchronise le suivi vers Firestore")
    ap.add_argument("--donnees", default=str(DONNEES))
    ap.add_argument("--verifier", action="store_true",
                    help="controle la configuration sans rien ecrire")
    args = ap.parse_args(argv)

    print("=" * 62)
    print("  SYNCHRONISATION FIRESTORE (facultative)")
    print("=" * 62)

    infos, motif = _compte_de_service()
    if not infos:
        # Ce n'est PAS une erreur : le site fonctionne sans Firebase.
        print(f"\n  {motif}")
        print("  Le site reste alimente par web/data.json.\n")
        return 0

    donnees = charger_donnees(args.donnees)
    composants = sum(len(p["composants"]) for p in donnees.get("projets", []))
    print(f"\n  projet        : {infos['project_id']}")
    print(f"  compte        : {infos['client_email']}")
    print(f"  charge        : {composants} composant(s), "
          f"{len(json.dumps(donnees, default=str)) / 1024:.0f} Ko")
    offres = donnees.get("occasions_ultimes") or []
    if offres:
        print(f"  GROSSE OFFRE  : {len(offres)} en cours")

    if args.verifier:
        print("\n  --verifier : rien n'a ete ecrit.\n")
        return 0

    jeton, erreur = _jeton(infos)
    if not jeton:
        print(f"\n  {erreur}\n")
        return 1

    ok, message = pousser(donnees, infos, jeton)
    print(f"\n  {message}\n")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
