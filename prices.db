# ---------------------------------------------------------------------------
# CASCADE DE COLLECTE (Axe 3, prompt 8.1)
# ---------------------------------------------------------------------------
# La chaine de repli existait deja dans le code, mais implicitement : on
# essayait une methode, puis la suivante, sans jamais retenir laquelle avait
# reellement produit le prix. Deux prix identiques n'ont pourtant pas la meme
# valeur selon leur provenance -- un montant lu dans un balisage schema.org
# est autrement plus sur qu'un nombre glane dans le texte d'une page.
#
# Les paliers sont ordonnes par CONFIANCE DECROISSANTE.
CASCADE = [
    {"tier": "api", "rang": 0, "libelle": "API officielle",
     "confiance": "haute",
     "note": "Prevu, non implemente : reserve aux futures integrations "
             "d'affiliation. Aucun prix ne porte ce palier aujourd'hui."},
    {"tier": "jsonld", "rang": 1, "libelle": "donnees structurees (JSON-LD)",
     "confiance": "haute",
     "note": "schema.org declare par le marchand pour Google Shopping. "
             "Stable dans le temps, explicitement associe au produit."},
    {"tier": "selecteurs", "rang": 2, "libelle": "selecteurs CSS declares",
     "confiance": "moyenne",
     "note": "config.json/selecteurs_sites. Fiable tant que le site ne "
             "refond pas son HTML."},
    {"tier": "borne", "rang": 3, "libelle": "extraction bornee",
     "confiance": "faible",
     "note": "Plus bas montant plausible de la page, entre plancher et "
             "plafond. Aucune garantie que ce montant designe LE produit."},
]

PALIERS = {p["tier"]: p for p in CASCADE}
TIER_LE_PLUS_BAS = "borne"


def palier_info(tier):
    """Description d'un palier, ou None si inconnu."""
    return PALIERS.get(tier)


def extraire_prix_cascade(soup, site, selecteurs=None, comparateur=False):
    """
    Execute la cascade et retourne (prix, palier) -- le palier etant le
    tier ayant REELLEMENT produit le prix, pas celui qu'on esperait.

    L'ordre d'execution est conserve tel quel, y compris sa particularite :
    sur un comparateur, l'extraction bornee est tentee AVANT les selecteurs,
    parce qu'une page de comparateur n'a en general pas de selecteur declare
    et que le plus bas montant de la page y est justement l'information
    cherchee. L'ordre de CONFIANCE, lui, reste celui de CASCADE : c'est lui
    qui qualifie le prix une fois obtenu.

    Ne modifie aucun comportement : a prix identique, seule la provenance est
    desormais connue.
    """
    prix = extract_price_from_jsonld(soup, prefer_low=comparateur)
    if prix is not None:
        return prix, "jsonld"

    if comparateur:
        prix = extract_min_price_from_page(soup)
        if prix is not None:
            return prix, "borne"

    prix = extract_price_fallback(soup, site, selecteurs)
    if prix is not None:
        return prix, "selecteurs"

    return None, None


def extract_identite_from_jsonld(soup):
    """
    Axe 2 : extrait l'identite produit des donnees structurees schema.org.

    Recherche, sur les noeuds Product, les identifiants normalises du
    commerce : `gtin`, `gtin8`, `gtin12`, `gtin13`, `gtin14` (le code-barres
    EAN/UPC) et `mpn` (reference fabricant). Ce sont eux qui permettent
    d'affirmer que deux annonces portent sur le MEME article -- ce que le
    seul prix ne dira jamais.

    Retourne {"gtin", "mpn", "titre", "marque"} (valeurs eventuellement None).
    """
    CLES_GTIN = ("gtin13", "gtin14", "gtin12", "gtin8", "gtin", "ean", "isbn")
    trouve = {"gtin": None, "mpn": None, "titre": None, "marque": None}

    def _visiter(noeud):
        if isinstance(noeud, list):
            for x in noeud:
                _visiter(x)
            return
        if not isinstance(noeud, dict):
            return

        types = noeud.get("@type")
        types = [types] if isinstance(types, str) else (types or [])
        est_produit = any("product" in str(t).lower() for t in types)

        if est_produit:
            for cle in CLES_GTIN:
                val = noeud.get(cle)
                if val and not trouve["gtin"]:
                    trouve["gtin"] = str(val).strip()
                    break
            if noeud.get("mpn") and not trouve["mpn"]:
                trouve["mpn"] = str(noeud["mpn"]).strip()
            if noeud.get("sku") and not trouve["mpn"]:
                # Le SKU est propre au marchand : accepte en dernier recours
                # seulement, et jamais a la place d'un vrai MPN.
                trouve["mpn"] = str(noeud["sku"]).strip()
            nom = noeud.get("name")
            if isinstance(nom, dict):
                nom = nom.get("@value")
            if nom and not trouve["titre"]:
                trouve["titre"] = str(nom).strip()
            marque = noeud.get("brand")
            if isinstance(marque, dict):
                marque = marque.get("name")
            if marque and not trouve["marque"]:
                trouve["marque"] = str(marque).strip()

        for v in noeud.values():
            if isinstance(v, (dict, list)):
                _visiter(v)

    for script in soup.find_all("script", type="application/ld+json"):
        raw = script.string or script.get_text()
        if not raw:
            continue
        try:
            _visiter(json.loads(raw))
        except (json.JSONDecodeError, TypeError):
            continue

    return trouve


def extract_price_from_jsonld(soup, prefer_low=False, avec_identite=False):
    """
    Methode principale : donnees structurees schema.org, plus stables
    dans le temps que les selecteurs CSS.

    `prefer_low=True` (pages de comparateurs) : on cherche en priorite
    "lowPrice" d'un AggregateOffer, c'est-a-dire le prix le plus bas parmi
    TOUS les marchands references sur la page. C'est ce qui permet de
    couvrir des dizaines de vendeurs avec une seule requete.

    `avec_identite=True` (Axe 2) : retourne (prix, identite) au lieu du seul
    prix, `identite` etant le dict rendu par extract_identite_from_jsonld.
    Le defaut reste le prix seul, pour ne rien changer aux appelants
    existants.
    """
    if avec_identite:
        return (extract_price_from_jsonld(soup, prefer_low=prefer_low),
                extract_identite_from_jsonld(soup))

    candidats = []

    for script in soup.find_all("script", type="application/ld+json"):
        raw = script.string
        if not raw:
            continue
        try:
            data = json.loads(raw)
        except (json.JSONDecodeError, TypeError):
            continue

        for item in (data if isinstance(data, list) else [data]):
            if not isinstance(item, dict):
                continue
            offers = item.get("offers")
            if not offers:
                continue

            for offer in (offers if isinstance(offers, list) else [offers]):
                if not isinstance(offer, dict):
                    continue

                # AggregateOffer : plusieurs marchands regroupes
                if offer.get("@type") in ("AggregateOffer", "http://schema.org/AggregateOffer"):
                    for cle in ("lowPrice", "price"):
                        val = offer.get(cle)
                        if val:
                            try:
                                candidats.append((0 if cle == "lowPrice" else 1,
                                                  float(str(val).replace(",", "."))))
                            except ValueError:
                                pass
                else:
                    val = offer.get("price")
                    if val:
                        try:
                            candidats.append((1, float(str(val).replace(",", "."))))
                        except ValueError:
                            pass

    if not candidats:
        return None

    if prefer_low:
        # Sur un comparateur : le plus bas prix trouve, tous marchands confondus
        return min(p for _, p in candidats)

    # Sur une fiche marchand : on privilegie l'offre principale
    candidats.sort(key=lambda c: c[0])
    return candidats[0][1]


def extract_price_fallback(soup, site, selecteurs=None):
    liste = (selecteurs or {}).get(site) or FALLBACK_SELECTORS.get(site, [])
    for selector in liste:
        el = soup.select_one(selector)
        if not el:
            continue
        match = re.search(r"(\d[\d\s]*)[,.](\d{2})", el.get_text(strip=True))
        if match:
            try:
                return float(f"{match.group(1).replace(' ', '')}.{match.group(2)}")
            except ValueError:
                continue
    return None


def extract_min_price_from_page(soup, plancher=5, plafond=5000):
    """
    Repli pour les comparateurs : recupere tous les montants plausibles de
    la page et retient le plus bas. Volontairement borne par un plancher et
    un plafond pour ecarter les frais de port, les prix a l'unite et les
    montants aberrants.
    """
    texte = soup.get_text(" ", strip=True)
    montants = []
    for m in re.finditer(r"(\d{1,4})[ ]?[,.](\d{2})\s*(?:EUR|€)", texte):
        try:
            val = float(f"{m.group(1)}.{m.group(2)}")
            if plancher <= val <= plafond:
                montants.append(val)
        except ValueError:
            continue
    return min(montants) if montants else None


def fetch_price(url, site, type_source="marchand", selecteurs=None,
                component=None, recuperateur=None, collecteur=None,
                paliers=None, sante=None):
    """
    Lit le prix d'une URL precise (fiche produit ou page de comparateur).

    Quand le moteur v3 est disponible, la page est analysee offre par offre :
    le prix retenu est celui de l'offre dont le titre correspond au produit
    ET qui est reellement disponible. Une fiche affichant 377 EUR en rupture
    de stock ne remonte donc plus 377 EUR.
    """
    if "REMPLACEZ" in url or "CHANGEZ" in url:
        print(f"  [!] URL non configuree pour {site} (placeholder dans config.json)")
        return None

    comparateur = (type_source == "comparateur")

    if MOTEUR_V3 and recuperateur is not None:
        html, motif = recuperateur.get(url)

        # --- 304 : la page n'a pas change, on reutilise le dernier prix ---
        # Ce n'est pas un echec : la fraicheur percue est identique, seule
        # l'extraction est evitee.
        if html is None and motif == getattr(moteur_recherche, "NON_MODIFIE", None):
            prix_connu, palier_connu = prix_du_cache(url)
            if sante is not None:
                fiche = sante.setdefault(site, {"ok": 0, "prix": 0, "palier": None})
                fiche["ok"] += 1
                if prix_connu is not None:
                    fiche["prix"] += 1
                    fiche["palier"] = palier_connu
            if prix_connu is not None:
                if paliers is not None and palier_connu:
                    paliers[site] = palier_connu
                print(f"     {prix_connu:.2f} EUR (inchange, page non "
                      f"retelechargee)")
                return prix_connu
            # Aucun prix memorise : on ne peut rien conclure de ce 304.
            print(f"  [!] {site} : page inchangee mais aucun prix memorise")
            return None

        if html is None:
            print(f"  [!] {site} injoignable ({motif})")
            return None
        if sante is not None:              # Axe 3 : requete aboutie
            sante.setdefault(site, {"ok": 0, "prix": 0, "palier": None})["ok"] += 1
        # Axe 2 : on releve aussi l'identite produit declaree par la page.
        if collecteur is not None:
            try:
                ident = extract_identite_from_jsonld(
                    BeautifulSoup(html, "html.parser"))
                if ident.get("gtin") or ident.get("mpn") or ident.get("titre"):
                    collecteur.append({**ident, "site": site, "url": url})
            except Exception:
                pass
        prix, dispo = _prix_depuis_page(html, url, site, component,
                                        comparateur, selecteurs, paliers)
        if prix is None:
            print(f"  [!] Prix introuvable sur {site}")
            # Cascade epuisee : on garde de quoi comprendre, hors ligne.
            chemin = enregistrer_snapshot(
                html, site, (component or {}).get("id"),
                "cascade epuisee, aucun prix plausible")
            if chemin:
                print(f"      snapshot de diagnostic : {chemin.name}")
        elif dispo is False:
            print(f"  [!] {site} : {prix:.2f} EUR mais produit en RUPTURE "
                  f"-> prix ignore")
            return None
        if sante is not None and prix is not None:
            fiche = sante.setdefault(site, {"ok": 0, "prix": 0, "palier": None})
            fiche["prix"] += 1
            fiche["palier"] = (paliers or {}).get(site)
        # Memorise le prix AVEC ses validateurs : c'est lui qu'un futur 304
        # permettra de reutiliser sans retelecharger la page.
        if prix is not None and sqlite_store:
            sqlite_store.memoriser_cache_http(
                url, site, prix=prix, palier=(paliers or {}).get(site))
        return prix

    for attempt in range(1, MAX_RETRIES + 1):
        try:
            resp = requests.get(url, headers=HEADERS, timeout=REQUEST_TIMEOUT)
            resp.raise_for_status()
            soup = BeautifulSoup(resp.text, "html.parser")

            # Axe 3 : la cascade rend AUSSI le palier ayant produit le prix.
            price, palier = extraire_prix_cascade(soup, site, selecteurs,
                                                  comparateur)
            if paliers is not None and palier:
                paliers[site] = palier
            # Axe 2 : identite produit declaree en donnees structurees.
            if collecteur is not None:
                ident = extract_identite_from_jsonld(soup)
                if ident.get("gtin") or ident.get("mpn") or ident.get("titre"):
                    collecteur.append({**ident, "site": site, "url": url})

            if price is None:
                print(f"  [!] Prix introuvable sur {site}")
                chemin = enregistrer_snapshot(
                    resp.text, site, (component or {}).get("id"),
                    "cascade epuisee, aucun prix plausible")
                if chemin:
                    print(f"      snapshot de diagnostic : {chemin.name}")
            return price
        except requests.RequestException as e:
            print(f"  [!] Tentative {attempt}/{MAX_RETRIES} echouee ({site}) : {e}")
            time.sleep(2)
    return None


def _prix_depuis_page(html, url, site, component, comparateur, selecteurs,
                      paliers=None):
    """Renvoie (prix, disponibilite) pour une URL produit ou comparateur."""
    offres = moteur_recherche.extraire_offres(html, url)
    if not offres:
        soup = BeautifulSoup(html, "html.parser")
        prix, palier = extraire_prix_cascade(soup, site, selecteurs, comparateur)
        if paliers is not None and palier:
            paliers[site] = palier
        return prix, None

    # Le moteur v3 note la methode d'extraction de chaque offre : on la
    # traduit dans le vocabulaire de la cascade.
    if paliers is not None:
        _methodes = {"jsonld": "jsonld", "microdonnees": "selecteurs",
                     "carte": "borne"}
        meilleure = min(offres, key=lambda o: o.prix)
        paliers[site] = _methodes.get(getattr(meilleure, "methode", ""), "borne")

    terme = (component or {}).get("recherche") or (component or {}).get("name")
    if terme:
        seuil = moteur_recherche.SEUIL_PERTINENCE
        pertinentes = [
            o for o in offres
            if moteur_recherche.score_pertinence(
                o.titre, terme, (component or {}).get("category", ""),
                (component or {}).get("exclure")) >= seuil
        ]
        # Une fiche produit ne contient parfois qu'un titre tronque : si rien
        # ne correspond mais qu'une seule offre existe, c'est elle.
        if pertinentes:
            offres = pertinentes
        elif len(offres) > 1 and not comparateur:
            offres = offres[:1]

    reference = ((component or {}).get("reference") or {}).get("typical_price")
    offres = [o for o in offres if moteur_recherche.plausible(o.prix, reference)] or offres

    disponibles = [o for o in offres if o.dispo is not False]
    if disponibles:
        meilleure = min(disponibles, key=lambda o: o.prix)
        return meilleure.prix, meilleure.dispo
    meilleure = min(offres, key=lambda o: o.prix)
    return meilleure.prix, False


def prix_plausible(prix, reference, tolerance=0.45):
    """
    Garde-fou indispensable pour la recherche par mot-cle.

    Chercher "Ryzen 7 5700X" sur un moteur de recherche marchand peut
    remonter un ventirad, un cable, ou un autre modele de la gamme. On
    n'accepte donc un prix que s'il reste dans une fourchette plausible
    autour du prix de reference connu. Sans ce filtre, un accessoire a
    12 EUR ferait croire a une occasion ultime.
    """
    if not reference or reference <= 0:
        return True                      # pas de repere : on ne peut pas juger
    bas = reference * (1 - tolerance)
    haut = reference * (1 + tolerance * 2)
    return bas <= prix <= haut


def rechercher_chez_vendeurs(component, config, deja_vus=None, recuperateur=None):
    """
    Interroge le catalogue de vendeurs (France + Europe) avec le terme de
    recherche du composant.

    Depuis la v3, le travail est delegue a moteur_recherche.py, qui decoupe
    chaque page en offres individuelles et verifie que le titre correspond
    bien au produit cherche. L'ancienne methode ci-dessous (prendre le prix
    le plus bas de la page, quel que soit le produit) est conservee comme
    repli si le module est absent.
    """
    if MOTEUR_V3 and config.get("vendeurs"):
        return moteur_recherche.rechercher_compat(
            component, config, deja_vus=deja_vus, recuperateur=recuperateur)

    terme = component.get("recherche")
    if not terme:
        return []

    vendeurs = config.get("vendeurs") or {}
    seuils = config.get("thresholds", {})
    maxi = seuils.get("max_vendeurs_par_composant", 8)
    tolerance = seuils.get("tolerance_prix_recherche", 0.45)
    reference = (component.get("reference") or {}).get("typical_price")
    selecteurs = config.get("selecteurs_sites")
    deja_vus = deja_vus or set()

    # Comparateurs d'abord, puis marchands par priorite
    candidats = [
        (nom, v) for nom, v in vendeurs.items()
        if nom != "_comment" and v.get("actif") and nom not in deja_vus
    ]
    candidats.sort(key=lambda kv: (kv[1].get("priorite", 5),
                                   0 if kv[1].get("type") == "comparateur" else 1))
    candidats = candidats[:maxi]

    from urllib.parse import quote_plus
    trouves, rejetes = [], 0

    for nom, v in candidats:
        url = v["url"].replace("{q}", quote_plus(terme))
        est_comp = v.get("type") == "comparateur"
        print(f"  -> {nom} ({v.get('pays','?')}"
              f"{', comparateur' if est_comp else ''})...")

        # Une page de resultats se lit comme un comparateur : on prend le
        # prix le plus bas de la page.
        prix = fetch_price(url, nom, "comparateur", selecteurs)

        if prix is None:
            continue
        if not prix_plausible(prix, reference, tolerance):
            print(f"     {prix:.2f} EUR ecarte (hors fourchette plausible "
                  f"autour de {reference:.0f} EUR)")
            rejetes += 1
            continue

        trouves.append((nom, prix))
        print(f"     {prix:.2f} EUR")
        time.sleep(DELAY_BETWEEN_REQUESTS)

    if rejetes:
        print(f"  ({rejetes} resultat(s) ecarte(s) : produit probablement different)")
    return trouves


def fetch_all_sources(component, selecteurs=None, config=None, recuperateur=None,
                      offres_pretes=None, collecteur=None, paliers=None,
                      sante=None):
    """
    Retourne la liste [(site, prix), ...] de toutes les sources ayant repondu :
    d'abord les URLs precises du composant, puis la recherche multi-vendeurs.

    `offres_pretes` contient les offres deja recoltees par la recherche
    groupee (une requete pour plusieurs composants d'une meme famille). Quand
    elle est fournie, on ne relance pas de recherche pour ce composant.
    """
    found = []
    sites_vus = set()

    # Un seul recuperateur pour tout le composant : connexions reutilisees,
    # cache des pages deja lues, et surtout un delai respecte par domaine
    # meme quand les requetes partent en parallele.
    recup = None
    if MOTEUR_V3:
        if recuperateur is None:
            recup = moteur_recherche.Recuperateur()
        else:
            recup = recuperateur

    # 1) URLs precises configurees pour ce composant (les plus fiables)
    for source in component["sources"]:
        site, url = source["site"], source["url"]
        type_source = source.get("type", "marchand")
        etiquette = f"{site} (comparateur)" if type_source == "comparateur" else site
        print(f"  -> {etiquette}...")
        price = fetch_price(url, site, type_source, selecteurs,
                            component=component, recuperateur=recup,
                            collecteur=collecteur, paliers=paliers, sante=sante)
        if price is not None:
            found.append((site, price))
            sites_vus.add(site)
            print(f"     {price:.2f} EUR")
        if recup is None:
            time.sleep(DELAY_BETWEEN_REQUESTS)

    # 2) Recherche elargie sur le catalogue de vendeurs
    if offres_pretes is not None:
        seuils = (config or {}).get("thresholds", {})
        garder = seuils.get("inclure_ruptures", False)
        livre = seuils.get("comparer_prix_livre", True)

        # Une offre isolee tres en dessous de ce que disent tous les autres
        # vendeurs n'entre pas dans l'historique : c'est une boutique
        # frauduleuse, une erreur de prix, ou une lecture ratee.
        if ANALYSE and offres_pretes:
            offres_pretes, ecartees = analyse_offres.filtrer_credibles(
                offres_pretes, config)
            for e in ecartees:
                print(f"  [!] {e.vendeur} a {e.prix:.2f} EUR ecarte : "
                      f"{'; '.join(e.raisons[:2])}")

        for o in offres_pretes:
            if o.vendeur in sites_vus:
                continue
            if not garder and o.dispo is False:
                continue
            found.append((o.vendeur, o.prix_livre if livre else o.prix))
            # Axe 3 : palier de la cascade ayant produit ce prix.
            if paliers is not None:
                _m = {"jsonld": "jsonld", "microdonnees": "selecteurs",
                      "carte": "borne"}
                paliers[o.vendeur] = _m.get(getattr(o, "methode", ""), "borne")
            # Axe 2 : chaque offre de la recherche elargie est une annonce
            # candidate a rattacher au produit canonique.
            if collecteur is not None:
                collecteur.append({
                    "site": o.vendeur, "url": getattr(o, "url", ""),
                    "gtin": getattr(o, "gtin", None),
                    "mpn": getattr(o, "mpn", None),
                    "titre": getattr(o, "titre", ""), "marque": None,
                })
    elif config and config.get("vendeurs"):
        trouves = rechercher_chez_vendeurs(component, config, sites_vus,
                                           recuperateur=recup)
        found += trouves

    return found


# ---------------------------------------------------------------------------
# Historique : import du seed + ajout des releves
# ---------------------------------------------------------------------------

def ensure_component_in_history(history, component):
    cid = component["id"]
    if cid not in history:
        history[cid] = {
            "name": component["name"],
            "category": component["category"],
            "entries": [],
            "seed_imported": False,
        }
    history[cid]["name"] = component["name"]
    history[cid]["category"] = component["category"]
    if sqlite_store:                       # ecriture parallele (no-op si non configure)
        sqlite_store.upsert_produit(cid, component["name"], component["category"],
                                    component.get("slot"), component.get("perf_index"))
    return history[cid]


def import_seed_history(history, component, force=False):
    """
    Injecte les releves historiques manuels (`seed_history` du config) dans
    l'historique, une seule fois (sauf --reset-seed). C'est ce qui permet
    d'avoir des conseils utiles des le premier jour au lieu de tout voir
    marque "ACHETER" faute de recul.
    """
    node = ensure_component_in_history(history, component)
    seeds = component.get("seed_history", [])

    if not seeds:
        return 0
    if node.get("seed_imported") and not force:
        return 0

    if force:
        node["entries"] = [e for e in node["entries"] if e.get("origin") != "seed"]

    existing = {(e["date"], e["site"], e["price"]) for e in node["entries"]}
    added = 0
    for s in seeds:
        key = (s["date"], s["site"], s["price"])
        if key not in existing:
            node["entries"].append({
                "date": s["date"], "site": s["site"],
                "price": s["price"], "origin": "seed",
            })
            added += 1
            if sqlite_store:               # ecriture parallele
                sqlite_store.record_releve(component["id"], s["site"],
                                           s["price"], s["date"], "seed")

    node["entries"].sort(key=lambda e: e["date"])
    node["seed_imported"] = True
    if sqlite_store:
        sqlite_store.marquer_seed_importe(component["id"])
    return added


def add_price_entry(history, component_id, price, site, when=None, origin="tracked",
                    source_tier=None):
    day = when or datetime.now().strftime("%Y-%m-%d")
    node = history[component_id]
    # On evite les doublons exacts (meme jour, meme site) : on ecrase.
    node["entries"] = [
        e for e in node["entries"]
        if not (e["date"] == day and e["site"] == site and e.get("origin") == origin)
    ]
    entree = {"date": day, "site": site, "price": price, "origin": origin}
    # Axe 3 : le palier de la cascade voyage AVEC l'entree. `persister`
    # reconstruit la table a partir de l'etat en memoire : sans cela, le
    # palier serait efface a la premiere sauvegarde.
    if source_tier:
        entree["tier"] = source_tier
    node["entries"].append(entree)
    node["entries"].sort(key=lambda e: e["date"])
    if sqlite_store:                       # ecriture parallele (no-op si non configure)
        sqlite_store.record_releve(component_id, site, price, day, origin,
                                   source_tier=source_tier)


# ---------------------------------------------------------------------------
# Saisonnalite
# ---------------------------------------------------------------------------

def event_dates_for_year(event, year):
    s_m, s_d = event["start"]
    e_m, e_d = event["end"]
    start = date(year, s_m, s_d)
    end = date(year, e_m, e_d)
    if end < start:                       # evenement a cheval sur 2 annees
        end = date(year + 1, e_m, e_d)
    return start, end


def current_and_next_events(today=None):
    """Retourne (evenement_en_cours_ou_None, prochain_evenement, jours_avant)."""
    today = today or date.today()
    ongoing, upcoming = None, []

    for year in (today.year, today.year + 1):
        for event in SEASONAL_EVENTS:
            start, end = event_dates_for_year(event, year)
            if start <= today <= end:
                ongoing = {**event, "start_date": start, "end_date": end,
                           "days_left": (end - today).days}
            elif start > today:
                upcoming.append({**event, "start_date": start, "end_date": end,
                                 "days_until": (start - today).days})

    upcoming.sort(key=lambda e: e["days_until"])
    return ongoing, (upcoming[0] if upcoming else None)


# ---------------------------------------------------------------------------
# Analyse d'un composant
# ---------------------------------------------------------------------------

def analyze_component(node, reference, thresholds, market_ctx, ongoing, next_event,
                      evenements=None):
    entries = node["entries"]
    if not entries:
        return None

    prices = [e["price"] for e in entries]
    dates = [e["date"] for e in entries]
    current_entry = entries[-1]
    current = current_entry["price"]

    # -- Bornes historiques, en fusionnant l'observe et le connu (reference) --
    observed_low = min(prices)
    observed_high = max(prices)
    ref_low = (reference or {}).get("historical_low")
    ref_typical = (reference or {}).get("typical_price")
    ref_msrp = (reference or {}).get("msrp")

    effective_low = min([p for p in (observed_low, ref_low) if p is not None])
    effective_high = max([p for p in (observed_high, ref_msrp) if p is not None])
    baseline = ref_typical or statistics.median(prices)

    # -- Fenetres temporelles --
    today = datetime.now().date()

    def prices_within(days):
        cutoff = (today - timedelta(days=days)).isoformat()
        vals = [e["price"] for e in entries if e["date"] >= cutoff]
        return vals or prices[-1:]

    avg_7d = statistics.mean(prices_within(7))
    avg_30d = statistics.mean(prices_within(30))
    avg_90d = statistics.mean(prices_within(90))

    # -- Tendance : compare le releve courant au precedent releve DIFFERENT --
    previous = None
    previous_date = None
    for e in reversed(entries[:-1]):
        if e["date"] != current_entry["date"]:
            previous = e["price"]
            previous_date = e["date"]
            break

    if previous is None:
        trend, trend_pct = "nouveau", 0.0
    elif current < previous:
        trend, trend_pct = "baisse", (previous - current) / previous * 100
    elif current > previous:
        trend, trend_pct = "hausse", (current - previous) / previous * 100
    else:
        trend, trend_pct = "stable", 0.0

    # -- Volatilite : a quel point le prix bouge --
    volatility = (statistics.pstdev(prices) / statistics.mean(prices) * 100) if len(prices) > 1 else 0.0

    # -- Position dans la fourchette historique (0 = au plus haut, 100 = au plus bas) --
    # Si la fourchette connue est trop etroite (< 5% du prix), elle n'est pas
    # assez significative pour situer le prix : on reste neutre plutot que de
    # produire un score trompeur sur un echantillon trop plat.
    span = effective_high - effective_low
    if span <= 0:
        position_score = 100.0
    elif span < current * 0.05:
        position_score = 50.0
        enough_spread = False
    else:
        position_score = max(0.0, min(100.0, (effective_high - current) / span * 100))
    enough_spread = span >= current * 0.05

    # -- Ecarts utiles --
    vs_low_pct = (current - effective_low) / effective_low * 100 if effective_low else 0.0
    vs_baseline_pct = (current - baseline) / baseline * 100 if baseline else 0.0

    # -- Jours depuis le plus bas observe --
    idx_low = prices.index(observed_low)
    days_since_low = (today - datetime.strptime(dates[idx_low], "%Y-%m-%d").date()).days

    # -- Fraicheur : depuis combien de jours ce prix n'a-t-il pas ete revu ? --
    # Important : un prix importe de l'historique peut dater de plusieurs
    # semaines. Il sert de repere, mais ne doit pas etre presente comme le
    # prix du jour.
    days_stale = (today - datetime.strptime(current_entry["date"], "%Y-%m-%d").date()).days
    is_stale = days_stale > 7

    # -- Qualification "affaire" --
    is_strong_deal = vs_low_pct <= thresholds.get("strong_deal_percent", 1)
    is_deal = vs_low_pct <= thresholds.get("deal_percent", 3)

    # ===================================================================
    # DETECTION "OCCASION ULTIME"
    # ===================================================================
    # Une occasion ultime, ce n'est pas juste "le prix est bas" : c'est un
    # prix qu'on ne reverra probablement pas de sitot. Trois signaux
    # independants la declenchent, et on garde la raison la plus forte.
    ultimate = False
    ultimate_reasons = []
    ultimate_level = 0          # 1 = tres bonne, 2 = exceptionnelle, 3 = historique

    ref = reference or {}
    dream_price = ref.get("prix_reve")
    seuil_ultime = thresholds.get("seuil_occasion_ultime_percent", 5)
    seuil_bug = thresholds.get("seuil_bug_prix_percent", 30)
    seuil_chute = thresholds.get("chute_soudaine_percent", 15)

    # Signal 1 : sous le plus bas jamais connu, d'une marge significative.
    # Point cle : on compare au plancher HORS releve du jour. Sinon le prix
    # actuel ferait lui-meme partie du minimum et ne pourrait jamais le
    # battre — l'alerte ne se declencherait jamais.
    prix_anterieurs = [e["price"] for e in entries if e["date"] != current_entry["date"]]
    plancher_anterieur = None
    candidats_plancher = [p for p in (
        min(prix_anterieurs) if prix_anterieurs else None,
        ref_low,
    ) if p is not None]
    if candidats_plancher:
        plancher_anterieur = min(candidats_plancher)

    sous_le_plancher_pct = 0.0
    if plancher_anterieur and plancher_anterieur > 0:
        sous_le_plancher_pct = (plancher_anterieur - current) / plancher_anterieur * 100

    if sous_le_plancher_pct >= seuil_ultime:
        ultimate = True
        ultimate_level = max(ultimate_level, 2)
        ultimate_reasons.append(
            f"{sous_le_plancher_pct:.1f}% SOUS le plus bas jamais observe "
            f"({plancher_anterieur:.2f} EUR)"
        )

    # Signal 2 : le prix de reve configure est atteint
    if dream_price and current <= dream_price:
        ultimate = True
        ultimate_level = max(ultimate_level, 3)
        ultimate_reasons.append(
            f"Votre prix cible de {dream_price:.2f} EUR est atteint"
        )

    # Signal 3 : chute brutale entre deux releves RAPPROCHES (vente flash,
    # destockage). On exige que le releve precedent soit recent : une baisse
    # de 20% etalee sur six semaines est une tendance de marche normale,
    # pas une occasion a saisir dans l'heure.
    ecart_jours_precedent = None
    if previous_date:
        ecart_jours_precedent = (
            datetime.strptime(current_entry["date"], "%Y-%m-%d").date()
            - datetime.strptime(previous_date, "%Y-%m-%d").date()
        ).days

    if (previous and previous > 0
            and ecart_jours_precedent is not None
            and ecart_jours_precedent <= 3):
        chute_pct = (previous - current) / previous * 100
        if chute_pct >= seuil_chute:
            ultimate = True
            ultimate_level = max(ultimate_level, 1)
            ultimate_reasons.append(
                f"Chute de {chute_pct:.0f}% en {ecart_jours_precedent} jour(s)"
            )

    # Garde-fou : un prix trop beau est souvent une erreur d'affichage
    # (le marchand annule la commande) ou un vendeur tiers douteux.
    prix_suspect = sous_le_plancher_pct >= seuil_bug
    if prix_suspect:
        ultimate_level = 3
        ultimate_reasons.append(
            "ATTENTION : ecart tres inhabituel, verifiez qu'il ne s'agit pas "
            "d'une erreur de prix ou d'un vendeur tiers non fiable"
        )

    # -- Tendance hebdo : le prix glisse-t-il vers le bas ? --
    recent = prices_within(10)
    declining = len(recent) >= 3 and recent[-1] < recent[0]

    # ---------------- Moteur de decision ----------------
    reasons = []
    if ultimate:
        advice, confidence = "OCCASION ULTIME", "haute"
        reasons.extend(ultimate_reasons)
    elif is_strong_deal:
        advice, confidence = "ACHETER", "haute"
        reasons.append(f"Prix au plus bas connu ({effective_low:.2f} EUR).")
    elif is_deal:
        advice, confidence = "ACHETER", "haute"
        reasons.append(f"A {vs_low_pct:.1f}% seulement du plus bas connu.")
    elif declining and vs_low_pct > thresholds.get("deal_percent", 3) * 2:
        advice, confidence = "ATTENDRE", "moyenne"
        reasons.append("Le prix glisse vers le bas ces derniers jours.")
    elif vs_baseline_pct > thresholds.get("wait_percent", 10):
        advice, confidence = "ATTENDRE", "haute"
        reasons.append(f"{vs_baseline_pct:.0f}% au-dessus du prix habituel ({baseline:.2f} EUR).")
    elif vs_low_pct <= thresholds.get("deal_percent", 3) * 3:
        advice, confidence = "CORRECT", "moyenne"
        reasons.append("Prix raisonnable, sans etre le meilleur jamais vu.")
    else:
        advice, confidence = "NEUTRE", "faible"
        reasons.append("Prix dans la moyenne, rien de particulier a signaler.")

    # --- Ajustement selon le contexte marche de la categorie ---
    ctx = market_ctx.get(node["category"])
    if ctx:
        if ctx["trend"] == "hausse" and advice == "ATTENDRE":
            advice = "CORRECT"
            reasons.append("Marche en hausse sur cette categorie : attendre est risque.")
        elif ctx["trend"] == "baisse" and advice == "CORRECT":
            advice = "ATTENDRE"
            reasons.append("Marche en baisse sur cette categorie : patienter peut payer.")

    # --- Ajustement saisonnier ---
    seasonal_note = None
    cat = node["category"]
    if next_event and cat in next_event["best_for"]:
        d = next_event["days_until"]
        if d <= 45 and advice in ("CORRECT", "NEUTRE", "ATTENDRE"):
            advice = "ATTENDRE"
            reasons.append(
                f"{next_event['name']} dans {d} jours (-{next_event['typical_drop']}% typiques sur cette categorie)."
            )
            seasonal_note = f"{next_event['name']} dans {d} j"
        elif d <= 45:
            seasonal_note = f"{next_event['name']} dans {d} j (mais le prix actuel est deja excellent)"
    if ongoing and cat in ongoing["best_for"]:
        seasonal_note = f"{ongoing['name']} en cours ({ongoing['days_left']} j restants)"

    # --- Ajustement evenementiel produit (roadmap 6.3, decisionnel en v3.1) ---
    # Meme mecanisme que les deux ajustements ci-dessus : on ne remplace pas la
    # logique existante, on s'y ajoute. Les prix GPU/CPU reagissent bien plus a
    # une nouvelle generation qu'a une periode commerciale -- d'ou un signal
    # dedie, applique en dernier.
    signal_produit = None
    if evenements:
        signal_produit = signal_refresh(
            evenements, cat, thresholds.get("horizon_refresh_jours", 60),
            slot=(node.get("slot") if isinstance(node, dict) else None))

    if signal_produit and signal_produit["nature"] == "refresh":
        # Une occasion ultime reste une occasion ultime : un plancher
        # historique ne s'annule pas parce qu'une generation arrive. De meme,
        # on ne conseille rien sur un prix non reverifie.
        deplacable = advice in ("CORRECT", "NEUTRE", "ATTENDRE") or (
            advice == "ACHETER" and not is_strong_deal)
        if deplacable:
            advice = "ATTENDRE"
            reasons.insert(
                0, f"{signal_produit['nom']} attendu dans "
                   f"{signal_produit['jours']} jours : la generation actuelle "
                   f"devrait se deprecier (typiquement 15 a 30%).")
        else:
            reasons.append(
                f"{signal_produit['nom']} attendu dans "
                f"{signal_produit['jours']} jours, mais le prix actuel est "
                f"deja exceptionnel : l'attente n'est pas conseillee.")

    elif signal_produit and signal_produit["nature"] == "aucun_refresh":
        # Point 3 : aucune pression a attendre pour cause de succession. La
        # declaration annule un eventuel "refresh" de la meme categorie (voir
        # signal_refresh), donc aucun ajustement n'est applique ici. Les autres
        # signaux -- occasion ultime, prix vs plancher, saisonnalite -- gardent
        # la main.
        reasons.append(
            f"Aucune nouvelle generation attendue sur cette categorie "
            f"({signal_produit['nom']}) : rien ne justifie d'attendre pour "
            f"cette raison.")

    # --- Donnee perimee : on ne conseille pas d'acheter sur un prix non verifie ---
    if is_stale:
        reasons.insert(0, f"Prix non reverifie depuis {days_stale} jours : a confirmer sur le site.")
        confidence = "faible"
        if advice == "ACHETER":
            advice = "A VERIFIER"
        elif advice == "OCCASION ULTIME":
            # On ne fait PAS disparaitre l'alerte : une occasion ultime reste
            # signalee, mais on previent clairement qu'elle date.
            ultimate_reasons.insert(0, f"Releve vieux de {days_stale} jours, peut ne plus etre valide")

    # -- Detection de fausse promotion (roadmap 6.1) --
    fausse_promo = detecter_fausse_promo(
        entries, current, thresholds.get("seuil_gonflage_percent", 5))
    if fausse_promo:
        if fausse_promo["verdict"] == "fausse":
            reasons.insert(0, fausse_promo["message"])
            if advice in ("ACHETER", "CORRECT", "NEUTRE"):
                advice = "ATTENDRE"
        elif fausse_promo["verdict"] == "neutre":
            reasons.append(fausse_promo["message"])

    # -- Indice de confiance : combien de donnees soutiennent ce conseil ? --
    n = len(prices)
    if n >= 30:
        confidence_level, confidence_label = 3, "haute"
    elif n >= 10:
        confidence_level, confidence_label = 2, "moyenne"
    elif n >= 4:
        confidence_level, confidence_label = 1, "faible"
    else:
        confidence_level, confidence_label = 0, "tres faible"
    if is_stale:
        confidence_level = min(confidence_level, 1)
        confidence_label = "faible (donnee ancienne)"

    # -- Score global d'affaire 0-100 --
    score = position_score * 0.6
    score += max(0.0, 30.0 - vs_low_pct * 3)          # proximite du plus bas
    score += 10 if trend == "baisse" else (0 if trend == "hausse" else 5)
    if is_stale:
        score *= 0.8                                   # on degrade si non verifie
    score = round(max(0.0, min(100.0, score)))

    return {
        "current": current,
        "current_site": current_entry["site"],
        "days_stale": days_stale,
        "is_stale": is_stale,
        "effective_low": effective_low,
        "effective_high": effective_high,
        "observed_low": observed_low,
        "baseline": round(baseline, 2),
        "avg_7d": round(avg_7d, 2),
        "avg_30d": round(avg_30d, 2),
        "avg_90d": round(avg_90d, 2),
        "trend": trend,
        "trend_pct": round(trend_pct, 1),
        "volatility": round(volatility, 1),
        "position_score": round(position_score),
        "enough_spread": enough_spread,
        "score": score,
        "vs_low_pct": round(vs_low_pct, 1),
        "vs_baseline_pct": round(vs_baseline_pct, 1),
        "days_since_low": days_since_low,
        "is_deal": is_deal,
        "is_strong_deal": is_strong_deal,
        "is_ultimate": ultimate,
        "ultimate_level": ultimate_level,
        "ultimate_reasons": ultimate_reasons,
        "prix_suspect": prix_suspect,
        "sous_le_plancher_pct": round(sous_le_plancher_pct, 1),
        "dream_price": dream_price,
        "fausse_promo": fausse_promo,
        "confidence_level": confidence_level,
        "confidence_label": confidence_label,
        "advice": advice,
        "confidence": confidence,
        "reasons": reasons,
        "seasonal_note": seasonal_note,
        "signal_produit": signal_produit,
        "data_points": len(prices),
        "seeded": any(e.get("origin") == "seed" for e in entries),
    }


def site_intelligence(node):
    """Quel revendeur propose le plus souvent le meilleur prix pour ce composant ?"""
    by_date = {}
    for e in node["entries"]:
        by_date.setdefault(e["date"], []).append(e)

    wins, sums, counts = {}, {}, {}
    for day, day_entries in by_date.items():
        if len(day_entries) > 1:
            best = min(day_entries, key=lambda e: e["price"])
            wins[best["site"]] = wins.get(best["site"], 0) + 1
        for e in day_entries:
            sums[e["site"]] = sums.get(e["site"], 0) + e["price"]
            counts[e["site"]] = counts.get(e["site"], 0) + 1

    averages = {s: round(sums[s] / counts[s], 2) for s in sums}
    best_site = min(averages, key=averages.get) if averages else None
    comparison_days = sum(1 for v in by_date.values() if len(v) > 1)

    return {
        "wins": wins,
        "averages": averages,
        "best_site": best_site,
        "comparison_days": comparison_days,
    }


# ---------------------------------------------------------------------------
# Plan d'achat global
# ---------------------------------------------------------------------------

def optimiser_sequence(retenus, budget, pression=None, history=None, config=None,
                       horizon_defaut=60):
    """
    Vague 7 : arbitre l'ordre d'achat ENTRE slots, au lieu de laisser chaque
    composant decider dans son coin.

    Le raisonnement n'est pas un tri par urgence, ni une somme ponderee de
    criteres. Il part d'une identite comptable simple :

        cout total = somme des prix - somme des gains obtenus en differant

    Puisqu'il faudra de toute facon UN composant par slot, la question n'est
    pas QUOI acheter mais QUAND. Minimiser le cout total revient donc a
    MAXIMISER le gain cumule des achats differes -- sous deux contraintes :

      * echeance : un composant qu'on n'a plus le temps d'attendre doit etre
        achete maintenant, quelle que soit l'esperance de gain ;
      * budget : ce qu'on achete aujourd'hui doit tenir dans l'enveloppe
        disponible. Un budget serre POUSSE a differer, et on differe alors en
        priorite ce qui rapporte le plus a attendre.

    C'est ce qui produit un ordre different d'un simple tri par conseil : un
    slot « ACHETER » sans contrainte de temps peut ceder sa place a un slot
    dont l'attente rapporte davantage, ou passer devant parce que l'echeance
    ne laisse plus le choix.

    Entrees par composant : conseil et signal produit (7.3), esperance de gain
    (7.2, elle-meme fondee sur les frequences de 7.1), perf_index, prix.

    Retourne {"maintenant": [...], "differes": [...], "explication": str, ...}
    ou chaque element porte SA raison, en clair.
    """
    if not retenus:
        return None

    jours_restants = pression["jours"] if pression else None
    # Marge de securite : commander, livrer, monter. Attendre jusqu'au dernier
    # jour n'a pas de sens.
    marge = 10
    fenetre = None
    if jours_restants is not None and jours_restants >= 0:
        fenetre = max(0, jours_restants - marge)

    items = []
    for r in retenus:
        a = r["analysis"]
        prix = a["current"]
        perf = r.get("perf_index") or 100
        signal = a.get("signal_produit")

        # --- Cette ligne peut-elle attendre ? ---
        raisons_blocage = []
        if a.get("is_ultimate"):
            raisons_blocage.append("prix exceptionnel, sous tout ce qui a ete observe")
        if fenetre is not None and fenetre <= 0:
            raisons_blocage.append(f"echeance dans {jours_restants} j : plus le temps")
        if a.get("is_stale"):
            raisons_blocage.append("prix non reverifie : a confirmer avant tout arbitrage")

        peut_attendre = not raisons_blocage

        # --- Combien rapporterait l'attente ? (7.2) ---
        horizon = horizon_defaut if fenetre is None else min(horizon_defaut, fenetre)
        gain, source_gain, n_gain = 0.0, "aucune", 0

        if peut_attendre and horizon > 0 and probabilites and history and config:
            comp = next((c for c in config.get("components", [])
                         if c["id"] == r["id"]), None)
            node = history.get(r["id"])
            if comp and node and node.get("entries"):
                entries = fusionner_entries(comp, node) or node["entries"]
                est = probabilites.esperance_attente(entries, horizon, prix)
                if est.get("estimable"):
                    gain, source_gain, n_gain = (est["esperance_eur"] or 0.0,
                                                 "mesure", est["n"])

        # Faute de mesure, un refresh annonce reste une raison chiffrable :
        # une nouvelle generation deprecie l'actuelle de 15 a 30%.
        if source_gain == "aucune" and signal and signal.get("nature") == "refresh":
            gain, source_gain = prix * 0.15, "refresh annonce"

        items.append({
            "id": r["id"], "nom": r["name"], "slot": r.get("slot"),
            "prix": prix, "perf": perf,
            "perf_par_euro": perf / prix if prix else 0.0,
            "conseil": a["advice"],
            "peut_attendre": peut_attendre,
            "raisons_blocage": raisons_blocage,
            "gain_attente": round(gain, 2),
            "source_gain": source_gain, "n_gain": n_gain,
            "signal": signal,
        })

    # --- Enveloppe disponible aujourd'hui ---
    enveloppe = (budget or {}).get("target_total") or (budget or {}).get("max_total")
    total = sum(i["prix"] for i in items)

    # Depart : tout acheter maintenant. On differe ensuite ce qui le merite.
    maintenant = list(items)
    differes = []

    def _differer(item, motif):
        maintenant.remove(item)
        differes.append({**item, "motif": motif})

    # 1) Differer ce dont l'attente rapporte reellement (gain significatif).
    #    Seuil : 1% du prix, pour ne pas differer sur un gain d'arrondi.
    volontaires = sorted(
        [i for i in items if i["peut_attendre"] and i["gain_attente"] > i["prix"] * 0.01],
        key=lambda i: -i["gain_attente"])
    for it in volontaires:
        _differer(it, "attendre rapporte davantage")

    # 2) Contrainte budgetaire : si ce qui reste ne tient pas dans l'enveloppe,
    #    on differe encore -- en sacrifiant d'abord le moins efficient (perf par
    #    euro le plus faible), pour garder la meilleure performance par euro
    #    parmi ce qu'on achete aujourd'hui.
    depassement = None
    if enveloppe:
        candidats = sorted([i for i in maintenant if i["peut_attendre"]],
                           key=lambda i: i["perf_par_euro"])
        while sum(i["prix"] for i in maintenant) > enveloppe and candidats:
            it = candidats.pop(0)
            _differer(it, "budget insuffisant aujourd'hui")
        reste = sum(i["prix"] for i in maintenant)
        if reste > enveloppe:
            depassement = reste - enveloppe

    cout_maintenant = sum(i["prix"] for i in maintenant)
    gain_differe = sum(i["gain_attente"] for i in differes)
    perf_maintenant = sum(i["perf"] for i in maintenant)

    # --- L'ordre differe-t-il d'un simple tri par conseil ? ---
    # Comparaison honnete : ce qu'aurait donne « j'achete tout ce qui est
    # marque ACHETER, je laisse le reste ».
    naif_maintenant = {i["id"] for i in items
                       if i["conseil"] in ("ACHETER", "OCCASION ULTIME")}
    optimise_maintenant = {i["id"] for i in maintenant}
    divergences = []
    for i in items:
        dans_naif = i["id"] in naif_maintenant
        dans_opt = i["id"] in optimise_maintenant
        if dans_naif != dans_opt:
            divergences.append({
                "nom": i["nom"], "conseil": i["conseil"],
                "sens": "avance" if dans_opt else "differe",
                "motif": (i["raisons_blocage"][0] if i["raisons_blocage"]
                          else next((d["motif"] for d in differes
                                     if d["id"] == i["id"]), "arbitrage budgetaire")),
            })

    return {
        "maintenant": sorted(maintenant, key=lambda i: -i["perf_par_euro"]),
        "differes": sorted(differes, key=lambda i: -i["gain_attente"]),
        "cout_maintenant": round(cout_maintenant, 2),
        "cout_total": round(total, 2),
        "gain_differe": round(gain_differe, 2),
        "perf_maintenant": perf_maintenant,
        "enveloppe": enveloppe,
        "depassement": round(depassement, 2) if depassement else None,
        "fenetre_jours": fenetre,
        "divergences": divergences,
        "explication": _expliquer_sequence(maintenant, differes, enveloppe,
                                           cout_maintenant, gain_differe,
                                           fenetre, jours_restants, depassement),
    }


def _expliquer_sequence(maintenant, differes, enveloppe, cout_maintenant,
                        gain_differe, fenetre, jours_restants, depassement):
    """
    Le « pourquoi » de la sequence, en une a deux phrases.

    Une liste ordonnee sans justification serait inutilisable : on ne saurait
    pas si l'ordre vient du budget, de l'echeance ou de l'esperance de gain.
    """
    if not maintenant and not differes:
        return ""

    phrases = []

    if maintenant:
        bloques = [i for i in maintenant if not i["peut_attendre"]]
        if bloques:
            motif = bloques[0]["raisons_blocage"][0]
            phrases.append(
                f"{len(maintenant)} composant(s) a prendre maintenant "
                f"({cout_maintenant:.2f} EUR) : "
                f"{len(bloques)} ne peuvent pas attendre ({motif})"
                + (", les autres tiennent dans l'enveloppe."
                   if len(maintenant) > len(bloques) else "."))
        else:
            phrases.append(
                f"{len(maintenant)} composant(s) a prendre maintenant "
                f"({cout_maintenant:.2f} EUR) : attendre ne leur rapporterait "
                f"rien de mesurable.")

    if differes:
        mesures = [d for d in differes if d["source_gain"] == "mesure"]
        budgetaires = [d for d in differes
                       if d["motif"] == "budget insuffisant aujourd'hui"]
        bouts = []
        if mesures:
            bouts.append(
                f"{len(mesures)} differe(s) parce qu'attendre a rapporte "
                f"en moyenne {sum(d['gain_attente'] for d in mesures):.2f} EUR "
                f"sur les periodes comparables observees")
        autres = [d for d in differes
                  if d["source_gain"] == "refresh annonce"]
        if autres:
            bouts.append(
                f"{len(autres)} differe(s) a cause d'une nouvelle generation "
                f"annoncee")
        if budgetaires:
            bouts.append(
                f"{len(budgetaires)} differe(s) faute de budget aujourd'hui "
                f"(les moins rentables en performance par euro)")
        if bouts:
            phrases.append("En face, " + " ; ".join(bouts) + ".")

    if fenetre is not None and fenetre <= 0 and jours_restants is not None:
        phrases.append(
            f"L'echeance ({jours_restants} j) ne laisse plus de marge : "
            "tout report devient risque.")
    elif differes and fenetre is not None:
        phrases.append(
            f"Il reste {fenetre} j de marge avant l'echeance pour que ces "
            "reports paient.")

    if depassement:
        phrases.append(
            f"Meme apres arbitrage, il manque {depassement:.2f} EUR : "
            "les composants restants ne peuvent pas etre differes.")

    return " ".join(phrases)


def build_buy_plan(results, budget, ongoing, next_event, comparaisons=None,
                   pression=None, history=None, config=None):
    ultimes = [r for r in results if r["analysis"].get("is_ultimate")]

    # --- Selection : un seul candidat retenu par slot d'equivalence ---
    # Sans cela, le total additionnerait les 4 cartes graphiques candidates,
    # ce qui n'a aucun sens : on n'en achete qu'une.
    ids_gagnants = {d["gagnant"]["id"] for d in (comparaisons or {}).values()}
    retenus = [
        r for r in results
        if not r.get("slot") or r["id"] in ids_gagnants
    ]
    ecartes = [r for r in results if r not in retenus]

    buy_now = [r for r in retenus if r["analysis"]["advice"] == "ACHETER"]
    wait = [r for r in retenus if r["analysis"]["advice"] == "ATTENDRE"]
    to_check = [r for r in retenus if r["analysis"]["advice"] == "A VERIFIER"]
    neutral = [r for r in retenus if r["analysis"]["advice"] in ("CORRECT", "NEUTRE")]

    total = sum(r["analysis"]["current"] for r in retenus)
    total_at_low = sum(r["analysis"]["effective_low"] for r in retenus)
    potential_saving = total - total_at_low

    target = (budget or {}).get("target_total")
    maximum = (budget or {}).get("max_total")

    if target and total <= target:
        budget_status = ("ok", f"Total sous votre objectif de {target} EUR.")
    elif maximum and total <= maximum:
        budget_status = ("warn", f"Au-dessus de l'objectif ({target} EUR) mais sous le plafond ({maximum} EUR).")
    elif maximum:
        budget_status = ("over", f"Depasse le plafond de {maximum} EUR de {total - maximum:.2f} EUR.")
    else:
        budget_status = ("none", "")

    # --- Strategie globale ---
    # Une occasion ultime prime sur tout le reste : c'est le seul cas ou
    # l'outil vous dit "arretez ce que vous faites et allez voir".
    if ultimes:
        strategy = "OCCASION ULTIME"
        noms = ", ".join(r["name"] for r in ultimes)
        rationale = (
            f"ALERTE : {noms} "
            f"{'est' if len(ultimes) == 1 else 'sont'} a un prix exceptionnel, "
            "en dessous de tout ce qui a ete observe jusqu'ici. "
            "Ce type de prix ne dure generalement pas : verifiez et commandez vite si cela vous convient."
        )
        if any(r["analysis"]["prix_suspect"] for r in ultimes):
            rationale += (
                " Attention toutefois : l'ecart est si important qu'il peut s'agir "
                "d'une erreur d'affichage (commande annulable par le marchand) ou "
                "d'un vendeur tiers peu fiable. Verifiez le vendeur avant de payer."
            )
    elif len(buy_now) >= len(retenus) * 0.6:
        strategy = "ACHETER MAINTENANT"
        rationale = (
            f"{len(buy_now)} composants sur {len(retenus)} sont au plus bas ou tres proches. "
            "Configuration globalement bien positionnee : c'est un bon moment pour commander."
        )
    elif len(wait) >= len(retenus) * 0.5:
        strategy = "PATIENTER"
        rationale = (
            f"{len(wait)} composants sont au-dessus de leur prix habituel. "
            "Attendre quelques jours a quelques semaines devrait ameliorer le total."
        )
    elif buy_now:
        strategy = "ACHAT ECHELONNE"
        rationale = (
            f"Prenez maintenant les {len(buy_now)} composant(s) au plus bas, "
            f"et laissez venir les {len(wait)} autre(s). Le materiel PC ne se perime pas : "
            "acheter en plusieurs fois est parfaitement viable."
        )
    else:
        strategy = "OBSERVER"
        rationale = "Aucun signal fort aujourd'hui. Laissez tourner le suivi quelques jours de plus."

    if to_check:
        rationale += (
            f" Attention : {len(to_check)} composant(s) reposent sur des prix non reverifies "
            "recemment (issus de l'historique importe) : lancez une verification reelle avant de commander."
        )
    if next_event and next_event["days_until"] <= 30:
        rationale += (
            f" A noter : {next_event['name']} commence dans {next_event['days_until']} jours "
            f"(-{next_event['typical_drop']}% typiques)."
        )
    if ongoing:
        rationale += f" Periode promo en cours : {ongoing['name']} ({ongoing['days_left']} j restants)."

    return {
        "strategy": strategy,
        "rationale": rationale,
        "ultimes": ultimes,
        "retenus": retenus,
        "ecartes": ecartes,
        "buy_now": buy_now,
        "wait": wait,
        "to_check": to_check,
        "neutral": neutral,
        "total": total,
        "total_at_low": total_at_low,
        "potential_saving": potential_saving,
        "budget_status": budget_status,
        # --- Vague 7 : sequence optimisee, EN PLUS du plan ci-dessus ---
        # Les cles precedentes sont inchangees : build_report continue de les
        # consommer sans rien savoir de cette addition.
        "sequence": optimiser_sequence(retenus, budget, pression,
                                       history, config),
    }


