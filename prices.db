# ---------------------------------------------------------------------------
# COMPATIBILITE CROISEE — roadmap 1.2
# ---------------------------------------------------------------------------
# Verifie que la configuration retenue tient debout : socket, type de RAM,
# longueur de carte graphique, puissance d'alimentation, hauteur de ventirad,
# format de carte mere. Sans ce controle, le systeme pourrait recommander un
# "meilleur achat" qui ne rentre pas dans le boitier ou ne demarre pas.
# ---------------------------------------------------------------------------

def _spec(config, cid, cle, defaut=None):
    for c in config["components"]:
        if c["id"] == cid:
            return (c.get("specs") or {}).get(cle, defaut)
    return defaut


def _nom(config, cid):
    for c in config["components"]:
        if c["id"] == cid:
            return c["name"]
    return cid


def verifier_compatibilite(config, ids_retenus, marge_alim=30):
    """
    Retourne une liste de problemes : chacun avec un niveau
    ("bloquant" ou "attention"), un message et les composants concernes.
    """
    problemes = []
    retenus = [c for c in config["components"] if c["id"] in ids_retenus]

    def par_categorie(cat):
        return [c for c in retenus if c["category"].lower() == cat.lower()]

    cpus = par_categorie("CPU")
    cms = par_categorie("Carte mere")
    gpus = par_categorie("GPU")
    boitiers = par_categorie("Boitier")
    alims = par_categorie("Alimentation")
    rams = par_categorie("RAM")
    ventirads = par_categorie("Ventirad")

    cm = cms[0] if cms else None
    boitier = boitiers[0] if boitiers else None
    alim = alims[0] if alims else None

    # --- 1. Socket CPU / carte mere ---
    if cpus and cm:
        sock_cm = (cm.get("specs") or {}).get("socket")
        for cpu in cpus:
            sock_cpu = (cpu.get("specs") or {}).get("socket")
            if sock_cpu and sock_cm and sock_cpu != sock_cm:
                problemes.append({
                    "niveau": "bloquant",
                    "message": (f"{cpu['name']} est en socket {sock_cpu}, "
                                f"incompatible avec {cm['name']} ({sock_cm})."),
                    "solution": "Changez de carte mere ou choisissez un CPU du bon socket.",
                })

    # --- 2. Type de RAM ---
    if rams and cm:
        type_cm = (cm.get("specs") or {}).get("type_ram")
        for ram in rams:
            type_ram = (ram.get("specs") or {}).get("type_ram")
            if type_ram and type_cm and type_ram != type_cm:
                problemes.append({
                    "niveau": "bloquant",
                    "message": (f"{ram['name']} est en {type_ram}, "
                                f"la carte mere attend de la {type_cm}."),
                    "solution": f"Prenez un kit {type_cm}.",
                })

    # --- 3. Format carte mere / boitier ---
    if cm and boitier:
        fmt = (cm.get("specs") or {}).get("format")
        acceptes = (boitier.get("specs") or {}).get("formats_acceptes") or []
        if fmt and acceptes and fmt not in acceptes:
            problemes.append({
                "niveau": "bloquant",
                "message": (f"Carte mere au format {fmt}, le boitier "
                            f"{boitier['name']} accepte : {', '.join(acceptes)}."),
                "solution": "Changez de boitier ou de format de carte mere.",
            })

    # --- 4. Longueur GPU / boitier ---
    if gpus and boitier:
        max_gpu = (boitier.get("specs") or {}).get("gpu_max_mm")
        for gpu in gpus:
            lg = (gpu.get("specs") or {}).get("longueur_mm")
            if lg and max_gpu and lg > max_gpu:
                problemes.append({
                    "niveau": "bloquant",
                    "message": (f"{gpu['name']} mesure {lg} mm, le boitier "
                                f"accepte {max_gpu} mm maximum."),
                    "solution": "Choisissez un modele plus court ou un boitier plus grand.",
                })

    # --- 5. Hauteur ventirad / boitier + socket ---
    if ventirads and boitier:
        max_h = (boitier.get("specs") or {}).get("ventirad_max_mm")
        for v in ventirads:
            h = (v.get("specs") or {}).get("hauteur_mm")
            if h and max_h and h > max_h:
                problemes.append({
                    "niveau": "bloquant",
                    "message": (f"{v['name']} mesure {h} mm de haut, "
                                f"le boitier accepte {max_h} mm."),
                    "solution": "Prenez un ventirad plus bas ou un watercooling AIO.",
                })
    if ventirads and cpus:
        for v in ventirads:
            sockets_v = (v.get("specs") or {}).get("sockets") or []
            tdp_max = (v.get("specs") or {}).get("tdp_max")
            for cpu in cpus:
                sock = (cpu.get("specs") or {}).get("socket")
                tdp = (cpu.get("specs") or {}).get("tdp")
                if sockets_v and sock and sock not in sockets_v:
                    problemes.append({
                        "niveau": "bloquant",
                        "message": (f"{v['name']} ne supporte pas le socket {sock} "
                                    f"(compatible : {', '.join(sockets_v)})."),
                        "solution": "Verifiez le kit de fixation ou changez de ventirad.",
                    })
                if tdp_max and tdp and tdp > tdp_max:
                    problemes.append({
                        "niveau": "attention",
                        "message": (f"{v['name']} est donne pour {tdp_max} W, "
                                    f"{cpu['name']} dissipe {tdp} W."),
                        "solution": "Refroidissement possiblement juste sous charge prolongee.",
                    })

    # --- 6. Puissance d'alimentation ---
    if alim:
        watts = (alim.get("specs") or {}).get("watts")
        if watts:
            tdp_cpu = max([(c.get("specs") or {}).get("tdp", 0) for c in cpus] or [0])
            for gpu in gpus:
                tdp_gpu = (gpu.get("specs") or {}).get("tdp", 0)
                reco = (gpu.get("specs") or {}).get("alim_recommandee")
                # Consommation systeme estimee : CPU + GPU + ~80 W pour le reste
                besoin = tdp_cpu + tdp_gpu + 80
                besoin_avec_marge = besoin * (1 + marge_alim / 100)

                if watts < besoin_avec_marge:
                    niveau = "bloquant" if watts < besoin else "attention"
                    problemes.append({
                        "niveau": niveau,
                        "message": (f"Alimentation {watts} W pour {gpu['name']} + CPU : "
                                    f"besoin estime {besoin:.0f} W, "
                                    f"soit {besoin_avec_marge:.0f} W avec {marge_alim}% de marge."),
                        "solution": f"Visez au moins {besoin_avec_marge:.0f} W.",
                    })
                elif reco and watts < reco:
                    problemes.append({
                        "niveau": "attention",
                        "message": (f"Le fabricant de {gpu['name']} recommande "
                                    f"{reco} W, vous avez {watts} W."),
                        "solution": "Fonctionne en general, mais sans marge pour un futur upgrade.",
                    })

    return problemes


def build_compatibilite_html(problemes):
    if not problemes:
        return """
        <div style="background:#eafaf1;border-left:4px solid #1e8449;padding:10px 16px;margin:16px 0;">
          <b style="font-size:13px;color:#1e8449;">Configuration compatible</b>
          <div style="font-size:11px;color:#666;margin-top:2px;">
            Socket, RAM, alimentation, dimensions : aucun conflit detecte.
          </div>
        </div>"""

    bloquants = [p for p in problemes if p["niveau"] == "bloquant"]
    attentions = [p for p in problemes if p["niveau"] == "attention"]

    def bloc(liste, couleur, titre):
        if not liste:
            return ""
        items = "".join(
            f"<li style='margin:4px 0;'>{p['message']}"
            f"<br><span style='font-size:11px;color:#777;'>{p['solution']}</span></li>"
            for p in liste
        )
        return (f"<b style='font-size:13px;color:{couleur};'>{titre}</b>"
                f"<ul style='margin:6px 0 10px 0;padding-left:18px;font-size:12px;'>{items}</ul>")

    couleur_bord = "#c0392b" if bloquants else "#e67e22"
    fond = "#fdedec" if bloquants else "#fef5e7"

    return f"""
    <div style="background:{fond};border-left:4px solid {couleur_bord};padding:12px 16px;margin:16px 0;">
      {bloc(bloquants, '#c0392b', 'Incompatibilites bloquantes')}
      {bloc(attentions, '#b9770e', 'Points de vigilance')}
    </div>"""


def detecter_fausse_promo(entries, current, seuil_gonflage=5):
    """
    Roadmap 6.1 : detecteur de fausses promotions.

    Le schema classique du Black Friday : le prix est monte discretement 2 a
    3 semaines avant, puis "baisse" avec une grosse etiquette rouge. Resultat
    net : vous payez le prix habituel en croyant faire une affaire.

    Methode : on compare trois fenetres.
      - reference  : entre 60 et 30 jours avant (prix "normal" de fond)
      - gonflage   : entre 21 et 3 jours avant (periode de montee suspecte)
      - aujourd'hui

    Verdict "fausse promo" si le prix a monte pendant la fenetre de gonflage
    ET que le prix actuel, malgre la "baisse", n'est pas meilleur que le prix
    de reference.
    """
    today = datetime.now().date()

    def fenetre(debut_j, fin_j):
        d1 = (today - timedelta(days=debut_j)).isoformat()
        d2 = (today - timedelta(days=fin_j)).isoformat()
        return [e["price"] for e in entries if d1 <= e["date"] <= d2]

    reference = fenetre(60, 30)
    gonflage = fenetre(21, 3)

    # Sans profondeur d'historique, on ne peut rien affirmer.
    if len(reference) < 2 or len(gonflage) < 2:
        return None

    med_ref = statistics.median(reference)
    med_gonf = statistics.median(gonflage)
    if med_ref <= 0:
        return None

    hausse_pct = (med_gonf - med_ref) / med_ref * 100
    if hausse_pct < seuil_gonflage:
        return None                      # pas de gonflage detecte

    # Le prix a bien monte. La "baisse" actuelle est-elle reelle ?
    vs_reference_pct = (current - med_ref) / med_ref * 100

    if vs_reference_pct > 1:
        verdict = "fausse"
        message = (
            f"Prix gonfle de {hausse_pct:.0f}% recemment (de {med_ref:.2f} a "
            f"{med_gonf:.2f} EUR), et le prix actuel reste {vs_reference_pct:.0f}% "
            f"au-dessus du prix habituel d'il y a un mois."
        )
    elif vs_reference_pct > -3:
        verdict = "neutre"
        message = (
            f"Le prix avait monte de {hausse_pct:.0f}% avant cette baisse : "
            f"vous revenez simplement au prix habituel ({med_ref:.2f} EUR)."
        )
    else:
        verdict = "reelle"
        message = (
            f"Baisse reelle : {abs(vs_reference_pct):.0f}% sous le prix habituel "
            f"d'il y a un mois, malgre une hausse intermediaire."
        )

    return {
        "verdict": verdict,
        "message": message,
        "med_reference": round(med_ref, 2),
        "med_gonflage": round(med_gonf, 2),
        "hausse_pct": round(hausse_pct, 1),
    }


def evenements_produits(config):
    """
    Roadmap 6.3 : calendrier des evenements produits.

    Les prix GPU/CPU reagissent bien plus aux annonces produit qu'aux
    periodes commerciales. Ce calendrier est edite a la main dans
    config.json : c'est vous qui savez ce qui se prepare.
    """
    today = datetime.now().date()
    a_venir = []

    for ev in (config.get("evenements_produits") or []):
        try:
            d = datetime.strptime(ev["date"], "%Y-%m-%d").date()
        except (ValueError, KeyError):
            continue
        jours = (d - today).days
        if -14 <= jours <= 120:
            a_venir.append({**ev, "jours": jours, "date_obj": d})

    a_venir.sort(key=lambda e: e["jours"])
    return a_venir


# ---------------------------------------------------------------------------
# DETECTION DE SELECTEUR CASSE (Axe 3, prompt 8.2)
# ---------------------------------------------------------------------------

# Repertoire des snapshots (prompt 8.4). Le present module s'en sert QUAND ils
# existent, et fonctionne sans : la detection repose sur les compteurs, la
# proposition de selecteur sur le HTML.
SNAPSHOTS_DIR = BASE_DIR / "snapshots"

# Seuil de detection : 2 jours consecutifs = 48 h, la cible fixee par la
# feuille de route (Axe 3).
JOURS_SELECTEUR_CASSE = 2


# --- Snapshots de diagnostic (Axe 3, prompt 8.4) ---------------------------

# Au-dela, un snapshot ne sert plus a diagnostiquer : le site a change dix
# fois entre-temps.
SNAPSHOT_RETENTION_JOURS = 30
# Un snapshot doit tenir dans un email ou un artefact, pas archiver le web.
SNAPSHOT_TAILLE_MAX = 200_000


def alleger_page(html, taille_max=SNAPSHOT_TAILLE_MAX):
    """
    Reduit une page a ce qui sert au diagnostic d'extraction.

    Une fiche produit pese des centaines de Ko dont 95% de mise en page, de
    scripts et de suggestions. Pour comprendre pourquoi le prix n'a pas ete
    trouve, il suffit de deux choses :

      1. les blocs de donnees structurees (JSON-LD) -- s'ils existent, le
         probleme vient de leur contenu, pas de leur absence ;
      2. sinon, le HTML AUTOUR des motifs de prix : c'est la que se trouve
         le selecteur a corriger.

    Retourne du HTML valide, autonome, lisible dans un navigateur.
    """
    if not html:
        return ""
    try:
        soup = BeautifulSoup(html, "html.parser")
    except Exception:
        return html[:taille_max]

    morceaux = []

    titre = soup.find("title")
    if titre:
        morceaux.append(f"<h2>{titre.get_text(strip=True)[:200]}</h2>")

    # 1. Donnees structurees, telles quelles.
    scripts = soup.find_all("script", type="application/ld+json")
    for s in scripts[:5]:
        contenu = (s.string or s.get_text() or "")[:20_000]
        morceaux.append(
            '<section><h3>JSON-LD</h3><pre>'
            + contenu.replace("<", "&lt;") + "</pre></section>")

    # 2. A defaut (ou en complement), le voisinage des motifs de prix.
    motifs = ("pric", "prix", "tarif", "montant", "amount", "cost")
    vus, blocs = set(), []
    for el in soup.find_all(True):
        attrs = " ".join(
            [" ".join(el.get("class") or []), el.get("id") or ""]).lower()
        if not any(m in attrs for m in motifs):
            continue
        # Le parent porte le contexte utile pour reconstruire un selecteur.
        cible = el.parent if el.parent and el.parent.name not in ("body", "html") else el
        rendu = str(cible)[:4_000]
        if rendu in vus:
            continue
        vus.add(rendu)
        blocs.append(rendu)
        if len(blocs) >= 15:
            break
    if blocs:
        morceaux.append("<section><h3>Voisinage des motifs de prix</h3>"
                        + "\n".join(blocs) + "</section>")

    # 3. Filet : si rien n'a ete retenu, on garde un extrait du corps.
    if len(morceaux) <= 1:
        corps = soup.find("body") or soup
        morceaux.append("<section><h3>Extrait du corps</h3><pre>"
                        + corps.get_text(" ", strip=True)[:5_000].replace("<", "&lt;")
                        + "</pre></section>")

    page = ("<!doctype html><html><head><meta charset=\"utf-8\">"
            "<title>Snapshot de diagnostic</title></head><body>"
            + "\n".join(morceaux) + "</body></html>")
    return page[:taille_max]


def enregistrer_snapshot(html, site, composant_id=None, motif=None):
    """
    Depose une page allegee dans snapshots/, horodatee et nommee par
    site + composant.

    Appele quand la cascade a epuise tous ses paliers sans obtenir de prix :
    c'est precisement le moment ou l'on voudra comprendre, plus tard et hors
    ligne, ce que la page contenait.

    Le nom respecte le contrat de `charger_snapshot` (prompt 8.2) :
    il commence par le nom du site.
    """
    if not html:
        return None
    try:
        SNAPSHOTS_DIR.mkdir(exist_ok=True)
        horodatage = datetime.now().strftime("%Y%m%d-%H%M%S")
        propre = re.sub(r"[^A-Za-z0-9._-]", "_", str(site))
        composant = re.sub(r"[^A-Za-z0-9._-]", "_", str(composant_id or "sans-composant"))
        chemin = SNAPSHOTS_DIR / f"{propre}__{composant}__{horodatage}.html"

        entete = (f"<!-- snapshot de diagnostic\n"
                  f"     site      : {site}\n"
                  f"     composant : {composant_id}\n"
                  f"     date      : {datetime.now().isoformat(timespec='seconds')}\n"
                  f"     motif     : {motif or 'aucun prix extrait'}\n"
                  f"     Supprime automatiquement apres "
                  f"{SNAPSHOT_RETENTION_JOURS} jours. -->\n")
        chemin.write_text(entete + alleger_page(html), encoding="utf-8")
        return chemin
    except Exception as e:                        # pragma: no cover (defensif)
        print(f"  [!] snapshot impossible pour {site} : {e}")
        return None


def nettoyer_snapshots(jours=SNAPSHOT_RETENTION_JOURS):
    """
    Supprime les snapshots trop anciens. Appele au debut de chaque execution :
    le dossier ne peut donc pas grossir indefiniment, meme si l'on oublie.
    """
    if not SNAPSHOTS_DIR.exists():
        return 0
    limite = time.time() - jours * 86400
    supprimes = 0
    for fichier in SNAPSHOTS_DIR.glob("*.html"):
        try:
            if fichier.stat().st_mtime < limite:
                fichier.unlink()
                supprimes += 1
        except OSError:
            continue
    return supprimes


class CacheHTTP:
    """
    Adaptateur entre le moteur de recherche et le stockage des validateurs.

    Le moteur ignore tout de SQLite ; il appelle `lire`, `memoriser` et
    `noter_non_modifie`. Toute erreur est absorbee : une panne de cache doit
    degrader la politesse, jamais la collecte.
    """

    def lire(self, url):
        return sqlite_store.lire_cache_http(url) if sqlite_store else None

    def memoriser(self, url, site, etag, last_modified):
        if sqlite_store:
            sqlite_store.memoriser_cache_http(url, site, etag, last_modified)

    def noter_non_modifie(self, url):
        if sqlite_store:
            sqlite_store.memoriser_cache_http(url, modifie=False)


def prix_du_cache(url):
    """Dernier prix connu pour une URL inchangee (reponse 304)."""
    fiche = sqlite_store.lire_cache_http(url) if sqlite_store else None
    if not fiche or fiche.get("dernier_prix") is None:
        return None, None
    return float(fiche["dernier_prix"]), fiche.get("dernier_palier")


def charger_snapshot(site):
    """
    Derniere page enregistree pour un site, si le prompt 8.4 en a depose une.

    Contrat : snapshots/<site>.html (le plus recent). Retourne None en
    l'absence de snapshot -- ce n'est pas une erreur, seulement une
    proposition de selecteur impossible.
    """
    if not SNAPSHOTS_DIR.exists():
        return None
    candidats = sorted(SNAPSHOTS_DIR.glob(f"{site}*.html"),
                       key=lambda p: p.stat().st_mtime, reverse=True)
    if not candidats:
        return None
    try:
        return candidats[0].read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None


def detecter_selecteur_casse(config, jours=JOURS_SELECTEUR_CASSE):
    """
    Distingue deux pannes que `source_health` confondait :

      « aucune reponse »        le site est injoignable (reseau, blocage).
      « selecteur casse »       le site REPOND (HTTP 200) mais ne rend plus
                                aucun prix plausible. C'est la signature
                                d'une refonte du HTML.

    Critere : le site a produit des prix par le passe, puis n'en produit plus
    depuis `jours` jours consecutifs, alors que ses requetes aboutissent
    toujours. Sans l'historique du succes passe, on ne conclut pas : un site
    qui n'a jamais rien donne n'a pas de selecteur « casse ».
    """
    if not sqlite_store or not sqlite_store.est_actif():
        return []

    series = {}
    for ligne in sqlite_store.historique_extraction():
        series.setdefault(ligne["site"], []).append(ligne)

    casses = []
    for site, lignes in series.items():
        lignes.sort(key=lambda l: l["jour"])
        # A-t-il deja fonctionne ?
        succes_passes = [l for l in lignes if (l["prix_obtenus"] or 0) > 0]
        if not succes_passes:
            continue

        # Jours recents consecutifs : repond, mais aucun prix.
        muets = []
        for l in reversed(lignes):
            if (l["requetes_ok"] or 0) > 0 and (l["prix_obtenus"] or 0) == 0:
                muets.append(l)
            else:
                break
        if len(muets) < jours:
            continue

        dernier_succes = succes_passes[-1]
        casses.append({
            "site": site,
            "jours_muets": len(muets),
            "depuis": muets[-1]["jour"],
            "dernier_succes": dernier_succes["jour"],
            "palier_perdu": dernier_succes["palier_dominant"],
            "requetes_recentes": sum(l["requetes_ok"] or 0 for l in muets),
        })

    casses.sort(key=lambda c: -c["jours_muets"])
    return casses


def proposer_selecteur(html, selecteurs_actuels=None, reference=None):
    """
    Propose des selecteurs CSS candidats a partir de la page actuelle.

    On ne les applique JAMAIS automatiquement : un selecteur devine pourrait
    capter un prix barre, un prix d'accessoire ou un montant de livraison.
    La proposition est soumise a validation manuelle -- c'est le seul usage
    honnete d'une heuristique de ce genre.

    Trois pistes, de la plus sure a la moins sure :
      1. donnees structurees non exploitees (JSON-LD Offer, microdonnees) ;
      2. elements dont la classe ou l'id evoque un prix ;
      3. tout element contenant un montant en euros plausible.

    Retourne [{selecteur, prix, motif, confiance}, ...], trie.
    """
    if not html:
        return []
    try:
        soup = BeautifulSoup(html, "html.parser")
    except Exception:
        return []

    actuels = set(selecteurs_actuels or [])
    candidats = []
    vus = set()

    # Bornes larges, volontairement : un site vend des composants de gammes
    # tres differentes. Filtrer par un prix de reference « du site » n'aurait
    # aucun sens -- la mediane d'une carte mere et d'un GPU ne represente ni
    # l'un ni l'autre. On ecarte donc seulement les montants absurdes, et
    # l'humain tranche : c'est tout l'objet d'une proposition a valider.
    plancher, plafond = 5.0, 5000.0
    if reference:
        plafond = max(plafond, float(reference) * 4)

    def _ajouter(selecteur, prix, motif, confiance):
        if not selecteur or selecteur in vus or selecteur in actuels:
            return
        if prix is None or not (plancher <= prix <= plafond):
            return
        vus.add(selecteur)
        candidats.append({"selecteur": selecteur, "prix": prix,
                          "motif": motif, "confiance": confiance})

    # --- 1. Donnees structurees non exploitees ---
    prix_jsonld = extract_price_from_jsonld(soup)
    if prix_jsonld is not None:
        _ajouter('script[type="application/ld+json"]', prix_jsonld,
                 "donnees structurees schema.org presentes mais non utilisees",
                 "haute")
    for el in soup.select('[itemprop="price"]'):
        val = el.get("content") or el.get_text(strip=True)
        _ajouter('[itemprop="price"]', _montant(val),
                 "microdonnees schema.org (itemprop=price)", "haute")

    # --- 2. Classes et identifiants evoquant un prix ---
    # Radicaux plutot que mots entiers : "pricing", "pricebox", "prixTTC"
    # doivent etre reconnus autant que "price".
    motifs = ("pric", "prix", "tarif", "montant", "amount", "cost")
    # Un ancien tarif rature n'est PAS un prix d'achat. On ne l'ecarte pas --
    # il peut etre le seul repere disponible -- mais on le retrograde, pour
    # qu'il n'apparaisse jamais en tete des propositions.
    suspects = ("old", "ancien", "barre", "strike", "was", "regular",
                "initial", "avant", "crossed", "line-through", "promo-avant")

    for el in soup.find_all(True):
        classes = [c for c in (el.get("class") or [])]
        identifiant = el.get("id") or ""
        attrs = " ".join(classes + [identifiant]).lower()
        if not any(m in attrs for m in motifs):
            continue
        montant = _montant(el.get_text(" ", strip=True))
        if montant is None:
            continue

        douteux = any(s in attrs for s in suspects)
        confiance = "faible" if douteux else "moyenne"
        precision = " (ancien tarif ? a verifier)" if douteux else ""

        for cls in classes:
            if any(m in cls.lower() for m in motifs):
                _ajouter(f".{cls}", montant,
                         f"classe evoquant un prix ({cls}){precision}",
                         confiance)
                break
        if identifiant and any(m in identifiant.lower() for m in motifs):
            _ajouter(f"#{identifiant}", montant,
                     f"identifiant evoquant un prix ({identifiant}){precision}",
                     confiance)

    rangs = {"haute": 0, "moyenne": 1, "faible": 2}
    candidats.sort(key=lambda c: (rangs.get(c["confiance"], 9), c["prix"]))
    return candidats[:5]


def _montant(texte):
    """Premier montant decimal d'une chaine, ou None."""
    if not texte:
        return None
    m = re.search(r"(\d[\d\s ]*)[,.](\d{2})", str(texte))
    if not m:
        return None
    try:
        return float(f"{re.sub(r'[^0-9]', '', m.group(1))}.{m.group(2)}")
    except ValueError:
        return None


def diagnostiquer_selecteurs(config, jours=JOURS_SELECTEUR_CASSE):
    """
    Detection + proposition, pretes a afficher.

    La proposition n'est possible que si un snapshot de la page existe
    (prompt 8.4). Sans snapshot, l'alerte reste emise -- savoir qu'un
    selecteur est casse vaut mieux que ne rien savoir.
    """
    selecteurs = config.get("selecteurs_sites", {})
    diagnostics = []

    for casse in detecter_selecteur_casse(config, jours):
        site = casse["site"]
        html = charger_snapshot(site)
        propositions = []
        if html:
            propositions = proposer_selecteur(
                html, selecteurs.get(site), _reference_du_site(config, site))
        diagnostics.append({**casse, "propositions": propositions,
                            "snapshot": bool(html)})
    return diagnostics


def _reference_du_site(config, site):
    """Prix de reference typique des composants suivis sur ce site."""
    prix = []
    for comp in config.get("components", []):
        if any(s.get("site") == site for s in comp.get("sources", [])):
            ref = (comp.get("reference") or {}).get("typical_price")
            if ref:
                prix.append(float(ref))
    return statistics.median(prix) if prix else None


def build_selecteurs_html(diagnostics):
    if not diagnostics:
        return ""
    blocs = []
    for d in diagnostics:
        if d["propositions"]:
            items = "".join(
                f'<li style="margin:2px 0;"><code>{p["selecteur"]}</code> '
                f'&rarr; {p["prix"]:.2f} EUR '
                f'<span style="color:#888;">({p["motif"]}, confiance '
                f'{p["confiance"]})</span></li>'
                for p in d["propositions"])
            suite = (f'<div style="font-size:11px;margin-top:6px;">Candidats '
                     f'a valider a la main :</div>'
                     f'<ul style="margin:4px 0 0 0;padding-left:18px;'
                     f'font-size:11px;color:#555;">{items}</ul>')
        else:
            suite = ('<div style="font-size:11px;color:#888;margin-top:6px;">'
                     'Aucun snapshot disponible pour proposer un candidat.</div>')
        blocs.append(
            f'<li style="margin:8px 0;"><b>{d["site"]}</b> &mdash; repond '
            f'({d["requetes_recentes"]} requete(s) abouties) mais aucun prix '
            f'depuis {d["jours_muets"]} jour(s). Dernier prix obtenu le '
            f'{d["dernier_succes"]}.{suite}</li>')

    return f"""
    <div style="background:#fdf2e9;border-left:4px solid #ca6f1e;padding:12px 16px;margin:16px 0;">
      <b style="font-size:13px;">Selecteur probablement casse</b>
      <p style="margin:6px 0 0 0;font-size:12px;color:#7e5109;">
        Ces sites repondent normalement mais ne livrent plus de prix : c'est la
        signature d'une refonte de leur HTML, pas d'une panne reseau.
      </p>
      <ul style="margin:8px 0 0 0;padding-left:18px;font-size:12px;color:#555;">
        {"".join(blocs)}
      </ul>
      <p style="margin:8px 0 0 0;font-size:10px;color:#999;">
        Aucun selecteur n'est applique automatiquement : un candidat devine
        pourrait capter un prix barre ou un montant de livraison. Validez-le
        avant de l'ajouter a config.json / selecteurs_sites.
      </p>
    </div>"""


def fragilite_cascade(history, config, jours=7):
    """
    Axe 3, point 3 : composants dont TOUTES les sources recentes reposent sur
    le palier le plus bas de la cascade (extraction bornee).

    Un prix obtenu ainsi n'est pas faux, mais rien ne garantit qu'il designe
    LE produit : c'est le plus bas montant plausible d'une page. Un composant
    entierement suivi de cette facon est fragile -- et l'utilisateur doit le
    voir, plutot que de decouvrir apres coup que son « meilleur prix » venait
    d'un encart publicitaire.

    Retourne [{id, nom, sites, releves}, ...]
    """
    limite = (datetime.now().date() - timedelta(days=jours)).isoformat()
    fragiles = []

    for comp in config.get("components", []):
        node = history.get(comp["id"])
        if not node:
            continue
        recents = [e for e in node.get("entries", [])
                   if e["date"] >= limite and e.get("origin") == "tracked"]
        if not recents:
            continue
        # On ne juge que si le palier est connu pour TOUS les releves recents :
        # un palier inconnu (historique anterieur a la cascade) ne prouve rien.
        if any(not e.get("tier") for e in recents):
            continue
        if all(e.get("tier") == TIER_LE_PLUS_BAS for e in recents):
            fragiles.append({
                "id": comp["id"], "nom": comp["name"],
                "sites": sorted({e["site"] for e in recents}),
                "releves": len(recents),
            })

    return fragiles


def build_fragilite_html(fragiles):
    if not fragiles:
        return ""
    palier = PALIERS[TIER_LE_PLUS_BAS]
    items = "".join(
        f'<li style="margin:3px 0;"><b>{f["nom"]}</b> '
        f'<span style="color:#888;">({", ".join(f["sites"])})</span></li>'
        for f in fragiles)
    return f"""
    <div style="background:#fdf2e9;border-left:4px solid #d68910;padding:12px 16px;margin:16px 0;">
      <b style="font-size:13px;">Prix obtenus par le palier le moins sur</b>
      <p style="margin:6px 0 0 0;font-size:12px;color:#7e5109;">
        {len(fragiles)} composant(s) n'ont, ces derniers jours, ete releves que
        par <b>{palier['libelle']}</b> : {palier['note']}
      </p>
      <ul style="margin:8px 0 0 0;padding-left:18px;font-size:12px;color:#555;">
        {items}
      </ul>
      <p style="margin:8px 0 0 0;font-size:10px;color:#999;">
        Pour fiabiliser : ajoutez une URL de fiche produit exposant du JSON-LD,
        ou declarez des selecteurs CSS pour ces sites dans config.json.
      </p>
    </div>"""


def signal_refresh(evenements, categorie, horizon_jours=60, slot=None):
    """
    Vague 7 : lit le calendrier produit comme une ENTREE DE DECISION, plus
    seulement comme un affichage.

    Deux natures d'evenement sont reconnues dans `evenements_produits` :

      "refresh"        une nouvelle generation est annoncee ou fortement
                       rumoree pour cette categorie. La generation actuelle
                       se deprecie typiquement de 15 a 30% dans les semaines
                       qui suivent.
      "aucun_refresh"  silence produit constate : rien n'est attendu. Sert a
                       ANNULER une attente devenue sans objet -- typiquement
                       une succession repoussee.

    Un evenement sans `nature` reste purement informatif : les entrees deja
    presentes dans config.json ne changent donc aucun conseil.

    Preseance : "aucun_refresh" l'emporte sur "refresh" pour une meme
    categorie. C'est une declaration explicite, saisie a la main : si vous
    l'ecrivez, c'est que la rumeur precedente est caduque.

    Retourne le signal retenu, ou None.
    """
    if not evenements:
        return None

    retenus = {"refresh": [], "aucun_refresh": []}
    for ev in evenements:
        nature = (ev.get("nature") or "").strip().lower()
        if nature not in retenus:
            continue                     # entree informative : sans effet
        if categorie not in (ev.get("impact") or []):
            continue
        slots = ev.get("slots")
        if slots and slot and slot not in slots:
            continue
        jours = ev.get("jours")
        if jours is None:
            continue
        # Un refresh ne compte que s'il est devant nous, dans l'horizon suivi.
        # Une declaration de silence reste valable un peu apres sa date.
        if nature == "refresh" and not (0 <= jours <= horizon_jours):
            continue
        if nature == "aucun_refresh" and not (-30 <= jours <= horizon_jours):
            continue
        retenus[nature].append(ev)

    if retenus["aucun_refresh"]:
        ev = min(retenus["aucun_refresh"], key=lambda e: abs(e["jours"]))
        return {"nature": "aucun_refresh", "nom": ev.get("nom", "silence produit"),
                "jours": ev["jours"], "note": ev.get("note"),
                "date": ev.get("date")}

    if retenus["refresh"]:
        ev = min(retenus["refresh"], key=lambda e: e["jours"])
        return {"nature": "refresh", "nom": ev.get("nom", "nouvelle generation"),
                "jours": ev["jours"], "note": ev.get("note"),
                "date": ev.get("date")}

    return None


def build_evenements_html(evenements):
    if not evenements:
        return ""
    items = []
    for ev in evenements:
        if ev["jours"] < 0:
            quand = f"il y a {abs(ev['jours'])} j"
            couleur = "#7f8c8d"
        elif ev["jours"] <= 30:
            quand = f"dans {ev['jours']} j"
            couleur = "#c0392b"
        else:
            quand = f"dans {ev['jours']} j"
            couleur = "#b9770e"
        cats = ", ".join(ev.get("impact", []))
        items.append(
            f"<li style='margin:3px 0;'><b style='color:{couleur};'>{quand}</b> &mdash; "
            f"{ev['nom']}"
            + (f" <span style='color:#888;'>(impact : {cats})</span>" if cats else "")
            + (f"<br><span style='font-size:11px;color:#777;'>{ev['note']}</span>"
               if ev.get("note") else "")
            + "</li>"
        )
    return f"""
    <div style="background:#f4f6f7;border-left:4px solid #5d6d7e;padding:12px 16px;margin:16px 0;">
      <b style="font-size:13px;">Calendrier produits</b>
      <ul style="margin:8px 0 0 0;padding-left:18px;font-size:12px;color:#555;">
        {"".join(items)}
      </ul>
      <p style="margin:8px 0 0 0;font-size:10px;color:#999;">
        Une nouvelle generation fait typiquement baisser la precedente de
        15 a 30% dans les semaines qui suivent. Calendrier a tenir a jour
        dans config.json.
      </p>
    </div>"""


def fiabilite_sites(config, history, jours=30, enregistrer=False,
                    latences=None, prix_plausibles=None):
    """
    Roadmap 4.4 : taux de reussite par site sur la duree.

    Permet de savoir objectivement quelles sources valent la peine d'etre
    interrogees, et lesquelles echouent systematiquement (typiquement les
    marchands qui bloquent les IP de datacenter depuis GitHub Actions).

    Axe 7 -- observabilite historisee : avec `enregistrer=True`, la mesure
    n'est plus seulement calculee a la volee puis perdue, elle est DATEE et
    CONSERVEE dans `mesures_fiabilite`. C'est ce qui permet de repondre a
    « la fiabilite de LDLC s'est-elle degradee ces deux derniers mois ? »
    par une requete plutot que par une supposition.

    `latences` : {site: latence_ms} releve par le moteur de recherche.
    `prix_plausibles` : {site: nb} d'offres pertinentes retenues.
    """
    limite = (datetime.now().date() - timedelta(days=jours)).isoformat()

    # Jours ou une collecte a reellement eu lieu
    jours_collecte = set()
    for node in history.values():
        if isinstance(node, dict):
            for e in node.get("entries", []):
                if e["date"] >= limite and e.get("origin") == "tracked":
                    jours_collecte.add(e["date"])

    if not jours_collecte:
        return []

    # Sites configures (hors placeholders)
    sites_attendus = {}
    for comp in config["components"]:
        for s in comp["sources"]:
            if "REMPLACEZ" in s["url"] or "CHANGEZ" in s["url"]:
                continue
            sites_attendus.setdefault(s["site"], 0)
            sites_attendus[s["site"]] += 1

    stats = []
    for site, nb_produits in sites_attendus.items():
        succes = set()
        for node in history.values():
            if isinstance(node, dict):
                for e in node.get("entries", []):
                    if (e["date"] >= limite and e.get("origin") == "tracked"
                            and e["site"] == site):
                        succes.add(e["date"])
        taux = len(succes) / len(jours_collecte) * 100
        stats.append({
            "site": site,
            "taux": round(taux),
            "produits": nb_produits,
            "jours_ok": len(succes),
            "jours_total": len(jours_collecte),
        })

    stats.sort(key=lambda s: -s["taux"])

    if enregistrer and sqlite_store:
        latences = latences or {}
        plausibles = prix_plausibles or {}
        sqlite_store.enregistrer_mesures_fiabilite(
            [{**s,
              "latence_ms": latences.get(s["site"]),
              "prix_plausibles": plausibles.get(s["site"]),
              "statut": "ok" if s["taux"] >= 40 else "probleme",
              "motif": None if s["taux"] >= 40 else "taux de reussite faible"}
             for s in stats],
            fenetre_jours=jours)

    return stats


def build_fiabilite_html(stats):
    if not stats or len(stats) < 2:
        return ""
    lignes = []
    for s in stats:
        if s["taux"] >= 80:
            couleur, verdict = "#1e8449", "fiable"
        elif s["taux"] >= 40:
            couleur, verdict = "#b9770e", "irregulier"
        else:
            couleur, verdict = "#c0392b", "a retirer"
        lignes.append(f"""
        <tr>
          <td style="padding:4px 8px;font-size:12px;">{s['site']}</td>
          <td style="padding:4px 8px;font-size:11px;color:#888;">{s['produits']} produit(s)</td>
          <td style="padding:4px 8px;text-align:right;">
            <span style="color:{couleur};font-weight:bold;font-size:12px;">{s['taux']}%</span>
            <span style="color:#999;font-size:10px;"> {verdict}</span>
          </td>
        </tr>""")
    return f"""
    <div style="background:#fbfcfc;border:1px solid #e5e8e8;padding:12px 16px;
                margin:16px 0;border-radius:6px;">
      <div style="font-size:11px;color:#888;letter-spacing:1px;margin-bottom:6px;">
        FIABILITE DES SOURCES (30 DERNIERS JOURS)
      </div>
      <table style="width:100%;border-collapse:collapse;">{"".join(lignes)}</table>
      <p style="margin:6px 0 0 0;font-size:10px;color:#999;">
        Un site sous 40% ne repond quasiment jamais : retirez-le ou remplacez-le
        par un comparateur.
      </p>
    </div>"""


def archiver_historique(history, jours_detail=90):
    """
    Roadmap 4.5, revu par la bascule SQLite (6.4) : NE DETRUIT PLUS RIEN.

    Auparavant, passe 90 jours, les releves quotidiens etaient condenses en un
    point hebdomadaire et les autres SUPPRIMES -- pour empecher history.json
    de grossir indefiniment, puisqu'il etait commite a chaque execution.

    Ce compromis n'a plus lieu d'etre : SQLite conserve la granularite
    complete (c'est tout l'interet de l'Axe 1 -- l'historique est le capital du
    projet), et la lecture condensee est desormais une VUE SQL,
    `v_historique_hebdomadaire`, obtenue via
    sqlite_store.historique_hebdomadaire().

    La fonction est conservee (elle est appelee par main) et retourne 0 : plus
    aucun releve n'est supprime. L'historique complet, au-dela de 90 jours,
    reste interrogeable indefiniment.
    """
    return 0


def resoudre_identites(component, annonces, config=None):
    """
    Axe 2 : rattache les annonces collectees pour un composant a une identite
    produit canonique, et memorise le tout.

    Deroulement :
      1. l'identite de reference du composant est deduite des annonces
         (le GTIN, puis le MPN, le plus frequemment observe) ;
      2. chaque annonce est ensuite confrontee a cette reference, ce qui
         donne son niveau de correspondance (3 EAN / 2 MPN / 1 titre / 0) ;
      3. annonces et identites sont ecrites en base.

    C'est l'etape 1 qui fait tout l'interet du procede : une identite
    decouverte chez UN SEUL vendeur valide -- ou invalide -- les annonces de
    tous les autres.

    Retourne la liste des resolutions, triee par niveau decroissant.
    """
    if not IDENTITE or not annonces:
        return []

    ref_gtin, ref_mpn = identite_produit.identite_de_reference(annonces)
    resolutions = []

    for a in annonces:
        res = identite_produit.resoudre(a, component, ref_gtin, ref_mpn)
        res = {**res, "vendeur": a.get("site"), "url": a.get("url", ""),
               "titre": a.get("titre", "")}
        resolutions.append(res)

        if sqlite_store:
            sqlite_store.enregistrer_annonce(
                component["id"], a.get("site"), a.get("url", ""),
                a.get("titre", ""), res.get("gtin"), res.get("mpn"), res)
            if res.get("id_canonique"):
                sqlite_store.enregistrer_identite(
                    res["id_canonique"], component["id"],
                    res.get("gtin"), res.get("mpn"),
                    component.get("name", ""), res["correspondance_level"])

    resolutions.sort(key=lambda r: (-r["correspondance_level"], -r["score"]))
    return resolutions


def fusionner_entries(component, node, niveau_min=2):
    """
    Axe 2, point 3 : renvoie les releves du composant FUSIONNES par identite
    canonique.

    Aux releves deja rattaches au composant s'ajoutent ceux enregistres sous
    un autre composant mais partageant la meme identite canonique. Le
    plancher historique et le prix courant refletent alors le vrai minimum
    tous vendeurs confondus -- et non plus seulement les `sources` listees
    dans la configuration.

    `niveau_min=2` par defaut : seules les correspondances sures (EAN ou MPN)
    elargissent l'historique. Une simple ressemblance de titre ne suffit pas a
    faire entrer un prix etranger dans le calcul du plancher -- ce serait
    rouvrir la porte aux faux positifs que `prix_plausible` ferme.
    """
    entries = list(node.get("entries", []))
    if not sqlite_store or not sqlite_store.est_actif():
        return entries

    # 1) On RETIRE les releves des vendeurs dont l'annonce a ete DEMENTIE
    #    (niveau 0 : EAN divergent, ou titre rejete). Sans cela, la fusion ne
    #    ferait qu'ajouter : un accessoire a 12 EUR passe par prix_plausible
    #    continuerait de fixer le plancher, et l'identite ne servirait a rien.
    #    Un vendeur sans annonce connue n'est jamais ecarte : aucune
    #    information ne permet de le juger, on ne change pas son sort.
    ecartes = sqlite_store.vendeurs_ecartes(component["id"])
    if ecartes:
        entries = [e for e in entries if e["site"] not in ecartes]

    # 2) On AJOUTE les releves partageant l'identite canonique, meme
    #    enregistres sous un autre composant.
    connus = {(e["date"], e["site"], round(float(e["price"]), 2))
              for e in entries}
    ajoutes = 0
    for r in sqlite_store.releves_fusionnes(component["id"], niveau_min):
        if r["produit_id"] == component["id"]:
            continue                       # deja present
        cle = (r["date"], r["site"], round(float(r["price"]), 2))
        if cle in connus:
            continue
        connus.add(cle)
        entries.append({"date": r["date"], "site": r["site"],
                        "price": float(r["price"]),
                        "origin": r.get("origin", "tracked")})
        ajoutes += 1

    if ajoutes:
        entries.sort(key=lambda e: e["date"])
    return entries


def _metriques_collecte(recup):
    """
    Extrait du moteur de recherche, pour chaque site, la latence mediane
    observee et le nombre d'offres pertinentes retenues.

    Ces deux grandeurs completent le taux de reussite : un site peut repondre
    a chaque fois (taux 100%) tout en devenant tres lent, ou en ne renvoyant
    plus aucune offre pertinente. Le taux seul ne le dirait pas.
    """
    latences, plausibles = {}, {}
    if recup is None:
        return latences, plausibles

    # Latences relevees par domaine -> mediane par site.
    for domaine, valeurs in (getattr(recup, "latences", None) or {}).items():
        if valeurs:
            latences[domaine] = round(statistics.median(valeurs), 1)

    # Offres pertinentes retenues, par vendeur.
    for ligne in (getattr(recup, "journal", None) or []):
        nom = ligne.get("vendeur")
        if nom and ligne.get("statut") == "ok":
            plausibles[nom] = plausibles.get(nom, 0) + ligne.get("offres_retenues", 0)

    # Le journal parle en noms de vendeurs, les latences en domaines : on
    # rapproche les deux par correspondance de sous-chaine, sans rien inventer
    # quand aucun rapprochement n'est possible.
    for nom in list(plausibles):
        if nom in latences:
            continue
        cle = next((d for d in latences if nom.split(".")[0] in d), None)
        if cle:
            latences[nom] = latences[cle]

    return latences, plausibles


def condense_hebdomadaire(produit_id=None):
    """
    Lecture condensee (un point par semaine) de l'historique, via la vue SQL.
    Remplace la destruction operee autrefois par archiver_historique.
    """
    if not sqlite_store:
        return []
    return sqlite_store.historique_hebdomadaire(produit_id)


def analyse_couverture(config, seuil=3):
    """
    Verifie combien de marchands sont reellement interroges par composant.

    C'est le point aveugle le plus courant : le systeme ne connait QUE les
    sites listes dans config.json. Un composant suivi sur un seul site peut
    parfaitement etre 40 EUR moins cher ailleurs sans que rien ne le signale.
    """
    faibles = []
    for comp in config["components"]:
        reelles = [s for s in comp["sources"]
                   if "REMPLACEZ" not in s["url"] and "CHANGEZ" not in s["url"]]
        comparateurs = [s for s in reelles if s.get("type") == "comparateur"]
        # Un comparateur couvre des dizaines de marchands : il compte double.
        score = len(reelles) + len(comparateurs)
        if score < seuil:
            faibles.append({
                "nom": comp["name"],
                "n": len(reelles),
                "comparateurs": len(comparateurs),
            })
    return faibles


def build_couverture_html(faibles, seuil=3):
    if not faibles:
        return ""
    items = "".join(
        f"<li><b>{f['nom']}</b> : {f['n']} site(s) surveille(s)"
        f"{' dont ' + str(f['comparateurs']) + ' comparateur' if f['comparateurs'] else ''}</li>"
        for f in faibles
    )
    return f"""
    <div style="background:#fef5e7;border-left:4px solid #e67e22;padding:12px 16px;margin:16px 0;">
      <b style="font-size:13px;">Surveillance incomplete</b>
      <ul style="margin:8px 0 0 0;padding-left:18px;font-size:12px;color:#555;">{items}</ul>
      <p style="margin:8px 0 0 0;font-size:11px;color:#777;">
        Ces composants sont suivis sur trop peu de sites : un prix plus bas
        ailleurs passerait inapercu. Ajoutez des sources (menu option 12) ou
        une URL de comparateur (idealo, prix.net), qui couvre a elle seule
        des dizaines de marchands.
      </p>
    </div>"""


def source_health(config, history, jours=7, enregistrer=False):
    """
    Amelioration 4.1 : sante des sources.

    Detecte les sources qui ne repondent plus. Sans ce controle, un site dont
    l'extraction est cassee donne l'illusion d'un prix stable (on garde le
    dernier connu) alors qu'on n'a simplement plus d'information.

    Axe 7 : avec `enregistrer=True`, les problemes releves sont dates et
    conserves, ce qui permet de savoir DEPUIS QUAND un site est en panne et
    non seulement qu'il l'est aujourd'hui.
    """
    limite = (datetime.now().date() - timedelta(days=jours)).isoformat()
    attendues, vues = {}, {}

    for comp in config["components"]:
        for src in comp["sources"]:
            site = src["site"]
            placeholder = "REMPLACEZ" in src["url"] or "CHANGEZ" in src["url"]
            attendues.setdefault(site, {"total": 0, "placeholders": 0})
            attendues[site]["total"] += 1
            if placeholder:
                attendues[site]["placeholders"] += 1

    for node in history.values():
        for e in node.get("entries", []):
            if e["date"] >= limite and e.get("origin") == "tracked":
                vues[e["site"]] = vues.get(e["site"], 0) + 1

    problemes = []
    for site, info in attendues.items():
        if info["placeholders"] == info["total"]:
            problemes.append((site, "URL non configuree"))
        elif vues.get(site, 0) == 0:
            problemes.append((site, f"aucune reponse depuis {jours} jours"))

    if enregistrer and sqlite_store:
        en_panne = dict(problemes)
        sqlite_store.enregistrer_mesures_fiabilite(
            [{"site": site,
              "taux": 0.0 if site in en_panne else 100.0,
              "jours_ok": 0 if site in en_panne else 1,
              "jours_total": 1,
              "produits": info["total"],
              "prix_plausibles": vues.get(site, 0),
              "latence_ms": None,
              "statut": "probleme" if site in en_panne else "ok",
              "motif": en_panne.get(site)}
             for site, info in attendues.items()],
            fenetre_jours=jours)

    return problemes


def build_health_html(problemes):
    if not problemes:
        return ""
    items = "".join(f"<li><b>{site}</b> : {motif}</li>" for site, motif in problemes)
    return f"""
    <div style="background:#fdedec;border-left:4px solid #e74c3c;padding:12px 16px;margin:16px 0;">
      <b style="font-size:13px;">Sources en panne</b>
      <ul style="margin:8px 0 0 0;padding-left:18px;font-size:12px;color:#555;">{items}</ul>
      <p style="margin:8px 0 0 0;font-size:11px;color:#777;">
        Les prix de ces sources ne sont plus mis a jour : les conseils les concernant
        reposent sur des donnees anciennes.
      </p>
    </div>"""


# ---------------------------------------------------------------------------
# GROUPES D'EQUIVALENCE (slots) — roadmap 1.1
# ---------------------------------------------------------------------------
# Un "slot" regroupe des produits interchangeables pour un meme poste
# (plusieurs cartes graphiques, plusieurs processeurs...). Le systeme calcule
# le cout par point de performance de chacun et designe le meilleur achat du
# moment. Quand deux prix se croisent, la recommandation bascule toute seule.
# ---------------------------------------------------------------------------

def build_slot_comparisons(results, slots_config, history):
    """
    Retourne, pour chaque slot, le classement des candidats par cout/perf,
    plus la detection d'un eventuel changement de recommandation.
    """
    groupes = {}
    for r in results:
        slot = r.get("slot")
        if slot:
            groupes.setdefault(slot, []).append(r)

    comparaisons = {}
    memoire = history.get("_slots_winners", {})

    for slot, candidats in groupes.items():
        classement = []
        for r in candidats:
            a = r["analysis"]
            perf = r.get("perf_index") or 100
            cout_par_perf = a["current"] / perf if perf else None
            classement.append({
                "id": r["id"],
                "name": r["name"],
                "prix": a["current"],
                "site": a["current_site"],
                "perf": perf,
                "cout_par_perf": cout_par_perf,
                "is_stale": a["is_stale"],
                "is_ultimate": a.get("is_ultimate", False),
                "confidence": a["confidence_label"],
            })

        # On ecarte du classement les prix trop anciens : recommander un
        # candidat sur la base d'un prix de 2 mois n'aurait aucun sens.
        fiables = [c for c in classement if not c["is_stale"]]
        base = fiables or classement

        base.sort(key=lambda c: c["cout_par_perf"])
        gagnant = base[0]
        classement.sort(key=lambda c: c["cout_par_perf"])

        # --- Changement de recommandation depuis la derniere fois ? ---
        precedent = memoire.get(slot)
        changement = None
        if precedent and precedent != gagnant["id"]:
            ancien = next((c for c in classement if c["id"] == precedent), None)
            if ancien:
                ecart = ((ancien["cout_par_perf"] - gagnant["cout_par_perf"])
                         / ancien["cout_par_perf"] * 100)
                changement = {
                    "ancien_nom": ancien["name"],
                    "nouveau_nom": gagnant["name"],
                    "gain_pct": round(ecart, 1),
                }

        # --- Economie possible en prenant le gagnant plutot que le pire ---
        if len(base) > 1:
            pire = base[-1]
            ecart_euros = pire["prix"] - gagnant["prix"]
            ecart_perf = gagnant["perf"] - pire["perf"]
        else:
            ecart_euros, ecart_perf = 0, 0

        comparaisons[slot] = {
            "label": (slots_config.get(slot) or {}).get("label", slot),
            "classement": classement,
            "gagnant": gagnant,
            "changement": changement,
            "ecart_euros": ecart_euros,
            "ecart_perf": ecart_perf,
            "candidats_fiables": len(fiables),
        }
        memoire[slot] = gagnant["id"]
        if sqlite_store:                   # ecriture parallele
            sqlite_store.set_slot_winner(slot, gagnant["id"])

    history["_slots_winners"] = memoire
    return comparaisons


def build_slots_html(comparaisons):
    if not comparaisons:
        return ""

    blocs = []
    for slot, data in comparaisons.items():
        lignes = []
        for i, c in enumerate(data["classement"]):
            gagnant = (c["id"] == data["gagnant"]["id"])
            fond = "#eafaf1" if gagnant else "transparent"
            medaille = "<b>&#9733;</b> " if gagnant else f"{i+1}. "
            stale = (' <span style="color:#8e44ad;font-size:10px;">non verifie</span>'
                     if c["is_stale"] else "")
            ultime = (' <span style="background:#c0392b;color:#fff;padding:1px 4px;'
                      'border-radius:3px;font-size:9px;">ULTIME</span>'
                      if c["is_ultimate"] else "")
            lignes.append(f"""
            <tr style="background:{fond};">
              <td style="padding:6px 8px;border-bottom:1px solid #eee;font-size:12px;">
                {medaille}{c['name']}{stale}{ultime}
              </td>
              <td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:right;font-size:12px;">
                {c['prix']:.2f} EUR
              </td>
              <td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:center;font-size:12px;color:#666;">
                {c['perf']}
              </td>
              <td style="padding:6px 8px;border-bottom:1px solid #eee;text-align:right;font-size:12px;
                         font-weight:{'bold' if gagnant else 'normal'};">
                {c['cout_par_perf']:.2f}
              </td>
            </tr>""")

        alerte_changement = ""
        if data["changement"]:
            ch = data["changement"]
            alerte_changement = f"""
            <div style="background:#fef9e7;border-left:3px solid #f1c40f;padding:8px 12px;
                        margin-bottom:8px;font-size:12px;">
              <b>Changement de recommandation</b> : {ch['nouveau_nom']} passe devant
              {ch['ancien_nom']} ({ch['gain_pct']:+.1f}% de mieux au cout/perf).
            </div>"""

        blocs.append(f"""
        <div style="margin-bottom:18px;">
          <div style="font-size:14px;font-weight:bold;margin-bottom:6px;">
            {data['label']} &mdash; meilleur achat : {data['gagnant']['name']}
          </div>
          {alerte_changement}
          <table style="width:100%;border-collapse:collapse;">
            <thead><tr style="background:#f4f6f7;">
              <th style="padding:6px 8px;text-align:left;font-size:11px;">Candidat</th>
              <th style="padding:6px 8px;text-align:right;font-size:11px;">Prix</th>
              <th style="padding:6px 8px;text-align:center;font-size:11px;">Perf</th>
              <th style="padding:6px 8px;text-align:right;font-size:11px;">EUR/pt</th>
            </tr></thead>
            <tbody>{"".join(lignes)}</tbody>
          </table>
        </div>""")

    return f"""
    <div style="background:#fbfcfc;border:1px solid #e5e8e8;padding:14px 16px;
                margin:16px 0;border-radius:6px;">
      <div style="font-size:11px;color:#888;letter-spacing:1px;margin-bottom:10px;">
        COMPARAISON DES EQUIVALENTS
      </div>
      {"".join(blocs)}
      <p style="font-size:10px;color:#999;margin:0;">
        EUR/pt = cout par point de performance : plus c'est bas, meilleur est le
        rapport qualite/prix. Les indices de performance sont des estimations
        ajustables dans config.json selon vos priorites.
      </p>
    </div>"""


def build_weekly_digest(history, config, results):
    """
    Roadmap 3.4 : bilan de la semaine.

    Le rapport quotidien montre le bruit ; le digest montre la tendance de
    fond. Il ne s'affiche que le dimanche, ou sur demande (--digest).
    """
    aujourdhui = datetime.now().date()
    il_y_a_7j = (aujourdhui - timedelta(days=7)).isoformat()

    lignes, hausses, baisses = [], 0, 0
    for r in results:
        cid = r["id"]
        node = history.get(cid)
        if not node:
            continue

        anciens = [e["price"] for e in node["entries"] if e["date"] <= il_y_a_7j]
        if not anciens:
            continue

        avant = anciens[-1]
        maintenant_prix = r["analysis"]["current"]
        if avant <= 0:
            continue

        variation = (maintenant_prix - avant) / avant * 100
        if abs(variation) < 0.5:
            continue

        if variation > 0:
            hausses += 1
        else:
            baisses += 1

        lignes.append({
            "nom": r["name"],
            "avant": avant,
            "apres": maintenant_prix,
            "variation": variation,
        })

    if not lignes:
        return None

    lignes.sort(key=lambda l: l["variation"])
    return {"lignes": lignes, "hausses": hausses, "baisses": baisses}


def build_digest_html(digest):
    if not digest:
        return ""

    lignes = []
    for l in digest["lignes"]:
        couleur = "#c0392b" if l["variation"] > 0 else "#1e8449"
        fleche = "&#9650;" if l["variation"] > 0 else "&#9660;"
        lignes.append(f"""
        <tr>
          <td style="padding:5px 8px;font-size:12px;">{l['nom']}</td>
          <td style="padding:5px 8px;text-align:right;font-size:12px;color:#888;">
            {l['avant']:.2f} &rarr; <b style="color:#2c3e50;">{l['apres']:.2f}</b> EUR
          </td>
          <td style="padding:5px 8px;text-align:right;font-size:12px;color:{couleur};">
            {fleche} {l['variation']:+.1f}%
          </td>
        </tr>""")

    return f"""
    <div style="background:#fbfcfc;border:1px solid #e5e8e8;padding:14px 16px;
                margin:16px 0;border-radius:6px;">
      <div style="font-size:11px;color:#888;letter-spacing:1px;margin-bottom:8px;">
        BILAN DE LA SEMAINE &mdash; {digest['baisses']} baisse(s), {digest['hausses']} hausse(s)
      </div>
      <table style="width:100%;border-collapse:collapse;">{"".join(lignes)}</table>
    </div>"""


def build_one_line_summary(plan, results):
    """Amelioration 3.5 : une phrase qui resume tout, lisible en 2 secondes."""
    if plan.get("ultimes"):
        noms = ", ".join(r["name"] for r in plan["ultimes"])
        return f"OCCASION ULTIME sur {noms} — foncez verifier."
    if plan["buy_now"] and plan["wait"]:
        return (f"Commandez {len(plan['buy_now'])} composant(s) maintenant, "
                f"patientez sur {len(plan['wait'])}.")
    if plan["buy_now"]:
        return f"Bon moment pour commander ({len(plan['buy_now'])} composant(s) au plus bas)."
    if plan["wait"]:
        return f"Patientez : {len(plan['wait'])} composant(s) sont au-dessus de leur prix habituel."
    return "Rien de neuf aujourd'hui, prix stables."


def build_ultimate_banner(plan):
    """Bandeau rouge impossible a manquer en haut de l'email."""
    if not plan.get("ultimes"):
        return ""

    cartes = []
    for r in plan["ultimes"]:
        a = r["analysis"]
        raisons = "".join(
            f'<li style="margin:2px 0;">{txt}</li>' for txt in a["ultimate_reasons"]
        )
        eco = ""
        if a["sous_le_plancher_pct"] > 0:
            gain = a["current"] * a["sous_le_plancher_pct"] / (100 - a["sous_le_plancher_pct"]) if a["sous_le_plancher_pct"] < 100 else 0
            eco = (f'<div style="font-size:13px;margin-top:4px;">'
                   f'Soit <b>{gain:.2f} EUR de moins</b> que le meilleur prix jamais vu.</div>')

        cartes.append(f"""
        <div style="background:#fff;border-radius:6px;padding:14px 16px;margin-top:10px;">
          <div style="font-size:17px;font-weight:bold;color:#c0392b;">{r['name']}</div>
          <div style="font-size:26px;font-weight:bold;margin:4px 0;">
            {a['current']:.2f} EUR
            <span style="font-size:14px;font-weight:normal;color:#666;">
              chez {a['current_site']}
            </span>
          </div>
          {eco}
          <ul style="margin:8px 0 0 0;padding-left:18px;font-size:13px;color:#444;">{raisons}</ul>
        </div>""")

    return f"""
    <div style="background:#c0392b;color:#fff;padding:18px;border-radius:8px;margin-bottom:18px;">
      <div style="font-size:22px;font-weight:bold;letter-spacing:1px;">
        !!! OCCASION ULTIME !!!
      </div>
      <div style="font-size:13px;opacity:0.9;margin-top:2px;">
        Prix jamais vu aussi bas. Ce genre d'offre part vite.
      </div>
      {"".join(cartes)}
    </div>"""


def build_report(results, plan, ongoing, next_event, market_ctx, previous_total,
                 problemes_sources=None, comparaisons=None, digest=None,
                 couverture_faible=None, projet_html="", projet_texte=None,
                 evenements=None, fiabilite=None, compat=None,
                 avertissement=None, fragiles=None, selecteurs_casses=None):
    today_str = datetime.now().strftime("%d/%m/%Y")

    # Mode degrade (Axe 7) : un rapport etabli sur des donnees de secours doit
    # le dire en tete, pas laisser croire que les prix sont ceux du jour.
    degrade_html = ""
    if avertissement:
        degrade_html = (
            '<div style="background:#fdebd0;border-left:5px solid #d68910;'
            'padding:12px 16px;margin:0 0 16px 0;">'
            '<b style="color:#9c640c;">Donnees de secours</b>'
            f'<div style="font-size:13px;color:#7e5109;margin-top:4px;">'
            f'{avertissement}</div></div>')

    delta_html = ""
    if previous_total:
        diff = plan["total"] - previous_total
        if abs(diff) >= 0.01:
            color = "#e74c3c" if diff > 0 else "#2ecc71"
            delta_html = (f'<span style="color:{color};font-weight:bold;">'
                          f'{diff:+.2f} EUR vs dernier releve</span>')

    b_state, b_msg = plan["budget_status"]
    budget_colors = {"ok": "#1e8449", "warn": "#b9770e", "over": "#c0392b", "none": "#707b7c"}

    rows = []
    for r in sorted(results, key=lambda x: -x["analysis"]["score"]):
        a, si = r["analysis"], r["site_intel"]
        color = ADVICE_COLORS[a["advice"]]

        badges = ""
        if a["is_strong_deal"]:
            badges += ' <span style="background:#1e8449;color:#fff;padding:1px 5px;border-radius:3px;font-size:10px;">PLUS BAS</span>'
        elif a["is_deal"]:
            badges += ' <span style="background:#52be80;color:#fff;padding:1px 5px;border-radius:3px;font-size:10px;">BONNE AFFAIRE</span>'
        if a["volatility"] > 8:
            badges += ' <span style="background:#af7ac5;color:#fff;padding:1px 5px;border-radius:3px;font-size:10px;">VOLATIL</span>'
        if a["is_stale"]:
            badges += (f' <span style="background:#8e44ad;color:#fff;padding:1px 5px;'
                       f'border-radius:3px;font-size:10px;">NON VERIFIE {a["days_stale"]}J</span>')

        best_site_html = ""
        if si["best_site"] and si["comparison_days"] > 0:
            wins = si["wins"].get(si["best_site"], 0)
            best_site_html = (f'<br><span style="color:#666;font-size:11px;">Le moins cher : '
                              f'<b>{si["best_site"]}</b> ({wins}/{si["comparison_days"]} comparaisons)</span>')

        seasonal_html = ""
        if a["seasonal_note"]:
            seasonal_html = f'<br><span style="color:#b9770e;font-size:11px;">{a["seasonal_note"]}</span>'

        rows.append(f"""
        <tr>
          <td style="padding:10px 8px;border-bottom:1px solid #eee;vertical-align:top;">
            <b>{r['name']}</b>{badges}<br>
            <span style="color:#888;font-size:11px;">{r['category']} &middot; achete chez {a['current_site']}</span>
            {best_site_html}{seasonal_html}
          </td>
          <td style="padding:10px 8px;border-bottom:1px solid #eee;text-align:right;vertical-align:top;">
            <b style="font-size:16px;">{a['current']:.2f} EUR</b><br>
            <span style="color:#888;font-size:11px;">{TREND_ICONS[a['trend']]} {a['trend_pct']:+.1f}%</span>
          </td>
          <td style="padding:10px 8px;border-bottom:1px solid #eee;text-align:center;vertical-align:top;font-size:11px;color:#555;">
            min {a['effective_low']:.0f} / hab. {a['baseline']:.0f}<br>
            <span style="color:#888;">+{a['vs_low_pct']:.0f}% vs min &middot; {a['data_points']} pts</span>
          </td>
          <td style="padding:10px 8px;border-bottom:1px solid #eee;text-align:center;vertical-align:top;">
            <div style="background:#eee;border-radius:8px;height:6px;width:60px;margin:4px auto;">
              <div style="background:{color};height:6px;border-radius:8px;width:{a['score']}%;"></div>
            </div>
            <span style="font-size:11px;color:#666;">{a['score']}/100</span>
          </td>
          <td style="padding:10px 8px;border-bottom:1px solid #eee;text-align:center;vertical-align:top;">
            <b style="color:{color};">{a['advice']}</b><br>
            <span style="color:#888;font-size:10px;">{a['reasons'][0]}</span>
          </td>
        </tr>""")

    ctx_html = ""
    used_cats = {r["category"] for r in results}
    ctx_items = [f"<li><b>{c}</b> ({v['trend']}) : {v['note']}</li>"
                 for c, v in market_ctx.items() if c in used_cats]
    if ctx_items:
        ctx_html = f"""
        <div style="background:#fdfefe;border:1px solid #e5e8e8;padding:12px 16px;margin:16px 0;border-radius:6px;">
          <b style="font-size:13px;">Contexte marche</b>
          <ul style="margin:8px 0 0 0;padding-left:18px;font-size:12px;color:#555;">{"".join(ctx_items)}</ul>
        </div>"""

    calendar_html = ""
    if ongoing or next_event:
        parts = []
        if ongoing:
            parts.append(f"<b>{ongoing['name']}</b> en cours, encore {ongoing['days_left']} jours "
                         f"(-{ongoing['typical_drop']}% typiques sur : {', '.join(ongoing['best_for'])}).")
        if next_event:
            parts.append(f"Prochain : <b>{next_event['name']}</b> dans {next_event['days_until']} jours "
                         f"(-{next_event['typical_drop']}% typiques sur : {', '.join(next_event['best_for'])}). "
                         f"{next_event['note']}")
        calendar_html = f"""
        <div style="background:#fef9e7;border-left:4px solid #f1c40f;padding:12px 16px;margin:16px 0;">
          <b style="font-size:13px;">Calendrier promo</b>
          <p style="margin:6px 0 0 0;font-size:12px;color:#555;">{"<br>".join(parts)}</p>
        </div>"""

    def component_list(items):
        return "".join(
            f"<li>{i['name']} &mdash; <b>{i['analysis']['current']:.2f} EUR</b> "
            f"chez {i['analysis']['current_site']}</li>" for i in items
        )

    plan_sections = ""
    if plan["buy_now"]:
        plan_sections += f"""
        <div style="margin-top:12px;">
          <b style="color:#1e8449;font-size:13px;">A commander maintenant ({len(plan['buy_now'])})</b>
          <ul style="margin:6px 0 0 0;padding-left:18px;font-size:12px;">{component_list(plan['buy_now'])}</ul>
        </div>"""
    if plan["wait"]:
        plan_sections += f"""
        <div style="margin-top:12px;">
          <b style="color:#b9770e;font-size:13px;">A laisser mûrir ({len(plan['wait'])})</b>
          <ul style="margin:6px 0 0 0;padding-left:18px;font-size:12px;">{component_list(plan['wait'])}</ul>
        </div>"""
    if plan.get("to_check"):
        plan_sections += f"""
        <div style="margin-top:12px;">
          <b style="color:#8e44ad;font-size:13px;">Prix a reverifier ({len(plan['to_check'])})</b>
          <ul style="margin:6px 0 0 0;padding-left:18px;font-size:12px;">{component_list(plan['to_check'])}</ul>
        </div>"""

    html = f"""
    <html><body style="font-family:-apple-system,Arial,sans-serif;color:#2c3e50;max-width:760px;margin:0 auto;padding:8px;">
      <h2 style="margin:0;">Rapport prix PC &mdash; {today_str}</h2>
      <p style="color:#999;margin:4px 0 12px 0;font-size:12px;">Suivi automatique quotidien</p>

      {degrade_html}
      {build_ultimate_banner(plan)}

      <p style="font-size:15px;font-weight:bold;background:#f4f6f7;padding:10px 14px;
                border-radius:6px;margin:0 0 16px 0;">
        {build_one_line_summary(plan, results)}
      </p>

      <table style="width:100%;border-collapse:collapse;margin-bottom:16px;">
        <tr>
          <td style="background:#2c3e50;color:#fff;padding:16px;border-radius:6px 0 0 6px;width:50%;">
            <div style="font-size:11px;opacity:0.7;">TOTAL ACTUEL</div>
            <div style="font-size:26px;font-weight:bold;">{plan['total']:.2f} EUR</div>
            <div style="font-size:12px;margin-top:2px;">{delta_html}</div>
          </td>
          <td style="background:#34495e;color:#fff;padding:16px;border-radius:0 6px 6px 0;">
            <div style="font-size:11px;opacity:0.7;">SI TOUT AU PLUS BAS CONNU</div>
            <div style="font-size:22px;font-weight:bold;">{plan['total_at_low']:.2f} EUR</div>
            <div style="font-size:12px;opacity:0.85;margin-top:2px;">
              economie potentielle : {plan['potential_saving']:.2f} EUR
            </div>
          </td>
        </tr>
      </table>

      {f'<p style="color:{budget_colors[b_state]};font-size:13px;margin:0 0 16px 0;"><b>Budget :</b> {b_msg}</p>' if b_msg else ''}

      <div style="background:#f8f9f9;border-left:4px solid #2c3e50;padding:14px 16px;margin-bottom:8px;">
        <div style="font-size:11px;color:#888;letter-spacing:1px;">STRATEGIE DU JOUR</div>
        <div style="font-size:19px;font-weight:bold;margin:2px 0 6px 0;">{plan['strategy']}</div>
        <div style="font-size:13px;color:#555;">{plan['rationale']}</div>
        {plan_sections}
      </div>

      {build_digest_html(digest)}
      {build_slots_html(comparaisons or {})}
      {build_compatibilite_html(compat if compat is not None else [])}
      {projet_html}
      {build_selecteurs_html(selecteurs_casses or [])}
      {build_fragilite_html(fragiles or [])}
      {build_evenements_html(evenements or [])}
      {build_fiabilite_html(fiabilite or [])}
      {build_couverture_html(couverture_faible or [])}
      {build_health_html(problemes_sources or [])}
      {calendar_html}
      {ctx_html}

      <table style="width:100%;border-collapse:collapse;font-size:13px;margin-top:16px;">
        <thead><tr style="background:#f4f6f7;">
          <th style="padding:8px;text-align:left;">Composant</th>
          <th style="padding:8px;text-align:right;">Prix</th>
          <th style="padding:8px;">Reperes</th>
          <th style="padding:8px;">Score</th>
          <th style="padding:8px;">Conseil</th>
        </tr></thead>
        <tbody>{"".join(rows)}</tbody>
      </table>

      <p style="color:#aaa;font-size:10px;margin-top:20px;line-height:1.5;">
        Score = position du prix dans sa fourchette historique connue (100 = au plus bas).
        Les conseils sont des heuristiques basees sur l'historique disponible, pas des
        predictions. Verifiez toujours le prix et la disponibilite sur le site marchand
        avant de commander.
      </p>
    </body></html>"""

    # --- Version texte ---
    text = [f"RAPPORT PRIX PC - {today_str}", ""]

    if avertissement:
        text.append("!" * 58)
        text.append("  DONNEES DE SECOURS")
        text.append(f"  {avertissement}")
        text.append("!" * 58)
        text.append("")

    if plan.get("ultimes"):
        text.append("*" * 58)
        text.append("***            !!! OCCASION ULTIME !!!                 ***")
        text.append("*" * 58)
        for r in plan["ultimes"]:
            a = r["analysis"]
            text.append(f"  {r['name']}")
            text.append(f"    {a['current']:.2f} EUR chez {a['current_site']}")
            for raison in a["ultimate_reasons"]:
                text.append(f"    - {raison}")
        text.append("*" * 58)
        text.append("")

    text.append(f">> {build_one_line_summary(plan, results)}")

    if digest:
        text.append("")
        text.append(f"--- BILAN DE LA SEMAINE : {digest['baisses']} baisse(s), "
                    f"{digest['hausses']} hausse(s) ---")
        for l in digest["lignes"]:
            fleche = "^" if l["variation"] > 0 else "v"
            text.append(f"  {fleche} {l['nom'][:40]:40} "
                        f"{l['avant']:7.2f} -> {l['apres']:7.2f} EUR ({l['variation']:+.1f}%)")

    if projet_texte:
        text.append("")
        text.extend(projet_texte)

    if comparaisons:
        text.append("")
        text.append("--- MEILLEUR ACHAT PAR POSTE ---")
        for slot, data in comparaisons.items():
            g = data["gagnant"]
            text.append(f"  {data['label']} : {g['name']}")
            text.append(f"    {g['prix']:.2f} EUR chez {g['site']} "
                        f"| perf {g['perf']} | {g['cout_par_perf']:.2f} EUR/pt")
            if data["changement"]:
                ch = data["changement"]
                text.append(f"    /!\\ CHANGEMENT : passe devant {ch['ancien_nom']} "
                            f"({ch['gain_pct']:+.1f}% cout/perf)")
            for c in data["classement"][1:]:
                marq = " (non verifie)" if c["is_stale"] else ""
                text.append(f"      - {c['name']} : {c['prix']:.2f} EUR "
                            f"| {c['cout_par_perf']:.2f} EUR/pt{marq}")
    text += ["",
             f"Total : {plan['total']:.2f} EUR (au plus bas connu : {plan['total_at_low']:.2f} EUR)",
             f"Economie potentielle : {plan['potential_saving']:.2f} EUR",
             "", f"STRATEGIE : {plan['strategy']}", plan["rationale"], ""]
    for r in sorted(results, key=lambda x: -x["analysis"]["score"]):
        a = r["analysis"]
        text.append(f"[{a['advice']:15}] {r['name']}")
        text.append(f"           {a['current']:.2f} EUR chez {a['current_site']} "
                    f"| min {a['effective_low']:.2f} | score {a['score']}/100 "
                    f"| confiance {a['confidence_label']}")
        text.append(f"           {a['reasons'][0]}")
    return html, "\n".join(text)


# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

def resolve_email_config(config):
    """
    Fusionne la configuration email : les variables d'environnement ont
    priorite sur config.json.

    C'est indispensable pour une execution dans GitHub Actions (ou tout autre
    CI) : le fichier config.json est versionne dans le depot, donc il ne doit
    JAMAIS contenir d'adresse ni de mot de passe. Les valeurs viennent alors
    des "secrets" du depot.

    Variables reconnues :
        EMAIL_SENDER, EMAIL_RECIPIENT, EMAIL_APP_PASSWORD,
        SMTP_SERVER, SMTP_PORT, SUBJECT_PREFIX
    """
    base = dict(config.get("email", {}))

    env_map = {
        "sender_email": "EMAIL_SENDER",
        "recipient_email": "EMAIL_RECIPIENT",
        "smtp_server": "SMTP_SERVER",
        "subject_prefix": "SUBJECT_PREFIX",
    }
    for key, env_name in env_map.items():
        value = os.environ.get(env_name)
        if value:
            base[key] = value

    port = os.environ.get("SMTP_PORT")
    if port and port.isdigit():
        base["smtp_port"] = int(port)

    # Valeurs par defaut raisonnables si rien n'est fourni
    base.setdefault("smtp_server", "smtp.gmail.com")
    base.setdefault("smtp_port", 587)
    base.setdefault("subject_prefix", "[PC Tracker]")
    if not base.get("recipient_email"):
        base["recipient_email"] = base.get("sender_email", "")

    return base


# ---------------------------------------------------------------------------
# ALERTE INSTANTANEE (ntfy.sh) — pour ne pas rater une occasion ultime
# ---------------------------------------------------------------------------
# ntfy.sh est un service de notification push gratuit, sans inscription et
# sans compte. Vous choisissez un "topic" (un nom secret), vous vous y
# abonnez depuis l'appli mobile ntfy, et tout message envoye sur ce topic
# arrive instantanement sur votre telephone.
#
# Important : n'importe qui connaissant le nom du topic peut lire vos
# notifications. Choisissez donc un nom impossible a deviner, du type
# "pcprix-k7m2x9qz", et ne le partagez pas.
# ---------------------------------------------------------------------------

def send_push_alert(topic, results_ultimes, total):
    """Envoie une notification push immediate en cas d'occasion ultime."""
    if not topic:
        return False

    lignes = []
    for r in results_ultimes:
        a = r["analysis"]
        marqueur = "!!!" if a["prix_suspect"] else ""
        lignes.append(
            f"{marqueur} {r['name']}\n"
            f"   {a['current']:.2f} EUR chez {a['current_site']}\n"
            f"   {a['ultimate_reasons'][0]}"
        )

    nb = len(results_ultimes)
    titre = ("OCCASION ULTIME !" if nb == 1
             else f"{nb} OCCASIONS ULTIMES !")

    corps = "\n\n".join(lignes)
    corps += f"\n\nTotal config : {total:.2f} EUR"

    # Priorite maximale : la notification passe meme en mode silencieux
    niveau_max = max(r["analysis"]["ultimate_level"] for r in results_ultimes)
    priorite = "urgent" if niveau_max >= 2 else "high"

    try:
        resp = requests.post(
            f"https://ntfy.sh/{topic}",
            data=corps.encode("utf-8"),
            headers={
                "Title": titre.encode("utf-8"),
                "Priority": priorite,
                "Tags": "rotating_light,moneybag",
            },
            timeout=10,
        )
        resp.raise_for_status()
        print(f"  >>> Alerte push envoyee ({nb} occasion(s) ultime(s)).")
        return True
    except requests.RequestException as e:
        print(f"  [!] Echec de l'alerte push : {e}")
        return False


def send_email(html_body, text_body, email_config, strategy, piece_jointe=None):
    password = os.environ.get("EMAIL_APP_PASSWORD")
    if not password:
        sys.exit("Erreur : EMAIL_APP_PASSWORD non definie. Voir .env.example.")

    sender = email_config.get("sender_email", "")
    if not sender or "VOTRE_ADRESSE" in sender:
        sys.exit(
            "Erreur : adresse expediteur non configuree.\n"
            "  - En local : renseignez 'email' dans config.json (ou option 5 du menu).\n"
            "  - Dans GitHub Actions : definissez le secret EMAIL_SENDER."
        )

    msg = MIMEMultipart("alternative")
    # Un objet d'email qui saute aux yeux dans la boite de reception :
    # une occasion ultime ne doit pas se noyer parmi les rapports de routine.
    if strategy == "OCCASION ULTIME":
        msg["Subject"] = (f"!!! OCCASION ULTIME !!! {email_config['subject_prefix']} "
                          f"{datetime.now().strftime('%d/%m')}")
    else:
        msg["Subject"] = (f"{email_config['subject_prefix']} {strategy} - "
                      f"{datetime.now().strftime('%d/%m')}")
    msg["From"] = email_config["sender_email"]
    msg["To"] = email_config["recipient_email"]
    msg.attach(MIMEText(text_body, "plain", "utf-8"))
    msg.attach(MIMEText(html_body, "html", "utf-8"))

    # --- Tableau de bord joint ---
    # Fichier HTML autonome : il s'ouvre depuis la messagerie, sans rien
    # installer ni telecharger. C'est la facon la plus simple de consulter
    # le suivi depuis un poste verrouille.
    if piece_jointe:
        piece = MIMEApplication(piece_jointe.encode("utf-8"), _subtype="html")
        piece.add_header("Content-Disposition", "attachment",
                         filename=f"tableau-de-bord-{datetime.now():%Y-%m-%d}.html")
        msg.attach(piece)

    with smtplib.SMTP(email_config["smtp_server"], email_config["smtp_port"]) as server:
        server.starttls()
        server.login(email_config["sender_email"], password)
        server.send_message(msg)
    print(f"Email envoye a {email_config['recipient_email']}.")


# ---------------------------------------------------------------------------
# Simulation (--dry-run)
# ---------------------------------------------------------------------------

def simulate_sources(component):
    """Genere des prix plausibles autour du prix de reference, pour tester
    la chaine complete sans dependre du reseau."""
    ref = component.get("reference") or {}
    base = ref.get("typical_price") or ref.get("historical_low") or 100
    seed = sum(ord(c) for c in component["id"]) + int(datetime.now().strftime("%Y%m%d"))
    rng = random.Random(seed)
    return [(s["site"], round(base * (1 + rng.uniform(-0.08, 0.12)), 2))
            for s in component["sources"]]


# ---------------------------------------------------------------------------
# Sous-commandes
# ---------------------------------------------------------------------------

def _bilan_moteur(recup, config=None):
    """
    Recapitulatif de la session de recherche, cumule d'un jour sur l'autre
    dans vendeurs_sante.json.

    Sans ce suivi, un vendeur qui renvoie 403 tous les jours reste invisible :
    on croit simplement qu'il n'a jamais le meilleur prix. Au bout de
    plusieurs jours consecutifs sans reponse, le script propose de le retirer.
    """
    par_vendeur = {}
    for ligne in recup.journal:
        nom = ligne.get("vendeur", "?")
        d = par_vendeur.setdefault(nom, {"ok": 0, "ko": 0, "offres": 0,
                                         "motifs": set()})
        if ligne.get("statut") == "ok":
            d["ok"] += 1
            d["offres"] += ligne.get("offres_retenues", 0)
        else:
            d["ko"] += 1
            d["motifs"].add(str(ligne.get("motif", "?")))

    muets = {n: d for n, d in par_vendeur.items() if d["ok"] and not d["offres"]}
    bloques = {n: d for n, d in par_vendeur.items() if d["ko"] and not d["ok"]}

    print("--- Bilan du moteur de recherche ---")
    print(f"  {len(par_vendeur)} vendeurs sollicites, "
          f"{sum(d['offres'] for d in par_vendeur.values())} offres pertinentes retenues.")

    # --- Politesse reseau (8.3) : ce que la retenue a fait economiser ---
    c = getattr(recup, "compteurs", None)
    if c:
        evitees = c["non_modifiees"] + c["cache_local"]
        total = c["requetes"] + c["cache_local"]
        if total:
            print(f"  Politesse : {c['requetes']} requete(s) transmise(s), "
                  f"{c['non_modifiees']} page(s) inchangee(s) (304), "
                  f"{c['cache_local']} servie(s) par le cache de session "
                  f"-> {evitees}/{total} extraction(s) evitee(s) "
                  f"({evitees / total * 100:.0f}%).")
    interdits = getattr(recup, "interdits", None)
    if interdits:
        print("  Ecartes par robots.txt (respecte, non contourne) :")
        for domaine, n in sorted(interdits.items()):
            print(f"    - {domaine} ({n} URL(s))")
    penalises = {d: n for d, n in getattr(recup, "echecs", {}).items() if n}
    if penalises:
        print("  Domaines ralentis par le backoff (echecs consecutifs) :")
        for domaine, n in sorted(penalises.items(), key=lambda kv: -kv[1]):
            print(f"    - {domaine} : {n} echec(s) -> "
                  f"delai porte a {recup._delai_domaine(domaine):.1f} s")
    if bloques:
        print("  Aucune reponse aujourd'hui :")
        for n, d in sorted(bloques.items()):
            print(f"    - {n:16} {', '.join(sorted(d['motifs']))[:60]}")
    if muets:
        print("  Repondent mais ne referencent aucun de vos produits :")
        print(f"    {', '.join(sorted(muets))}")

    # --- Historique cumule ---
    chemin = BASE_DIR / "vendeurs_sante.json"
    sante = load_json(chemin, {})
    aujourdhui = datetime.now().strftime("%Y-%m-%d")
    a_retirer = []

    for nom, d in par_vendeur.items():
        fiche = sante.setdefault(nom, {"jours_sans_reponse": 0,
                                       "jours_sans_offre": 0,
                                       "derniere_offre": None,
                                       "dernier_motif": None})
        if nom in bloques:
            fiche["jours_sans_reponse"] += 1
            fiche["dernier_motif"] = sorted(d["motifs"])[0] if d["motifs"] else "?"
        else:
            fiche["jours_sans_reponse"] = 0
            fiche["dernier_motif"] = None

        if d["offres"]:
            fiche["jours_sans_offre"] = 0
            fiche["derniere_offre"] = aujourdhui
        else:
            fiche["jours_sans_offre"] += 1

        seuil = (config or {}).get("thresholds", {}).get("jours_avant_retrait", 7)
        if fiche["jours_sans_reponse"] >= seuil:
            a_retirer.append((nom, fiche["jours_sans_reponse"],
                              fiche["dernier_motif"]))

    sante["_maj"] = aujourdhui
    # Delais appris : un domaine ayant renvoye 429 sera aborde plus
    # doucement des la prochaine execution.
    if getattr(recup, "delais", None):
        sante["_delais"] = {d: round(v, 1) for d, v in recup.delais.items()}
    save_json(chemin, sante)

    if getattr(recup, "abandons", 0):
        print(f"  [!] {recup.abandons} requete(s) abandonnee(s) : budget de "
              f"temps epuise. Augmentez 'budget_secondes' ou reduisez le "
              f"nombre de vendeurs.")

    if a_retirer:
        print("  A retirer (option 14 du menu) : sans reponse depuis longtemps")
        for nom, jours, motif in sorted(a_retirer):
            print(f"    - {nom:16} {jours} jours consecutifs ({motif})")
    print()


def cmd_verifier_vendeurs(config, config_path, activer=False, produit=None):
    """
    Teste chaque vendeur du catalogue avec une vraie recherche.

    Les marchands ajoutes au catalogue le sont sur la foi d'un modele d'URL
    qui n'a pas ete confirme : un site refond sa recherche et le modele ne
    vaut plus rien. Cette commande tranche par l'experience plutot que par la
    confiance, et n'active que ce qui fonctionne vraiment.
    """
    if not MOTEUR_V3:
        print("moteur_recherche.py est requis pour cette commande.")
        return

    composant = None
    for c in config["components"]:
        if produit is None or c["id"] == produit or produit.lower() in c["name"].lower():
            composant = c
            break
    if composant is None:
        print("Composant introuvable pour le test.")
        return

    terme = composant.get("recherche") or composant["name"]
    print(f"Test du catalogue avec la recherche : \"{terme}\"")
    print(f"Composant de reference : {composant['name']}\n")

    seuils = config.get("thresholds", {})
    recup = moteur_recherche.Recuperateur(
        delai=seuils.get("delai_par_domaine", 2.5),
        budget_secondes=seuils.get("budget_verification", 600))

    tous = [(n, d) for n, d in config["vendeurs"].items()
            if n != "_comment" and d.get("url")]
    tous.sort(key=lambda kv: (kv[1].get("pays", ""), kv[0]))

    resultats = []
    for nom, infos in tous:
        brutes, url = moteur_recherche._charger_offres(recup, nom, infos, terme)
        if not brutes:
            dernier = recup.journal[-1] if recup.journal else {}
            resultats.append((nom, infos, 0, 0, dernier.get("motif", "aucune offre lisible")))
            continue
        retenues = moteur_recherche._filtrer_pour(
            composant, config, brutes, nom, infos, terme, recup)
        resultats.append((nom, infos, len(brutes), len(retenues), None))

    largeur = max(len(n) for n, *_ in resultats) + 1
    valides, muets, casses = [], [], []
    print(f"{'vendeur':{largeur}}{'pays':7}{'offres':>8}{'utiles':>8}  etat")
    print("-" * (largeur + 40))
    for nom, infos, brutes, utiles, motif in resultats:
        if motif:
            etat, cible = f"AUCUNE REPONSE ({motif})", casses
        elif utiles:
            etat, cible = "OK", valides
        else:
            etat, cible = "repond, mais ne trouve pas ce produit", muets
        cible.append(nom)
        print(f"{nom:{largeur}}{infos.get('pays','?'):7}{brutes:>8}{utiles:>8}  {etat}")

    print(f"\n  {len(valides)} exploitables, {len(muets)} sans resultat "
          f"utile, {len(casses)} injoignables.")

    if activer:
        change = 0
        for nom in valides:
            if not config["vendeurs"][nom].get("actif"):
                config["vendeurs"][nom]["actif"] = True
                change += 1
            config["vendeurs"][nom].pop("a_verifier", None)
        for nom in casses:
            if config["vendeurs"][nom].get("a_verifier"):
                config["vendeurs"][nom]["actif"] = False
        save_json(config_path, config)
        print(f"  {change} vendeur(s) active(s) dans config.json.")
    elif valides:
        print("  Relancez avec --activer-valides pour les activer.")

    print("\n  Un vendeur qui repond sans trouver le produit n'est pas "
          "forcement casse :\n  il peut simplement ne pas le referencer. "
          "Retestez avec --produit <id>.")


def cmd_probabilite(config, history, cid=None, horizon=60):
    """
    Axe 4 : frequences historiques de baisse, par composant.

    Rappel affiche a l'ecran, parce qu'il est trop facile de lire ces
    chiffres comme des previsions : ce sont des constats sur le passe
    observe. Aucun ne dit ce qui va se produire.
    """
    if not probabilites:
        print("Module probabilites absent.")
        return

    composants = config["components"]
    if cid:
        composants = [c for c in composants if c["id"] == cid]
        if not composants:
            print(f"Composant '{cid}' introuvable.")
            return

    print("=" * 74)
    print(f"  FREQUENCES HISTORIQUES DE BAISSE  --  horizon {horizon} jours")
    print("=" * 74)
    print("  Statistique DESCRIPTIVE du passe observe : « c'est arrive N fois")
    print("  sur M episodes ». Ce n'est pas une prevision, et rien n'est")
    print("  extrapole au-dela des donnees disponibles.\n")

    estimables = 0
    for comp in composants:
        node = history.get(comp["id"])
        if not node or not node.get("entries"):
            continue

        # L'historique fusionne par identite canonique (6.5) : le vrai
        # minimum tous vendeurs confondus.
        entries = fusionner_entries(comp, node) or node["entries"]
        serie = probabilites.serie_journaliere(entries)
        etendue = probabilites.etendue_observee(serie)

        print(f"  {comp['name']}")
        print(f"    {len(serie)} jour(s) de releve, etendue {etendue} j")

        seuils = probabilites.seuils_candidats(entries, comp.get("reference"))
        if not seuils:
            print("    aucun seuil exploitable\n")
            continue

        for nom, seuil in seuils:
            r = probabilites.probabilite_baisse(entries, seuil, horizon)
            if r["estimable"]:
                estimables += 1
                detail = f"median {r['delai_median']} j" if r["delai_median"] else ""
                print(f"    <= {seuil:8.2f} EUR ({nom:22}) : "
                      f"{r['probabilite']:5.1f}%  n={r['n']:<3} "
                      f"confiance {r['confiance_label']:9} {detail}")
            else:
                print(f"    <= {seuil:8.2f} EUR ({nom:22}) : "
                      f"{r['message']}")
        print()

    if not estimables:
        print("  Aucune estimation possible sur l'historique actuel.")
        print("  C'est le comportement attendu : en dessous de "
              f"{probabilites.SEUIL_ECHANTILLON} episodes independants,")
        print("  aucun pourcentage n'est produit. Les mesures s'accumulent a")
        print("  chaque execution quotidienne.")


def cmd_selecteurs(config):
    """Axe 3 : quels selecteurs semblent casses, et par quoi les remplacer ?"""
    diags = diagnostiquer_selecteurs(config)
    print("=" * 74)
    print("  DIAGNOSTIC DES SELECTEURS")
    print("=" * 74)
    if not diags:
        print("  Aucun selecteur suspect.")
        print(f"  (critere : repond en HTTP mais aucun prix pendant "
              f"{JOURS_SELECTEUR_CASSE} jour(s) consecutifs, apres avoir")
        print("   deja fonctionne)")
        return

    for d in diags:
        print(f"\n  {d['site']} -- SELECTEUR PROBABLEMENT CASSE")
        print(f"    repond toujours ({d['requetes_recentes']} requete(s) "
              f"abouties) mais aucun prix depuis {d['jours_muets']} jour(s)")
        print(f"    dernier prix obtenu le {d['dernier_succes']} "
              f"(palier {d['palier_perdu'] or '?'})")
        if d["propositions"]:
            print("    candidats a valider a la main :")
            for p in d["propositions"]:
                print(f"      {p['selecteur']:36} -> {p['prix']:>9.2f} EUR   "
                      f"[{p['confiance']}] {p['motif']}")
        elif d["snapshot"]:
            print("    snapshot present, mais aucun candidat plausible trouve.")
        else:
            print("    aucun snapshot disponible : proposition impossible.")
            print("    (les snapshots seront produits par le prompt 8.4)")

    print("\n  Aucun selecteur n'est applique automatiquement : un candidat")
    print("  devine pourrait capter un prix barre ou un montant de livraison.")


def cmd_cascade(history, config, cid=None):
    """
    Axe 3 : par quel palier chaque prix a-t-il ete obtenu ?

    C'est le critere du prompt 8.1 : pour n'importe quel prix du rapport, on
    doit pouvoir remonter a sa provenance.
    """
    print("=" * 74)
    print("  CASCADE DE COLLECTE -- provenance des prix")
    print("=" * 74)
    for p in CASCADE:
        marque = "  (non implemente)" if p["tier"] == "api" else ""
        print(f"  {p['rang']}. {p['libelle']:32} confiance {p['confiance']:8}{marque}")
    print()

    composants = config["components"]
    if cid:
        composants = [c for c in composants if c["id"] == cid]
        if not composants:
            print(f"Composant '{cid}' introuvable.")
            return

    inconnus = 0
    for comp in composants:
        node = history.get(comp["id"])
        if not node or not node.get("entries"):
            continue
        derniers = [e for e in node["entries"]
                    if e["date"] == node["entries"][-1]["date"]]
        print(f"  {comp['name']}")
        for e in sorted(derniers, key=lambda x: x["price"]):
            tier = e.get("tier")
            if tier:
                info = PALIERS.get(tier, {})
                etiquette = f"{info.get('libelle', tier)} ({info.get('confiance', '?')})"
            else:
                etiquette = "palier inconnu (releve anterieur a la cascade)"
                inconnus += 1
            print(f"    {e['price']:>9.2f} EUR  {e['site']:16} {etiquette}")
        print()

    if inconnus:
        print(f"  {inconnus} releve(s) sans palier : ils datent d'avant la")
        print("  formalisation de la cascade. Les prochains en porteront un.")

    fragiles = fragilite_cascade(history, config)
    if fragiles:
        print(f"\n  /!\\ {len(fragiles)} composant(s) suivis UNIQUEMENT par le")
        print("      palier le plus bas (extraction bornee) :")
        for f in fragiles:
            print(f"        - {f['nom']} ({', '.join(f['sites'])})")


def cmd_fiabilite(site=None):
    """
    Axe 7 : repond a « ce site s'est-il degrade ? » a partir des mesures
    historisees -- et non d'une impression.

    Compare la moyenne des 30 derniers jours a celle des 30 jours precedents.
    """
    if not sqlite_store or not sqlite_store.est_actif():
        print("Base de donnees indisponible : aucune mesure consultable.")
        return

    lignes = sqlite_store.evolution_fiabilite(site)
    if not lignes:
        print("Aucune mesure enregistree pour l'instant.")
        print("Les mesures s'accumulent a chaque execution reelle "
              "(pas en --report-only).")
        return

    print("=" * 72)
    print("  EVOLUTION DE LA FIABILITE DES SOURCES")
    print("=" * 72)
    print(f"  {'site':16} {'30j':>7} {'30-60j':>8} {'tendance':>10} "
          f"{'latence':>9}  {'mesures':>7}")
    print("  " + "-" * 68)

    for r in lignes:
        t30 = r["taux_30j"]
        t60 = r["taux_30_60j"]
        tend = r["tendance"]
        lat = r["latence_moyenne_ms"]

        if tend is None:
            verdict = "pas de recul"
        elif tend <= -15:
            verdict = "DEGRADE"
        elif tend <= -5:
            verdict = "en baisse"
        elif tend >= 15:
            verdict = "AMELIORE"
        elif tend >= 5:
            verdict = "en hausse"
        else:
            verdict = "stable"

        print(f"  {r['site'][:16]:16} "
              f"{(f'{t30:.0f}%' if t30 is not None else '-'):>7} "
              f"{(f'{t60:.0f}%' if t60 is not None else '-'):>8} "
              f"{(f'{tend:+.0f} pts' if tend is not None else '-'):>10} "
              f"{(f'{lat:.0f} ms' if lat else '-'):>9}  "
              f"{r['nb_mesures']:>7}  {verdict}")

    print()
    print("  Lecture : 'tendance' compare les 30 derniers jours aux 30 jours")
    print("  precedents. Un ecart negatif signale une degradation reelle,")
    print("  mesuree -- pas supposee.")
    print()
    print("  Detail d'un site :  python price_tracker.py --fiabilite ldlc")
    print("  Requete directe  :  SELECT jour, taux FROM mesures_fiabilite")
    print("                      WHERE site='ldlc' ORDER BY jour;")

    if site:
        serie = sqlite_store.historique_fiabilite(site)
        if serie:
            print()
            print(f"  --- Serie complete : {site} ---")
            for p in serie:
                motif = f"  {p['motif']}" if p.get("motif") else ""
                lat = f"  {p['latence_ms']:.0f} ms" if p.get("latence_ms") else ""
                print(f"    {p['jour']}  {p['taux']:>5.0f}%  "
                      f"[{p['statut']}]{lat}{motif}")


def cmd_add_price(config, history_path, history, cid, price, site, when):
    if not any(c["id"] == cid for c in config["components"]):
        sys.exit(f"Composant '{cid}' introuvable. IDs valides : "
                 + ", ".join(c["id"] for c in config["components"]))
    component = next(c for c in config["components"] if c["id"] == cid)
    ensure_component_in_history(history, component)
    add_price_entry(history, cid, float(price), site, when, origin="manuel")
    if sqlite_store:
        sqlite_store.persister(history, config)
    print(f"Ajoute : {component['name']} = {float(price):.2f} EUR chez {site} "
          f"({when or 'aujourd hui'}).")


def cmd_show_history(history, cid):
    if cid not in history:
        sys.exit(f"Aucun historique pour '{cid}'.")
    node = history[cid]
    print(f"\n{node['name']} ({node['category']})\n" + "-" * 60)
    for e in node["entries"]:
        origin = {"seed": "[import]", "manuel": "[saisi] ", "tracked": "[auto]  "}.get(
            e.get("origin", "tracked"), "[auto]  ")
        print(f"  {e['date']}  {origin}  {e['price']:>8.2f} EUR   {e['site']}")
    print(f"\n  {len(node['entries'])} releves au total\n")


# ---------------------------------------------------------------------------
# Programme principal
# ---------------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(description="Suivi de prix PC v2")
    p.add_argument("--no-email", action="store_true", help="Affiche le rapport sans l'envoyer")
    p.add_argument("--dry-run", action="store_true", help="Prix simules, aucune requete reseau")
    p.add_argument("--report-only", action="store_true", help="Rapport depuis l'historique existant")
    p.add_argument("--reset-seed", action="store_true", help="Reimporte les seed_history du config")
    p.add_argument("--digest", action="store_true", help="Force l'affichage du bilan hebdomadaire")
    p.add_argument("--silencieux", action="store_true",
                   help="N'envoie l'email que s'il y a une nouvelle notable (roadmap 3.6)")
    p.add_argument("--add-price", nargs=3, metavar=("ID", "PRIX", "SITE"),
                   help="Saisit manuellement un prix releve ailleurs")
    p.add_argument("--date", help="Date pour --add-price (AAAA-MM-JJ), defaut aujourd hui")
    p.add_argument("--history", metavar="ID", help="Affiche l'historique d'un composant")
    p.add_argument("--verifier-vendeurs", action="store_true",
                   help="Teste chaque vendeur du catalogue par une vraie recherche")
    p.add_argument("--activer-valides", action="store_true",
                   help="Avec --verifier-vendeurs : active ceux qui fonctionnent")
    p.add_argument("--produit", metavar="ID",
                   help="Composant servant de test pour --verifier-vendeurs")
    p.add_argument("--export-history", action="store_true",
                   help="Exporte l'historique SQLite vers history.json (secours)")
    p.add_argument("--fiabilite", nargs="?", const="*", metavar="SITE",
                   help="Evolution de la fiabilite d'un site (ou de tous)")
    # Contrairement a --selecteurs, --cascade, --fiabilite ou --probabilite,
    # qui rendent la main sans rien interroger, --portefeuille et --projet
    # sont des options d'AFFICHAGE greffees sur un cycle complet : seuls,
    # ils declenchent donc une collecte. Le dire ici evite d'attendre
    # plusieurs minutes en croyant consulter.
    p.add_argument("--portefeuille", action="store_true",
                   help="Vue d'ensemble sur tous les projets actifs "
                        "(lance une collecte ; ajoutez --report-only pour "
                        "consulter sans interroger les sites)")
    p.add_argument("--projet", metavar="ID",
                   help="Restreint le rapport a un projet (idem : ajoutez "
                        "--report-only pour ne pas collecter)")
    p.add_argument("--selecteurs", action="store_true",
                   help="Diagnostic des selecteurs casses (+ candidats)")
    p.add_argument("--cascade", nargs="?", const="*", metavar="ID",
                   help="Palier de la cascade ayant produit chaque prix")
    p.add_argument("--probabilite", nargs="?", const="*", metavar="ID",
                   help="Frequences historiques de baisse (descriptif, pas predictif)")
    p.add_argument("--horizon", type=int, default=60,
                   help="Horizon en jours pour --probabilite (defaut 60)")
    args = p.parse_args()

    config = load_config()
    history_path = BASE_DIR / config.get("history_file", "history.json")

    # --- SQLite est la source de verite (bascule 6.4) ---
    # history.json n'est plus lu ni ecrit automatiquement : il devient un
    # export de secours, produit a la demande via --export-history.
    if sqlite_store:
        sqlite_store.configure(BASE_DIR / config.get("sqlite_file", "prices.db"))
    history = sqlite_store.charger_history(config) if sqlite_store else {}

    # --- MODE DEGRADE (Axe 7) ---
    # Base verrouillee, corrompue ou inaccessible : plutot que de planter, on
    # repart du dernier export connu et on le DIT -- dans la console et dans
    # le rapport. Un silence serait pire qu'une panne : on croirait les prix
    # a jour alors qu'ils datent.
    degrade = sqlite_store.etat().get("degrade") if sqlite_store else "module absent"
    avertissement = None
    if degrade:
        secours = load_json(history_path, default={}) if history_path.exists() else {}
        if secours:
            history = secours
            avertissement = (
                f"Base de donnees inutilisable ({degrade}). Rapport etabli sur "
                f"la derniere donnee connue ({history_path.name}) : les prix "
                f"peuvent avoir change depuis.")
        else:
            avertissement = (
                f"Base de donnees inutilisable ({degrade}) et aucun export de "
                f"secours disponible. Le rapport sera vide ou partiel.")
        print(f"\n  [!] {avertissement}\n")

    # Reprise sans perte : au tout premier lancement apres la bascule, la base
    # peut etre vide alors qu'un history.json existe. On l'importe une fois.
    if not history and not degrade and history_path.exists():
        history = load_json(history_path, default={})
        if history and sqlite_store:
            print("Reprise de history.json vers SQLite (une seule fois).")
            sqlite_store.persister(history, config)

    # --- Sous-commandes courtes ---
    if args.selecteurs:
        return cmd_selecteurs(config)
    if args.cascade:
        return cmd_cascade(history, config,
                           None if args.cascade == "*" else args.cascade)
    if args.fiabilite:
        return cmd_fiabilite(None if args.fiabilite == "*" else args.fiabilite)
    if args.probabilite:
        return cmd_probabilite(config, history,
                               None if args.probabilite == "*" else args.probabilite,
                               args.horizon)
    if args.export_history:
        if not sqlite_store:
            sys.exit("Module sqlite_store absent : export impossible.")
        exporte = sqlite_store.exporter_history_json(history_path, config)
        n = sum(len(v.get("entries", [])) for k, v in exporte.items()
                if k != "_slots_winners" and isinstance(v, dict))
        print(f"Export de secours ecrit : {history_path} "
              f"({n} releves, {len(exporte)} entrees).")
        print("Rappel : ce fichier est une photographie, plus la source de "
              "verite (SQLite l'est depuis la bascule 6.4).")
        return
    if args.add_price:
        cid, price, site = args.add_price
        return cmd_add_price(config, history_path, history, cid, price, site, args.date)
    if args.history:
        return cmd_show_history(history, args.history)
    if args.verifier_vendeurs:
        return cmd_verifier_vendeurs(config, BASE_DIR / "config.json",
                                     activer=args.activer_valides,
                                     produit=args.produit)

    thresholds = config.get("thresholds", {})
    market_ctx = config.get("market_context", {})
    # Axe 5 : le perimetre de travail est celui d'UN projet. Avec un seul
    # projet -- le cas historique -- c'est strictement l'ancien comportement.
    projet_courant = projet_actif(config, getattr(args, "projet", None))
    budget = projet_courant.get("budget") or config.get("budget", {})
    synchroniser_projets(config)
    ongoing, next_event = current_and_next_events()

    # --- Import de l'historique preexistant ---
    total_seeded = 0
    for component in config["components"]:
        total_seeded += import_seed_history(history, component, force=args.reset_seed)
    if total_seeded:
        print(f"Historique preexistant importe : {total_seeded} releves.\n")

    # --- Total precedent, pour la variation ---
    previous_total = None
    if history:
        prev = []
        for comp in config["components"]:
            node = history.get(comp["id"])
            if node and len(node["entries"]) >= 2:
                today_iso = datetime.now().strftime("%Y-%m-%d")
                older = [e["price"] for e in node["entries"] if e["date"] != today_iso]
                if older:
                    prev.append(older[-1])
        previous_total = sum(prev) if len(prev) == len(config["components"]) else None

    # --- Collecte des prix du jour ---
    # Declare avant la branche : le bilan de fiabilite le consulte ensuite,
    # y compris en mode --report-only ou aucune collecte n'a lieu.
    recup_session = None
    # Axe 3 : compteurs par site -- requetes abouties vs prix reellement
    # extraits. C'est leur DIVERGENCE qui revele un selecteur casse.
    sante_extraction = {}

    # Axe 5 : UN SEUL cycle de collecte pour TOUS les projets. C'est ici que
    # se joue le cout marginal d'un projet supplementaire.
    a_collecter, partages_identite = produits_a_collecter(config)

    # Menage des snapshots au demarrage : le dossier ne peut pas grossir
    # indefiniment, meme si personne n'y pense.
    _vieux = nettoyer_snapshots()
    if _vieux:
        print(f"Snapshots de diagnostic : {_vieux} fichier(s) de plus de "
              f"{SNAPSHOT_RETENTION_JOURS} jours supprime(s).")
    if not args.report_only:
        print(f"=== Verification - {datetime.now().strftime('%d/%m/%Y %H:%M')} ===\n")

        # Essai a blanc : la base passe en LECTURE SEULE avant la moindre
        # collecte. Les prix de `simulate_sources()` sont inventes ; ecrits
        # dans l'historique, ils y deviendraient indiscernables de vrais
        # releves (origin="tracked") et contamineraient plancher, alerte
        # « occasion ultime » et probabilites de 7.1.
        if args.dry_run and sqlite_store:
            sqlite_store.lecture_seule(True)

        # Partage sur toute la session : les connexions restent ouvertes, une
        # page deja lue n'est pas retelechargee, et le delai par domaine est
        # respecte d'un composant a l'autre.
        offres_groupees = {}
        if MOTEUR_V3 and not args.dry_run:
            seuils = config.get("thresholds", {})
            sante = load_json(BASE_DIR / "vendeurs_sante.json", {})
            recup_session = moteur_recherche.Recuperateur(
                delai=seuils.get("delai_par_domaine", 2.5),
                respecter_robots=seuils.get("respecter_robots", False),
                budget_secondes=seuils.get("budget_secondes") or None,
                delais_appris=(sante.get("_delais") or {}))
            # Politesse reseau (8.3) : le moteur peut desormais demander
            # « as-tu change ? » plutot que de retelecharger.
            if seuils.get("cache_conditionnel", True):
                recup_session.cache_http = CacheHTTP()
            actifs = len(moteur_recherche._vendeurs_actifs(config))
            plafond = config.get("thresholds", {}).get("max_vendeurs_par_composant", 0)
            portee = min(actifs, plafond) if plafond else actifs
            print(f"Moteur v3 : {portee}/{actifs} vendeurs interroges par composant, "
                  f"en parallele.")

            # Recherche mutualisee : les composants d'une meme famille
            # ("RTX 5060 Ti") sont servis par une seule requete par vendeur.
            # Axe 5 : la liste interrogee est l'ensemble DEDUPLIQUE, tous
            # projets confondus -- pas la somme de leurs composants.
            if config.get("vendeurs"):
                offres_groupees = moteur_recherche.rechercher_groupe(
                    a_collecter, config, recup_session)
                print()

        for component in a_collecter:
            print(f"[{component['category']}] {component['name']}")
            annonces = []                      # Axe 2 : identites collectees
            paliers = {}                       # Axe 3 : palier par site
            found = (simulate_sources(component) if args.dry_run
                     else fetch_all_sources(
                         component, config.get("selecteurs_sites"), config,
                         recuperateur=recup_session,
                         offres_pretes=(offres_groupees.get(component["id"], [])
                                        if offres_groupees else None),
                         collecteur=annonces, paliers=paliers,
                         sante=sante_extraction))
            if not found:
                print("  Aucun prix recupere.\n")
                continue

            # --- Identite produit : qui parle bien du meme article ? ---
            if annonces:
                resolutions = resoudre_identites(component, annonces, config)
                srs = [r for r in resolutions if r["correspondance_level"] >= 2]
                if srs:
                    print(f"  Identite : {len(srs)}/{len(resolutions)} annonce(s) "
                          f"confirmee(s) -- {srs[0]['correspondance_label']}")

            ensure_component_in_history(history, component)
            for site, price in found:
                add_price_entry(history, component["id"], price, site,
                                source_tier=paliers.get(site))

            # Axe 5 : les composants partageant l'identite canonique de
            # celui-ci recoivent le MEME releve, sans requete supplementaire.
            for jumeau_id in partages_identite.get(component["id"], []):
                jumeau = next((c for c in config["components"]
                               if c["id"] == jumeau_id), None)
                if not jumeau:
                    continue
                ensure_component_in_history(history, jumeau)
                for site, price in found:
                    add_price_entry(history, jumeau_id, price, site,
                                    source_tier=paliers.get(site))
                print(f"  = {jumeau['name']} : meme produit, prix partage "
                      f"(0 requete)")
            best = min(found, key=lambda x: x[1])
            print(f"  => Meilleur : {best[1]:.2f} EUR chez {best[0]}\n")

        if recup_session is not None:
            _bilan_moteur(recup_session, config)
        if sqlite_store and sante_extraction:
            sqlite_store.enregistrer_sante_extraction(sante_extraction)

        # --dry-run N'ECRIT RIEN dans la source de verite.
        #
        # Les prix de `simulate_sources()` sont inventes. Persistes, ils
        # entraient dans l'historique avec origin="tracked" -- donc
        # indiscernables de vrais releves -- et contaminaient tout ce qui en
        # depend : plancher historique, alerte « occasion ultime »,
        # probabilites de 7.1. Un essai a blanc qui declenche une alerte sur
        # un prix fabrique est pire qu'inutile.
        if args.dry_run:
            print("Essai a blanc : les prix simules ne sont PAS enregistres.\n")
        elif sqlite_store:
            sqlite_store.persister(history, config)
    else:
        print("Mode rapport seul : aucune requete effectuee.\n")

    # --- Analyse ---
    # Calendrier produit : calcule AVANT l'analyse, car il est desormais une
    # entree de decision d'analyze_component (vague 7), plus seulement un
    # bloc d'affichage.
    evenements = evenements_produits(config)

    # Axe 5 : chaque projet actif est analyse separement, sur le MEME
    # historique mutualise. Avec un seul projet -- le cas historique --
    # la boucle ne tourne qu'une fois.
    projets_actifs = [p for p in projets_du_config(config) if p.get("actif", True)]
    if getattr(args, "projet", None):
        projets_actifs = [p for p in projets_actifs if p["id"] == args.projet] \
                         or projets_actifs
    analyses = []
    for p in projets_actifs:
        a = analyser_projet(config, p, history, ongoing, next_event, evenements)
        if a:
            analyses.append(a)

    if not analyses:
        print("Aucune donnee exploitable. Verifiez config.json.")
        return

    # Le projet courant reste celui qui pilote le rapport principal.
    courant = next((a for a in analyses
                    if a["projet"]["id"] == projet_courant["id"]), analyses[0])
    achats = courant["achats"]
    results = courant["results"]
    comparaisons = courant["comparaisons"]
    pression = courant["pression"]
    plan = courant["plan"]
    compat = courant["compat"]

    supprimees = archiver_historique(
        history, config.get('thresholds', {}).get('archivage_jours', 90))
    if supprimees:
        print(f"  Historique condense : {supprimees} releves anciens regroupes.")
    if sqlite_store:
        sqlite_store.persister(history, config)   # memorise les gagnants de slot
    if compat:
        bloq = [p for p in compat if p['niveau'] == 'bloquant']
        print(f"\n  Compatibilite : {len(bloq)} bloquant(s), "
              f"{len(compat) - len(bloq)} vigilance(s)")
        for pb in compat:
            marque = '[X]' if pb['niveau'] == 'bloquant' else '[!]'
            print(f"    {marque} {pb['message']}")
    # (`evenements` est calcule plus haut : il alimente desormais la decision)
    # Axe 7 : les mesures de fiabilite sont datees et conservees a chaque
    # execution, pas seulement calculees puis oubliees. On ne les enregistre
    # que lors d'une vraie collecte (--report-only ne mesure rien de neuf).
    _lat, _plaus = _metriques_collecte(recup_session if not args.report_only else None)
    _tracer = not args.report_only
    fiabilite = fiabilite_sites(config, history, enregistrer=_tracer,
                                latences=_lat, prix_plausibles=_plaus)
    problemes = source_health(config, history, enregistrer=_tracer)
    seuil_couv = config.get('thresholds', {}).get('couverture_min_sources', 3)
    couverture_faible = analyse_couverture(config, seuil_couv)
    if couverture_faible:
        print(f"\n  Surveillance incomplete sur {len(couverture_faible)} composant(s) :")
        for f in couverture_faible:
            print(f"    - {f['nom']} ({f['n']} site(s))")
    if problemes:
        print("\n  Sources en panne :")
        for site, motif in problemes:
            print(f"    - {site} : {motif}")
    # Bilan hebdo : le dimanche, ou sur demande
    digest = None
    if args.digest or datetime.now().weekday() == 6:
        digest = build_weekly_digest(history, config, results)

    # --- Pilotage du projet (vague 4) ---
    def _projet_texte(bilan, pression, simulation):
        lignes = []
        if bilan:
            lignes.append(f"--- DEJA ACHETE : {bilan['total_paye']:.2f} EUR ---")
            for l in bilan["lignes"]:
                suffixe = (f"(+{l['ecart']:.2f} vs min)" if l["ecart"] > 1
                           else "(au meilleur prix)")
                lignes.append(f"  {l['nom'][:38]:38} {l['prix']:8.2f} EUR "
                              f"le {l['date']} {suffixe}")
        if pression:
            lignes.append(f"--- ECHEANCE {pression['date']} : {pression['message']} ---")
        sequence = plan.get("sequence")
        if sequence and (sequence.get("maintenant") or sequence.get("differes")):
            lignes.append("--- SEQUENCE D'ACHAT CONSEILLEE ---")
            lignes.append(f"  {sequence['explication']}")
            lignes.append(f"  MAINTENANT ({sequence['cout_maintenant']:.2f} EUR) :")
            for i in sequence["maintenant"]:
                pourquoi = (f" -- {i['raisons_blocage'][0]}"
                            if i["raisons_blocage"] else "")
                lignes.append(f"    + {i['nom']} : {i['prix']:.2f} EUR{pourquoi}")
            if sequence["differes"]:
                lignes.append(f"  PLUS TARD (gain espere "
                              f"{sequence['gain_differe']:.2f} EUR) :")
                for i in sequence["differes"]:
                    if i["source_gain"] == "mesure":
                        pourquoi = (f"+{i['gain_attente']:.2f} EUR espere, "
                                    f"mesure sur n={i['n_gain']}")
                    elif i["source_gain"] == "refresh annonce":
                        pourquoi = "nouvelle generation annoncee"
                    else:
                        pourquoi = i["motif"]
                    lignes.append(f"    ~ {i['nom']} : {i['prix']:.2f} EUR "
                                  f"({pourquoi})")
            if sequence.get("depassement"):
                lignes.append(f"  /!\\ Il manque {sequence['depassement']:.2f} EUR "
                              "meme apres arbitrage.")
            lignes.append("")

        if simulation:
            lignes.append(f"--- SI VOUS ATTENDEZ {simulation['evenement'].upper()} "
                          f"({simulation['jours']} j) ---")
            lignes.append(f"  Aujourd'hui : {simulation['total_actuel']:.2f} EUR")
            lignes.append(f"  Projection  : {simulation['total_projete']:.2f} EUR "
                          f"(economie estimee {simulation['economie']:.2f} EUR, "
                          f"methode {simulation.get('methode', 'deterministe')})")
            # Vague 7 : ne jamais fondre les deux methodes en un chiffre unique.
            for d in sorted(simulation.get("detail") or [], key=lambda x: x["methode"]):
                if d["methode"] == "probabiliste":
                    lignes.append(
                        f"    [mesure n={d['n']:<3}] {d['nom']} : "
                        f"{d['economie']:+.2f} EUR "
                        f"(baisse {d['p_baisse']:.0f}% des cas / hausse "
                        f"{d['p_hausse']:.0f}%, confiance {d['confiance_label']})")
                else:
                    lignes.append(
                        f"    [forfait   ] {d['nom']} : {d['economie']:+.2f} EUR "
                        f"({d.get('baisse_pct', 0)}% de categorie -- "
                        f"{d.get('motif', 'historique insuffisant')})")
            if simulation.get("nb_deterministes"):
                lignes.append("    (les lignes [forfait] sont indicatives : "
                              "baisse moyenne de categorie, pas une mesure)")
            if simulation.get("incompatible"):
                lignes.append(f"  /!\\ INCOMPATIBLE : {simulation['incompatible']}")
        return lignes

    bilan = bilan_achats(achats, history, projet_courant["id"])
    # (`pression` est deja calculee plus haut : elle contraint l'optimiseur)
    ids_retenus = {r['id'] for r in plan['retenus']}
    simulation = simuler_promo(results, next_event, ids_retenus, pression,
                               history=history, config=config)
    projet_html = build_projet_html(bilan, pression, simulation, budget,
                                    sequence=plan.get("sequence"))
    projet_texte = _projet_texte(bilan, pression, simulation)

    html, text = build_report(results, plan, ongoing, next_event, market_ctx,
                              previous_total, problemes, comparaisons, digest,
                              couverture_faible, projet_html, projet_texte,
                              evenements, fiabilite, compat, avertissement,
                              fragilite_cascade(history, config),
                              diagnostiquer_selecteurs(config))

    # --- ALERTE INSTANTANEE : elle part TOUJOURS en cas d'occasion ultime,
    # meme en --no-email, parce que c'est justement ce qu'il ne faut pas rater.
    if plan.get("ultimes"):
        print("\n" + "!" * 60)
        print("!!!  OCCASION ULTIME DETECTEE  !!!")
        for r in plan["ultimes"]:
            a = r["analysis"]
            print(f"!!!  {r['name']} : {a['current']:.2f} EUR chez {a['current_site']}")
            for raison in a["ultimate_reasons"]:
                print(f"!!!    -> {raison}")
        print("!" * 60)

        topic = os.environ.get("NTFY_TOPIC") or config.get("alertes", {}).get("ntfy_topic")
        if topic:
            send_push_alert(topic, plan["ultimes"], plan["total"])

    # --- Tableau de bord autonome (roadmap 3.3) ---
    tableau = None
    try:
        from dashboard import build_dashboard
        tableau = build_dashboard(config, history)
        (BASE_DIR / "dashboard.html").write_text(tableau, encoding="utf-8")
        docs = BASE_DIR / "docs"
        docs.mkdir(exist_ok=True)
        (docs / "index.html").write_text(tableau, encoding="utf-8")
        print("  Tableau de bord genere (dashboard.html).")
    except Exception as e:
        print(f"  [!] Tableau de bord non genere : {e}")

    if args.no_email or args.report_only:
        print("\n" + text)
    else:
        # --- Mode silencieux (roadmap 3.6) ---
        # Un rapport quotidien sans rien de neuf finit par etre ignore.
        # En mode silencieux, l'email ne part que s'il y a matiere : une
        # occasion ultime, un composant a acheter, un changement de
        # recommandation, une source en panne, ou le bilan hebdo.
        notable = bool(
            plan.get("ultimes")
            or plan["buy_now"]
            or any(d["changement"] for d in (comparaisons or {}).values())
            or problemes
            or digest
        )
        if args.silencieux and not notable:
            print("\nMode silencieux : rien de notable aujourd'hui, aucun email envoye.")
        else:
            send_email(html, text, resolve_email_config(config), plan["strategy"], tableau)

    # --- Rapports des AUTRES projets (Axe 5) ---
    # Chaque projet garde son rapport, dans la structure exacte qu'il a
    # toujours eue. Avec un seul projet, cette boucle ne tourne pas.
    for autre in analyses:
        if autre is courant:
            continue
        p = autre["projet"]
        print(f"\n{'=' * 60}\n  PROJET : {p['nom']}\n{'=' * 60}")
        h2, t2 = build_report(
            autre["results"], autre["plan"], ongoing, next_event, market_ctx,
            None, problemes, autre["comparaisons"], None, couverture_faible,
            build_projet_html(
                bilan_achats(autre["achats"], history, p["id"]),
                autre["pression"],
                simuler_promo(autre["results"], next_event,
                              {r["id"] for r in autre["plan"]["retenus"]},
                              autre["pression"], history=history, config=config),
                autre["budget"], sequence=autre["plan"].get("sequence")),
            None, evenements, fiabilite, autre["compat"], avertissement)
        if args.no_email or args.report_only:
            print(t2)
        else:
            send_email(h2, t2, resolve_email_config(config),
                       autre["plan"]["strategy"])
        print(f"\nTotal : {autre['plan']['total']:.2f} EUR  |  "
              f"Strategie : {autre['plan']['strategy']}")

    # --- Vue portefeuille (Axe 5, prompt 8.7) ---
    # Optionnelle : elle ne remplace pas les rapports individuels, elle
    # resume ce qui ne se voit que d'en haut.
    if args.portefeuille or config.get("portefeuille_actif"):
        html_p, texte_p = build_portefeuille(analyses, config, evenements)
        if texte_p:
            print("\n" + "=" * 60)
            print(texte_p)
            if not (args.no_email or args.report_only):
                send_email(html_p, texte_p, resolve_email_config(config),
                           "PORTEFEUILLE")

    print(f"\nTotal : {plan['total']:.2f} EUR  |  Strategie : {plan['strategy']}")


if __name__ == "__main__":
    main()
