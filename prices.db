ADVICE_COLORS = {
    "OCCASION ULTIME": "#c0392b",
    "ACHETER": "#1e8449",
    "ATTENDRE": "#b9770e",
    "CORRECT": "#2874a6",
    "NEUTRE": "#707b7c",
    "A VERIFIER": "#8e44ad",
}

TREND_ICONS = {"hausse": "&#9650;", "baisse": "&#9660;", "stable": "&#9654;", "nouveau": "&#9679;"}


# ---------------------------------------------------------------------------
# VAGUE 4 — Pilotage du projet d'achat
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PROJETS (Axe 5, prompt 8.5)
# ---------------------------------------------------------------------------
# Un seul projet a toujours existe, implicite, dissous dans config.json sous
# la cle `projet`. Le rendre EXPLICITE ne change rien pour qui n'en a qu'un,
# mais c'est ce qui permettra d'en suivre plusieurs sans dupliquer la
# collecte : produits, vendeurs et historique restent mutualises.
#
# Deux formes de configuration sont acceptees :
#   * `projet`  : un dict -- la forme historique, toujours valide ;
#   * `projets` : une liste de dicts -- la forme multi-projets.
# La premiere est normalisee en liste d'un element : le code d'aval ne voit
# plus qu'une seule forme.

PROJET_PAR_DEFAUT = "projet-1"


def projets_du_config(config):
    """
    Normalise la configuration en une LISTE de projets, quelle que soit la
    forme d'ecriture.

    Chaque projet rend : {id, nom, budget, date_cible, achats, composants}.
    `composants` vaut None quand le projet couvre TOUS les composants -- le
    cas d'un projet unique, ou rien n'a besoin d'etre enumere.
    """
    budget_global = config.get("budget") or {}

    bruts = config.get("projets")
    if not bruts:
        p = config.get("projet") or {}
        bruts = [{k: v for k, v in p.items() if k != "_comment"}]

    projets = []
    for i, p in enumerate(bruts, start=1):
        if not isinstance(p, dict) or p.get("_comment") and len(p) == 1:
            continue
        budget = p.get("budget") or budget_global
        projets.append({
            "id": p.get("id") or (PROJET_PAR_DEFAUT if i == 1 else f"projet-{i}"),
            "nom": p.get("nom") or f"Projet {i}",
            "budget": budget,
            "date_cible": p.get("date_cible"),
            "achats": p.get("achats") or [],
            # None = tous les composants (projet unique historique)
            "composants": p.get("composants"),
            "actif": p.get("actif", True),
        })
    return projets or [{"id": PROJET_PAR_DEFAUT, "nom": "Projet 1",
                        "budget": budget_global, "date_cible": None,
                        "achats": [], "composants": None, "actif": True}]


def projet_actif(config, projet_id=None):
    """Le projet demande, ou le premier actif a defaut."""
    projets = projets_du_config(config)
    if projet_id:
        for p in projets:
            if p["id"] == projet_id:
                return p
    for p in projets:
        if p.get("actif", True):
            return p
    return projets[0]


def composants_du_projet(config, projet_id=None):
    """Composants suivis par un projet. Par defaut : tous."""
    projet = projet_actif(config, projet_id)
    tous = config.get("components", [])
    if not projet.get("composants"):
        return tous
    vises = set(projet["composants"])
    return [c for c in tous if c["id"] in vises]


def synchroniser_projets(config):
    """
    Recopie les projets de la configuration dans SQLite.

    config.json reste la surface d'ECRITURE (le menu y ajoute les achats) ;
    la base en tient le miroir, pret a servir de socle au multi-projet. Rien
    n'est lu depuis la base par le code de decision : le comportement d'un
    usage a un seul projet est donc strictement inchange.
    """
    if not sqlite_store or not sqlite_store.est_actif():
        return 0

    for projet in projets_du_config(config):
        budget = projet.get("budget") or {}
        sqlite_store.enregistrer_projet(
            projet["id"], projet["nom"],
            budget.get("target_total"), budget.get("max_total"),
            budget.get("currency", "EUR"), projet.get("date_cible"),
            projet.get("actif", True))

        achats = {a["id"]: a for a in projet.get("achats", [])}
        liaisons = []
        for comp in composants_du_projet(config, projet["id"]):
            a = achats.get(comp["id"], {})
            liaisons.append({
                "produit_id": comp["id"], "slot": comp.get("slot"),
                "achete_le": a.get("date"), "prix_achat": a.get("prix"),
                "site_achat": a.get("site"),
            })
        sqlite_store.lier_composants(projet["id"], liaisons)

    return len(projets_du_config(config))


def analyser_projet(config, projet, history, ongoing, next_event, evenements):
    """
    Analyse complete d'UN projet : composants, comparaisons de slots, plan
    d'achat, compatibilite.

    Fonction PURE au sens ou elle n'imprime rien et n'envoie rien -- ce qui
    permet de l'appeler autant de fois qu'il y a de projets, pour batir soit
    des rapports individuels, soit une vue d'ensemble.

    Retourne None si le projet n'a aucune donnee exploitable.
    """
    thresholds = config.get("thresholds", {})
    market_ctx = config.get("market_context", {})
    achats = charger_achats(config, projet["id"])
    budget = projet.get("budget") or config.get("budget", {})

    results = []
    for component in composants_du_projet(config, projet["id"]):
        if component["id"] in achats:
            continue        # deja achete : sort du suivi actif
        node = history.get(component["id"])
        if not node or not node["entries"]:
            continue

        # Axe 2, point 3 : l'analyse porte sur l'historique FUSIONNE PAR
        # IDENTITE CANONIQUE. Le plancher et le prix courant refletent donc le
        # vrai minimum tous vendeurs confondus.
        entries_analyse = fusionner_entries(component, node) or node["entries"]

        # Le "prix du jour" retenu est le moins cher du dernier jour releve.
        last_date = entries_analyse[-1]["date"]
        same_day = [e for e in entries_analyse if e["date"] == last_date]
        cheapest = min(same_day, key=lambda e: e["price"])
        ordered = [e for e in entries_analyse if e["date"] != last_date] + [cheapest]
        analysis_node = {**node, "entries": ordered,
                         "slot": component.get("slot")}

        analysis = analyze_component(analysis_node, component.get("reference"),
                                     thresholds, market_ctx, ongoing, next_event,
                                     evenements=evenements)
        if analysis:
            results.append({
                "id": component["id"],
                "name": component["name"],
                "category": component["category"],
                "slot": component.get("slot"),
                "perf_index": component.get("perf_index"),
                "analysis": analysis,
                "site_intel": site_intelligence(node),
            })

    if not results:
        return None

    comparaisons = build_slot_comparisons(results, config.get("slots", {}), history)
    # L'echeance du projet contraint l'optimiseur de sequence : elle doit
    # etre connue AVANT de batir le plan.
    pression = pression_calendrier(config, projet["id"])
    plan = build_buy_plan(results, budget, ongoing, next_event, comparaisons,
                          pression=pression, history=history, config=config)
    compat = verifier_compatibilite(
        config, {r["id"] for r in plan["retenus"]},
        thresholds.get("marge_alimentation_percent", 30))

    return {
        "projet": projet, "achats": achats, "budget": budget,
        "results": results, "comparaisons": comparaisons,
        "pression": pression, "plan": plan, "compat": compat,
    }


def build_portefeuille(analyses, config, evenements=None):
    """
    Vue d'ensemble sur TOUS les projets actifs (Axe 5, prompt 8.7).

    Ce n'est pas la concatenation des rapports individuels : ceux-ci
    detaillent deja chaque composant. La vue portefeuille ne garde que ce qui
    ne se voit QUE d'en haut :

      * le total combine et sa position vis-a-vis des budgets cumules ;
      * les occasions ultimes en cours, tous projets confondus -- avec le
        projet concerne, puisqu'un meme article peut en servir plusieurs ;
      * les incompatibilites bloquantes, par projet ;
      * les meilleures fenetres d'achat a venir (modele evenementiel 7.3).

    Retourne (html, texte) ou (None, None) s'il n'y a rien a montrer.
    """
    if not analyses:
        return None, None

    lignes_projets = []
    total_combine = 0.0
    cible_combinee = plafond_combine = 0.0
    ultimes, bloquants = [], []

    for a in analyses:
        projet, plan = a["projet"], a["plan"]
        budget = a["budget"] or {}
        total_combine += plan["total"]
        cible_combinee += float(budget.get("target_total") or 0)
        plafond_combine += float(budget.get("max_total") or 0)

        # Regroupees par ARTICLE, pas par projet : un composant partage par
        # deux projets est une seule occasion, pas deux. On note simplement
        # qui elle concerne.
        for r in plan.get("ultimes", []):
            existante = next((u for u in ultimes if u["id"] == r["id"]), None)
            if existante:
                existante["projets"].append(projet["nom"])
                continue
            ultimes.append({"id": r["id"], "nom": r["name"],
                            "projets": [projet["nom"]],
                            "prix": r["analysis"]["current"],
                            "site": r["analysis"]["current_site"],
                            "sous_plancher": r["analysis"]["sous_le_plancher_pct"]})
        for pb in (a["compat"] or []):
            if pb["niveau"] == "bloquant":
                bloquants.append({"projet": projet["nom"], "message": pb["message"]})

        lignes_projets.append({
            "id": projet["id"], "nom": projet["nom"],
            "total": plan["total"],
            "cible": budget.get("target_total"),
            "strategie": plan["strategy"],
            "composants": len(plan["retenus"]),
            "achetes": len(a["achats"]),
            "echeance": (a["pression"] or {}).get("date"),
            "jours": (a["pression"] or {}).get("jours"),
        })

    # --- Fenetres d'achat a venir (modele evenementiel) ---
    fenetres = []
    for ev in (evenements or []):
        if (ev.get("nature") or "").lower() != "refresh":
            continue
        if not (0 <= ev.get("jours", -1) <= 120):
            continue
        concernes = []
        for a in analyses:
            cats = {r["category"] for r in a["results"]}
            if cats & set(ev.get("impact") or []):
                concernes.append(a["projet"]["nom"])
        if concernes:
            fenetres.append({"nom": ev.get("nom"), "jours": ev["jours"],
                             "impact": ev.get("impact") or [],
                             "projets": concernes})
    fenetres.sort(key=lambda f: f["jours"])

    # ------------------------------------------------------------------
    texte = ["VUE PORTEFEUILLE — " + datetime.now().strftime("%d/%m/%Y"), ""]
    texte.append(f"{len(analyses)} projet(s) actif(s), total combine "
                 f"{total_combine:.2f} EUR"
                 + (f" (objectif cumule {cible_combinee:.0f} EUR)"
                    if cible_combinee else ""))
    texte.append("")
    for l in lignes_projets:
        reste = f" | echeance {l['echeance']} ({l['jours']} j)" if l["echeance"] else ""
        texte.append(f"  {l['nom'][:28]:28} {l['total']:>9.2f} EUR  "
                     f"{l['strategie']:<18} {l['composants']} suivi(s)"
                     + (f", {l['achetes']} achete(s)" if l["achetes"] else "")
                     + reste)

    if ultimes:
        texte += ["", "OCCASIONS ULTIMES EN COURS :"]
        for u in ultimes:
            texte.append(f"  {u['nom']} : {u['prix']:.2f} EUR chez {u['site']} "
                         f"({u['sous_plancher']:.1f}% sous le plancher)")
            texte.append(f"      concerne : {', '.join(u['projets'])}")

    if bloquants:
        texte += ["", "INCOMPATIBILITES BLOQUANTES :"]
        for b in bloquants:
            texte.append(f"  [{b['projet'][:16]}] {b['message']}")

    if fenetres:
        texte += ["", "FENETRES D'ACHAT A VENIR :"]
        for f in fenetres:
            texte.append(f"  dans {f['jours']:>3} j — {f['nom']} "
                         f"({', '.join(f['impact'])}) → {', '.join(f['projets'])}")

    texte += ["", "Le detail composant par composant figure dans le rapport "
                  "de chaque projet."]

    # ------------------------------------------------------------------
    def _bloc(titre, items, couleur):
        if not items:
            return ""
        return (f'<div style="margin-top:14px;"><b style="font-size:13px;'
                f'color:{couleur};">{titre}</b>'
                f'<ul style="margin:6px 0 0 0;padding-left:18px;font-size:12px;'
                f'color:#555;">' + "".join(items) + "</ul></div>")

    rows = "".join(
        f'<tr><td style="padding:6px 8px;">{l["nom"]}</td>'
        f'<td style="padding:6px 8px;text-align:right;"><b>{l["total"]:.2f} EUR</b>'
        + (f'<br><span style="font-size:10px;color:#888;">objectif '
           f'{l["cible"]:.0f}</span>' if l["cible"] else "")
        + f'</td><td style="padding:6px 8px;">'
          f'<span style="color:{ADVICE_COLORS.get(l["strategie"], "#555")};">'
          f'{l["strategie"]}</span></td>'
          f'<td style="padding:6px 8px;font-size:11px;color:#888;">'
          f'{l["composants"]} suivi(s)'
        + (f', {l["achetes"]} achete(s)' if l["achetes"] else "")
        + (f'<br>echeance {l["echeance"]} ({l["jours"]} j)' if l["echeance"] else "")
        + "</td></tr>"
        for l in lignes_projets)

    html = f"""
    <html><body style="font-family:-apple-system,Arial,sans-serif;color:#2c3e50;
                       max-width:760px;margin:0 auto;padding:8px;">
      <h2 style="margin:0;">Vue portefeuille &mdash; {datetime.now().strftime('%d/%m/%Y')}</h2>
      <p style="color:#999;margin:4px 0 12px 0;font-size:12px;">
        {len(analyses)} projet(s) actif(s) &mdash; synthese, sans le detail deja
        present dans chaque rapport.
      </p>
      <div style="background:#f4f6f7;padding:10px 14px;border-radius:6px;
                  font-size:15px;font-weight:bold;">
        Total combine : {total_combine:.2f} EUR
        {f'<span style="font-weight:normal;font-size:12px;color:#888;"> / objectif cumule {cible_combinee:.0f} EUR</span>' if cible_combinee else ''}
      </div>
      <table style="width:100%;border-collapse:collapse;margin-top:12px;font-size:13px;">
        <tr style="background:#eef2f3;text-align:left;">
          <th style="padding:6px 8px;">Projet</th><th style="padding:6px 8px;text-align:right;">Total</th>
          <th style="padding:6px 8px;">Strategie</th><th style="padding:6px 8px;">Perimetre</th>
        </tr>
        {rows}
      </table>
      {_bloc("Occasions ultimes en cours", [
          f'<li><b>{u["nom"]}</b> &mdash; {u["prix"]:.2f} EUR chez {u["site"]} '
          f'({u["sous_plancher"]:.1f}% sous le plancher)'
          f'<br><span style="font-size:10px;color:#888;">concerne : '
          f'{", ".join(u["projets"])}</span></li>'
          for u in ultimes], "#c0392b")}
      {_bloc("Incompatibilites bloquantes", [
          f'<li><b>[{b["projet"]}]</b> {b["message"]}</li>' for b in bloquants],
          "#c0392b")}
      {_bloc("Fenetres d'achat a venir", [
          f'<li>dans <b>{f["jours"]} j</b> &mdash; {f["nom"]} '
          f'({", ".join(f["impact"])}) &rarr; {", ".join(f["projets"])}</li>'
          for f in fenetres], "#b9770e")}
      <p style="font-size:10px;color:#999;margin-top:14px;">
        Le detail composant par composant figure dans le rapport de chaque
        projet : cette vue ne le repete pas.
      </p>
    </body></html>"""

    return html, "\n".join(texte)


def produits_a_collecter(config):
    """
    Axe 5 : l'ensemble DEDUPLIQUE des produits a collecter, tous projets
    confondus.

    C'est ici que se joue le cout marginal d'un projet supplementaire. Trois
    reductions successives :

      1. UNION par identifiant. Deux projets qui suivent le meme composant le
         designent par le meme id : il n'apparait qu'une fois. La collecte
         n'a jamais ete « par projet », elle est « par produit ».

      2. RETRAIT des achats -- mais seulement si TOUS les projets qui suivent
         ce composant l'ont achete. Un composant deja acquis pour la tour mais
         encore attendu pour le NAS doit continuer d'etre releve. C'est le
         piege du multi-projet : filtrer sur un seul projet ferait disparaitre
         des prix encore utiles.

      3. FUSION par identite canonique (Axe 2). Deux composants distincts
         partageant le meme EAN sont le meme article : on n'en collecte qu'un,
         et le prix est recopie vers l'autre. Seules les correspondances sures
         (EAN/MPN) sont fusionnees.

    Retourne (representants, partages) :
      representants -- composants a collecter reellement ;
      partages      -- {id_representant: [ids a alimenter par recopie]}.
    """
    projets = [p for p in projets_du_config(config) if p.get("actif", True)]
    par_id = {c["id"]: c for c in config.get("components", [])}

    # 1) Union, et pour chaque composant : qui le suit, qui l'a achete.
    suivi_par, achete_par = {}, {}
    for projet in projets:
        achats = set(charger_achats(config, projet["id"]))
        for comp in composants_du_projet(config, projet["id"]):
            suivi_par.setdefault(comp["id"], set()).add(projet["id"])
            if comp["id"] in achats:
                achete_par.setdefault(comp["id"], set()).add(projet["id"])

    # 2) On ne retire que ce qui est achete PARTOUT ou il est suivi.
    #    L'ordre de config.json est conserve : la collecte reste lisible dans
    #    l'ordre ou l'utilisateur a decrit sa configuration.
    a_collecter = [
        comp for comp in config.get("components", [])
        if comp["id"] in suivi_par
        and achete_par.get(comp["id"], set()) < suivi_par[comp["id"]]
    ]

    # 3) Fusion par identite canonique.
    identites = (sqlite_store.identites_par_produit()
                 if sqlite_store and sqlite_store.est_actif() else {})
    representants, partages, vus = [], {}, {}
    for comp in a_collecter:
        cle = identites.get(comp["id"])
        if cle and cle in vus:
            partages.setdefault(vus[cle], []).append(comp["id"])
            continue
        if cle:
            vus[cle] = comp["id"]
        representants.append(comp)

    return representants, partages


def charger_achats(config, projet_id=None):
    """
    Retourne {id_composant: {prix, date, site}} des composants deja achetes
    POUR UN PROJET DONNE.

    Sans `projet_id`, le projet actif est utilise -- ce qui reproduit
    exactement l'ancien comportement quand il n'y en a qu'un.
    """
    projet = projet_actif(config, projet_id)
    return {a["id"]: a for a in projet.get("achats", [])}


def bilan_achats(achats, history, projet_id=None):
    """
    Roadmap 5.1 : bilan de ce qui est deja achete.
    Compare le prix paye au meilleur prix connu, pour savoir si vous avez
    bien joue le coup.

    Axe 5 : `achats` vient desormais d'un projet precis (voir
    charger_achats(config, projet_id)) ; `projet_id` n'est repris ici que
    pour etiqueter le bilan quand plusieurs projets coexistent.
    """
    if not achats:
        return None

    lignes, total_paye, total_si_min = [], 0.0, 0.0
    for cid, a in achats.items():
        node = history.get(cid)
        prix_min = None
        if node and node.get("entries"):
            prix_min = min(e["price"] for e in node["entries"])

        total_paye += a["prix"]
        total_si_min += (prix_min if prix_min else a["prix"])

        ecart = (a["prix"] - prix_min) if prix_min else 0
        lignes.append({
            "nom": (node or {}).get("name", cid),
            "prix": a["prix"],
            "date": a["date"],
            "site": a.get("site", "?"),
            "min_connu": prix_min,
            "ecart": ecart,
        })

    return {
        "lignes": lignes,
        "total_paye": total_paye,
        "ecart_total": total_paye - total_si_min,
        "projet_id": projet_id,
    }


def pression_calendrier(config, projet_id=None):
    """
    Roadmap 5.3 : compte a rebours vers une date cible.
    A l'approche de l'echeance, mieux vaut un prix correct qu'une rupture
    de stock la veille.

    Axe 5 : l'echeance est desormais celle d'UN PROJET. Sans `projet_id`, le
    projet actif est utilise -- identique a l'ancien comportement quand il
    n'y en a qu'un.
    """
    date_cible = projet_actif(config, projet_id).get("date_cible")
    if not date_cible:
        return None
    try:
        cible = datetime.strptime(date_cible, "%Y-%m-%d").date()
    except ValueError:
        return None

    restant = (cible - datetime.now().date()).days
    if restant < 0:
        niveau, message = "depassee", "La date cible est passee."
    elif restant <= 7:
        niveau, message = "urgent", f"Plus que {restant} jours : privilegiez la disponibilite au prix."
    elif restant <= 21:
        niveau, message = "proche", f"{restant} jours restants : evitez d'attendre une hypothetique baisse."
    else:
        niveau, message = "confortable", f"{restant} jours restants : vous pouvez patienter."

    return {"jours": restant, "niveau": niveau, "message": message, "date": date_cible}


def simuler_promo(results, next_event, retenus_ids, pression=None,
                  history=None, config=None):
    """
    Roadmap 5.4, rendu PROBABILISTE par la vague 7 : « et si j'attendais la
    prochaine periode promo ? »

    Auparavant, l'economie etait projetee a partir d'une baisse typique fixe
    par categorie (`typical_drop` du calendrier saisonnier) : un chiffre
    plausible mais invariable, qui ne devait rien a l'historique du composant.

    Desormais, quand l'historique le permet, chaque composant est estime par
    l'esperance empirique d'attendre :

        E[gain] = P(baisse) x gain_moyen - P(hausse) x perte_moyenne

    ou les quatre grandeurs sont comptees sur les fenetres historiques de meme
    duree (voir probabilites.esperance_attente). Le terme soustrait est le
    risque de hausse, calcule symetriquement.

    Repli assume : sous le seuil d'echantillon, le composant retombe sur
    l'ancienne methode deterministe -- et le rapport le SIGNALE. Les deux
    estimations ne sont jamais presentees comme equivalentes en fiabilite.
    """
    if not next_event:
        return None

    baisse = next_event["typical_drop"] / 100
    concernes = [r for r in results
                 if r["id"] in retenus_ids and r["category"] in next_event["best_for"]]
    if not concernes:
        return None

    total_actuel = sum(r["analysis"]["current"] for r in results if r["id"] in retenus_ids)
    horizon = next_event["days_until"]
    par_id = {c["id"]: c for c in (config or {}).get("components", [])}

    detail = []
    eco_proba = eco_deter = 0.0

    for r in concernes:
        prix = r["analysis"]["current"]
        estimation = None

        if probabilites and history and horizon > 0:
            comp = par_id.get(r["id"])
            node = (history or {}).get(r["id"])
            if comp and node and node.get("entries"):
                entries = fusionner_entries(comp, node) or node["entries"]
                estimation = probabilites.esperance_attente(entries, horizon, prix)

        if estimation and estimation.get("estimable"):
            gain = estimation["esperance_eur"] or 0.0
            eco_proba += gain
            detail.append({
                "id": r["id"], "nom": r["name"], "prix": prix,
                "methode": "probabiliste", "economie": gain,
                "n": estimation["n"],
                "p_baisse": estimation["p_baisse"],
                "p_hausse": estimation["p_hausse"],
                "gain_moyen_pct": estimation["gain_moyen_pct"],
                "perte_moyenne_pct": estimation["perte_moyenne_pct"],
                "esperance_pct": estimation["esperance_pct"],
                "confiance_label": estimation["confiance_label"],
                "message": estimation["message"],
            })
        else:
            gain = prix * baisse
            eco_deter += gain
            detail.append({
                "id": r["id"], "nom": r["name"], "prix": prix,
                "methode": "deterministe", "economie": gain,
                "n": (estimation or {}).get("n", 0),
                "motif": (estimation or {}).get(
                    "motif", "historique indisponible"),
                "baisse_pct": next_event["typical_drop"],
            })

    economie = eco_proba + eco_deter
    nb_proba = sum(1 for d in detail if d["methode"] == "probabiliste")
    nb_deter = len(detail) - nb_proba
    methode = ("probabiliste" if nb_deter == 0
               else "deterministe" if nb_proba == 0 else "mixte")

    # --- Coherence avec l'echeance du projet ---
    # Inutile de conseiller d'attendre une promo qui tombe APRES la date a
    # laquelle vous voulez la machine. Ce garde-fou est INDEPENDANT du mode de
    # calcul du gain : il bloque la suggestion quelle que soit l'esperance.
    incompatible = None
    if pression and pression["jours"] >= 0 and next_event["days_until"] > pression["jours"]:
        incompatible = (
            f"Cette periode commence {next_event['days_until'] - pression['jours']} jours "
            f"APRES votre echeance du {pression['date']} : attendre n'est pas envisageable "
            "si vous tenez a cette date."
        )

    return {
        "evenement": next_event["name"],
        "jours": next_event["days_until"],
        "baisse_pct": next_event["typical_drop"],
        "nb_concernes": len(concernes),
        "noms": [r["name"] for r in concernes],
        "total_actuel": total_actuel,
        "total_projete": total_actuel - economie,
        "economie": economie,
        "incompatible": incompatible,
        # --- Vague 7 : provenance de l'estimation ---
        "methode": methode,
        "detail": detail,
        "economie_probabiliste": round(eco_proba, 2),
        "economie_deterministe": round(eco_deter, 2),
        "nb_probabilistes": nb_proba,
        "nb_deterministes": nb_deter,
    }


def build_projet_html(bilan, pression, simulation, budget, sequence=None):
    blocs = []

    if bilan:
        lignes = "".join(
            f"<tr><td style='padding:4px 8px;font-size:12px;'>{l['nom']}</td>"
            f"<td style='padding:4px 8px;text-align:right;font-size:12px;'>"
            f"<b>{l['prix']:.2f} EUR</b> le {l['date']}</td>"
            f"<td style='padding:4px 8px;text-align:right;font-size:11px;"
            f"color:{'#c0392b' if l['ecart'] > 1 else '#1e8449'};'>"
            f"{('+' + format(l['ecart'], '.2f') + ' vs min') if l['ecart'] > 1 else 'au meilleur prix'}"
            f"</td></tr>"
            for l in bilan["lignes"]
        )
        verdict = ("Vous avez achete au meilleur moment."
                   if bilan["ecart_total"] < 5
                   else f"Ecart cumule de {bilan['ecart_total']:.2f} EUR par rapport aux plus bas connus.")
        blocs.append(f"""
        <div style="margin-bottom:12px;">
          <b style="font-size:13px;">Deja achete &mdash; {bilan['total_paye']:.2f} EUR</b>
          <table style="width:100%;border-collapse:collapse;margin-top:6px;">{lignes}</table>
          <p style="font-size:11px;color:#777;margin:6px 0 0 0;">{verdict}</p>
        </div>""")

    if pression:
        couleurs = {"urgent": "#c0392b", "proche": "#b9770e",
                    "confortable": "#1e8449", "depassee": "#7f8c8d"}
        blocs.append(f"""
        <div style="margin-bottom:12px;">
          <b style="font-size:13px;color:{couleurs[pression['niveau']]};">
            Echeance : {pression['date']}
          </b>
          <div style="font-size:12px;color:#555;">{pression['message']}</div>
        </div>""")

    if sequence and (sequence.get("maintenant") or sequence.get("differes")):
        def _ligne(i, differe=False):
            couleur = "#b9770e" if differe else "#1e8449"
            detail = ""
            if differe:
                if i["source_gain"] == "mesure":
                    detail = (f' <span style="color:#888;">(+{i["gain_attente"]:.2f} EUR '
                              f'espere, mesure sur n={i["n_gain"]})</span>')
                elif i["source_gain"] == "refresh annonce":
                    detail = (f' <span style="color:#888;">(nouvelle generation '
                              f'annoncee)</span>')
                else:
                    detail = f' <span style="color:#888;">({i["motif"]})</span>'
            elif i["raisons_blocage"]:
                detail = f' <span style="color:#888;">({i["raisons_blocage"][0]})</span>'
            return (f'<li style="margin:3px 0;"><b style="color:{couleur};">'
                    f'{i["nom"]}</b> &mdash; {i["prix"]:.2f} EUR{detail}</li>')

        # Assemble hors f-string : une expression d'f-string ne peut pas
        # contenir d'antislash (apostrophe echappee).
        vide_maintenant = '<li style="color:#888;">rien dans l&rsquo;immediat</li>'
        vide_differes = '<li style="color:#888;">rien a differer</li>'
        html_maintenant = ("".join(_ligne(i) for i in sequence["maintenant"])
                           or vide_maintenant)
        html_differes = ("".join(_ligne(i, True) for i in sequence["differes"])
                         or vide_differes)
        alerte_depassement = ""
        if sequence.get("depassement"):
            alerte_depassement = (
                '<div style="background:#fdedec;border-left:3px solid #e74c3c;'
                'padding:8px 12px;margin-top:8px;font-size:12px;">'
                f'Il manque {sequence["depassement"]:.2f} EUR meme apres '
                'arbitrage.</div>')

        blocs.append(f"""
        <div style="margin-bottom:4px;">
          <b style="font-size:13px;">Sequence d'achat conseillee</b>
          <p style="font-size:12px;color:#555;margin:6px 0 8px 0;">
            {sequence['explication']}
          </p>
          <div style="display:flex;gap:16px;flex-wrap:wrap;">
            <div style="flex:1;min-width:220px;">
              <div style="font-size:11px;color:#888;text-transform:uppercase;">
                Maintenant &mdash; {sequence['cout_maintenant']:.2f} EUR
              </div>
              <ul style="margin:4px 0 0 0;padding-left:18px;font-size:12px;">
                {html_maintenant}
              </ul>
            </div>
            <div style="flex:1;min-width:220px;">
              <div style="font-size:11px;color:#888;text-transform:uppercase;">
                Plus tard &mdash; gain espere {sequence['gain_differe']:.2f} EUR
              </div>
              <ul style="margin:4px 0 0 0;padding-left:18px;font-size:12px;">
                {html_differes}
              </ul>
            </div>
          </div>
          {alerte_depassement}
        </div>""")

    if simulation:
        gain_pct = simulation["economie"] / simulation["total_actuel"] * 100

        # --- Vague 7 : d'ou vient l'estimation ? ---
        # Les deux methodes ne se valent pas : l'une compte des episodes reels
        # du composant, l'autre applique une baisse moyenne de categorie. Le
        # rapport doit le dire, pas les melanger en un chiffre unique.
        methode_html = ""
        detail = simulation.get("detail") or []
        if detail:
            lignes = []
            for d in sorted(detail, key=lambda x: x["methode"]):
                if d["methode"] == "probabiliste":
                    lignes.append(
                        f'<li style="margin:3px 0;"><b>{d["nom"]}</b> &mdash; '
                        f'<span style="color:#1e8449;">{d["economie"]:+.2f} EUR</span> '
                        f'<span style="color:#888;">(mesure sur n={d["n"]} fenetre(s) : '
                        f'baisse dans {d["p_baisse"]:.0f}% des cas de '
                        f'{d["gain_moyen_pct"]:.1f}%, hausse dans '
                        f'{d["p_hausse"]:.0f}% des cas de '
                        f'{d["perte_moyenne_pct"]:.1f}% &mdash; confiance '
                        f'{d["confiance_label"]})</span></li>')
                else:
                    lignes.append(
                        f'<li style="margin:3px 0;"><b>{d["nom"]}</b> &mdash; '
                        f'<span style="color:#b9770e;">{d["economie"]:+.2f} EUR</span> '
                        f'<span style="color:#888;">(estimation forfaitaire '
                        f'{d.get("baisse_pct", 0)}% de la categorie &mdash; '
                        f'{d.get("motif", "historique insuffisant")})</span></li>')

            nb_p, nb_d = simulation["nb_probabilistes"], simulation["nb_deterministes"]
            entete = []
            if nb_p:
                entete.append(f'<b style="color:#1e8449;">{nb_p} mesure(s) sur '
                              f'historique reel</b> '
                              f'({simulation["economie_probabiliste"]:+.2f} EUR)')
            if nb_d:
                entete.append(f'<b style="color:#b9770e;">{nb_d} estimation(s) '
                              f'forfaitaire(s)</b> '
                              f'({simulation["economie_deterministe"]:+.2f} EUR)')

            methode_html = f"""
          <div style="background:#f8f9f9;border-left:3px solid #85929e;
                      padding:8px 12px;margin-top:10px;font-size:11px;">
            <div style="margin-bottom:4px;">{" &nbsp;|&nbsp; ".join(entete)}</div>
            <ul style="margin:4px 0 0 0;padding-left:16px;color:#555;">
              {"".join(lignes)}
            </ul>
            <div style="color:#999;margin-top:6px;">
              Une mesure sur historique reel compte des episodes passes du
              composant lui-meme, avec sa taille d'echantillon. Une estimation
              forfaitaire applique la baisse moyenne de la categorie : elle est
              indicative, et nettement moins fiable.
            </div>
          </div>"""

        blocs.append(f"""
        <div style="margin-bottom:4px;">
          <b style="font-size:13px;">Et si vous attendiez {simulation['evenement']} ?</b>
          <div style="font-size:12px;color:#555;margin-top:4px;">
            Dans {simulation['jours']} jours, sur {simulation['nb_concernes']}
            composant(s) &mdash; estimation {simulation.get('methode', 'deterministe')} :
          </div>
          <div style="display:flex;gap:20px;margin-top:8px;flex-wrap:wrap;">
            <div><span style="font-size:11px;color:#888;">Aujourd'hui</span><br>
              <b style="font-size:18px;">{simulation['total_actuel']:.2f} EUR</b></div>
            <div><span style="font-size:11px;color:#888;">Projection</span><br>
              <b style="font-size:18px;color:#1e8449;">{simulation['total_projete']:.2f} EUR</b></div>
            <div><span style="font-size:11px;color:#888;">Economie estimee</span><br>
              <b style="font-size:18px;color:#1e8449;">{simulation['economie']:.2f} EUR</b>
              <span style="font-size:11px;color:#888;"> ({gain_pct:.1f}%)</span></div>
          </div>
          {methode_html}
          {f'<div style="background:#fdedec;border-left:3px solid #e74c3c;padding:8px 12px;margin-top:10px;font-size:12px;"><b>Incompatible avec votre echeance.</b> {simulation["incompatible"]}</div>' if simulation.get("incompatible") else ""}
          <p style="font-size:10px;color:#999;margin:8px 0 0 0;">
            Constat sur le passe observe, pas une garantie : rien ne dit que
            les episodes a venir ressembleront aux precedents, et les stocks
            peuvent aussi manquer.
          </p>
        </div>""")

    if not blocs:
        return ""

    return f"""
    <div style="background:#fbfcfc;border:1px solid #e5e8e8;padding:14px 16px;
                margin:16px 0;border-radius:6px;">
      <div style="font-size:11px;color:#888;letter-spacing:1px;margin-bottom:10px;">
        PILOTAGE DU PROJET
      </div>
      {"".join(blocs)}
    </div>"""


